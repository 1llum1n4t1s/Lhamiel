<Application x:Class="Lhamiel.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Lhamiel"
	xmlns:util="clr-namespace:Lhamiel.Util">
    <Application.Resources>
        <!-- Fluent Design System の色とスタイル -->
        <SolidColorBrush x:Key="SystemAccentColor" Color="#0078D4" />
        <SolidColorBrush x:Key="SystemAccentColorLight1" Color="#106EBE" />
        <SolidColorBrush x:Key="SystemAccentColorLight2" Color="#005A9E" />
        <SolidColorBrush x:Key="SystemAccentColorLight3" Color="#004C87" />
        <SolidColorBrush x:Key="SystemAccentColorDark1" Color="#2B88D8" />
        <SolidColorBrush x:Key="SystemAccentColorDark2" Color="#3B96E6" />
        <SolidColorBrush x:Key="SystemAccentColorDark3" Color="#4CA4F4" />
        
        <!-- 背景色 -->
        <SolidColorBrush x:Key="SystemBackgroundColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SystemBackgroundAltColor" Color="#F3F2F1" />
        <SolidColorBrush x:Key="SystemBackgroundBaseLowColor" Color="#FDFDFD" />
        
        <!-- 前景色 -->
        <SolidColorBrush x:Key="SystemForegroundColor" Color="#000000" />
        <SolidColorBrush x:Key="SystemForegroundBaseMediumColor" Color="#666666" />
        <SolidColorBrush x:Key="SystemForegroundBaseMediumLowColor" Color="#999999" />
        
        <!-- 境界線色 -->
        <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#F3F2F1" />
        
        <!-- Fluent Design System のウィンドウスタイル -->
        <Style x:Key="FluentWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="ResizeMode" Value="CanResize" />
        </Style>
        
        <!-- Fluent Design System のGroupBoxスタイル（デフォルト適用） -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundAltColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="{StaticResource SystemBackgroundColor}" 
                                        CornerRadius="4,4,0,0" Padding="8,4" Margin="-10,-10,-10,0">
                                    <ContentPresenter ContentSource="Header" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center" />
                                </Border>
                                
                                <ContentPresenter Grid.Row="1" 
                                                ContentSource="Content" 
                                                Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Fluent Design System のボタンスタイル（デフォルト適用） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemBackgroundAltColor}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SystemAccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemControlBackgroundBaseLowBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SystemAccentColorLight2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemControlBackgroundBaseLowBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SystemForegroundBaseMediumLowColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- プライマリボタンスタイル（青色） -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemAccentColorLight1}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemAccentColorLight2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemControlBackgroundBaseLowBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SystemForegroundBaseMediumLowColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ゴーストボタンスタイル（透明背景） -->
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SystemAccentColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemBackgroundAltColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SystemControlBackgroundBaseLowBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource SystemForegroundBaseMediumLowColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Fluent Design System のテキストボックススタイル（デフォルト適用） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SystemAccentColor}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SystemAccentColorLight1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Fluent Design System のComboBoxスタイル（デフォルト適用） -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        
        <!-- Fluent Design System のチェックボックススタイル（デフォルト適用） -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        
        <!-- Fluent Design System のラジオボタンスタイル（デフォルト適用） -->
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        
        <!-- Fluent Design System のProgressBarスタイル -->
        <Style x:Key="FluentProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SystemBackgroundAltColor}" />
            <Setter Property="Foreground" Value="{StaticResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>

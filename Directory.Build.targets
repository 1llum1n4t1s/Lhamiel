<Project>
  <!-- 7z.dll を全プロジェクトでルートに配置（アーキテクチャ別） -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)lib\native\$(RuntimeIdentifier)\7z.dll"
             Condition="Exists('$(MSBuildThisFileDirectory)lib\native\$(RuntimeIdentifier)\7z.dll')">
      <Link>7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

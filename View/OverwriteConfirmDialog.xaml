<Window
    x:Class="Lhamiel.View.OverwriteConfirmDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="using:Lhamiel.View"
    Title="ファイルの置き換え"
    Width="450"
    Height="180"
    x:DataType="view:OverwriteConfirmDialog"
    Background="{DynamicResource Brush.Window}"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="MessageTextBlock"
            Grid.Row="0"
            Margin="0,0,0,20"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="YesButton"
                Width="80"
                Click="YesButton_Click"
                Content="はい" />
            <Button
                x:Name="NoButton"
                Width="80"
                Click="NoButton_Click"
                Content="いいえ" />
        </StackPanel>
    </Grid>
</Window>

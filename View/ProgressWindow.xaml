<Window x:Class="Lhamiel.View.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lhamiel.View"
        mc:Ignorable="d"
        Title="処理中..." Height="200" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ファイル名 -->
        <TextBlock Grid.Row="0" x:Name="FileNameTextBlock"
                   Text="ファイル名" Margin="0,0,0,15"
                   TextTrimming="CharacterEllipsis" />

        <!-- 進行状況バー -->
        <ProgressBar Grid.Row="1" x:Name="ProgressBar"
                     Height="8" Margin="0,0,0,10" />

        <!-- 進行状況テキスト -->
        <TextBlock Grid.Row="2" x:Name="ProgressTextBlock"
                   Text="0%" HorizontalAlignment="Center" Margin="0,0,0,15" />

        <!-- ステータス情報 -->
        <TextBlock Grid.Row="3" x:Name="StatusTextBlock"
                   Text="準備中..." TextWrapping="Wrap" VerticalAlignment="Center"
                   HorizontalAlignment="Center" Margin="0,0,0,15" />

        <!-- キャンセルボタン -->
        <Button Grid.Row="4" x:Name="CancelButton" Content="キャンセル"
                Width="100" HorizontalAlignment="Right"
                Click="CancelButton_Click" />
    </Grid>
</Window>

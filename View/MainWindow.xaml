<Window x:Class="GGEZArchiver.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GGEZArchiver.View"
        mc:Ignorable="d"
        Title="GGEZ Extract - 設定" Height="500" Width="600" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 出力先設定 -->
        <GroupBox Grid.Row="0" Header="出力先設定" Margin="0,0,0,20">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputPathTextBox" Grid.Column="0" 
                         VerticalAlignment="Center" IsReadOnly="True"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="参照..." 
                        Margin="10,0,0,0" Padding="10,5" Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- ファイル関連付け設定 -->
        <GroupBox Grid.Row="1" Header="ファイル関連付け設定" Margin="0,0,0,20">
            <StackPanel Margin="10">
                <CheckBox x:Name="ZipCheckBox" Content="ZIPファイル (.zip)" 
                          Margin="0,5" Checked="FileAssociation_Changed" Unchecked="FileAssociation_Changed"/>
                <CheckBox x:Name="SevenZipCheckBox" Content="7-Zipファイル (.7z)" 
                          Margin="0,5" Checked="FileAssociation_Changed" Unchecked="FileAssociation_Changed"/>
                <CheckBox x:Name="LzhCheckBox" Content="LZHファイル (.lzh)" 
                          Margin="0,5" Checked="FileAssociation_Changed" Unchecked="FileAssociation_Changed"/>
                <CheckBox x:Name="CabCheckBox" Content="CABファイル (.cab)" 
                          Margin="0,5" Checked="FileAssociation_Changed" Unchecked="FileAssociation_Changed"/>
            </StackPanel>
        </GroupBox>

        <!-- 情報 -->
        <GroupBox Grid.Row="3" Header="使用方法" Margin="0,0,0,20">
            <TextBlock Margin="10" TextWrapping="Wrap">
                <Run Text="1. 出力先フォルダを設定してください。&#x0a;"/>
                <Run Text="2. 関連付けしたいファイル形式にチェックを入れてください。&#x0a;"/>
                <Run Text="3. 設定を保存してください。&#x0a;"/>
                <Run Text="4. 関連付けされたファイルをダブルクリックすると、自動的に展開されます。&#x0a;"/>
                <Run Text="&#x0a;"/>
                <Run Text="※ 管理者権限が必要な場合があります。&#x0a;"/>
                <Run Text="※ 二重フォルダ構造を防ぐため、既存のフォルダ構造を確認してから展開します。"/>
            </TextBlock>
        </GroupBox>

        <!-- ボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="圧縮形式:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CompressionFormatComboBox" Width="80" Margin="0,0,10,0" 
                      SelectedIndex="0">
                <ComboBoxItem Content="ZIP"/>
                <ComboBoxItem Content="7Z"/>
            </ComboBox>
            <Button x:Name="CreateShortcutButton" Content="デスクトップにショートカット作成" 
                    Padding="10,10" Margin="0,0,10,0" Click="CreateShortcutButton_Click"/>
            <Button x:Name="SaveButton" Content="設定を保存" 
                    Padding="20,10" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="キャンセル" 
                    Padding="20,10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

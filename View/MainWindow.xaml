<Window x:Class="Lhamiel.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lhamiel.View"
        mc:Ignorable="d"
        Title="Lhamiel" Height="500" Width="720"
        WindowStartupLocation="CenterScreen" 
        Style="{StaticResource FluentWindowStyle}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" MinHeight="37.96" />
        </Grid.RowDefinitions>

        <!-- 出力先設定 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 展開用出力先設定 -->
            <GroupBox Grid.Column="0" Header="展開用出力先設定">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 出力先パターン選択 -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <RadioButton x:Name="ExtractionOutputToSameDirectoryRadio" Content="元のファイルと同じディレクトリに出力"
                                     Margin="0,2" />
                        <RadioButton x:Name="ExtractionOutputToDirectoryRadio" Content="ディレクトリを指定する"
                                     Margin="0,2" IsChecked="True" />
                    </StackPanel>

                    <!-- ディレクトリ指定 -->
                    <TextBox x:Name="ExtractionOutputPathTextBox" Grid.Row="1" Grid.Column="0"
                             VerticalAlignment="Center" IsReadOnly="True" />
                    <Button x:Name="ExtractionBrowseButton" Grid.Row="1" Grid.Column="1" Content="参照..."
                            Margin="8,0,0,0" Click="ExtractionBrowseButton_Click" />
                </Grid>
            </GroupBox>

            <!-- 圧縮用出力先設定 -->
            <GroupBox Grid.Column="2" Header="圧縮用出力先設定">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 出力先パターン選択 -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <RadioButton x:Name="CompressionOutputToSameDirectoryRadio" Content="元のファイルと同じディレクトリに出力"
                                     Margin="0,2" />
                        <RadioButton x:Name="CompressionOutputToDirectoryRadio" Content="ディレクトリを指定する"
                                     Margin="0,2" IsChecked="True" />
                    </StackPanel>

                    <!-- ディレクトリ指定 -->
                    <TextBox x:Name="CompressionOutputPathTextBox" Grid.Row="1" Grid.Column="0"
                             VerticalAlignment="Center" IsReadOnly="True" />
                    <Button x:Name="CompressionBrowseButton" Grid.Row="1" Grid.Column="1" Content="参照..."
                            Margin="8,0,0,0" Click="CompressionBrowseButton_Click" />
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 設定エリア（左右分割） -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ファイル関連付け設定 -->
            <GroupBox Grid.Column="0" Header="ファイル関連付け設定">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- 全選択・全解除ボタン -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button x:Name="SelectAllButton" Content="全選択" Width="60" Height="25" Margin="4,0"
                                Click="SelectAllButton_Click" />
                        <Button x:Name="DeselectAllButton" Content="全解除" Width="60" Height="25" Margin="4,0"
                                Click="DeselectAllButton_Click" />
                    </StackPanel>
                    
                    <!-- チェックボックス一覧 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <UniformGrid Columns="3" Margin="8">
                        <CheckBox x:Name="ZipCheckBox" Content="ZIPファイル (.zip)"
                                  Margin="0,2" />
                        <CheckBox x:Name="SevenZipCheckBox" Content="7-Zipファイル (.7z)"
                                  Margin="0,2" />
                        <CheckBox x:Name="TarCheckBox" Content="TARファイル (.tar)"
                                  Margin="0,2" />
                        <CheckBox x:Name="GzCheckBox" Content="GZIPファイル (.gz)"
                                  Margin="0,2" />
                        <CheckBox x:Name="Bz2CheckBox" Content="BZIP2ファイル (.bz2)"
                                  Margin="0,2" />
                        <CheckBox x:Name="LzmaCheckBox" Content="LZMAファイル (.lzma)"
                                  Margin="0,2" />
                        <CheckBox x:Name="XzCheckBox" Content="XZファイル (.xz)"
                                  Margin="0,2" />
                        <CheckBox x:Name="RarCheckBox" Content="RARファイル (.rar)"
                                  Margin="0,2" />
                        <CheckBox x:Name="LzhCheckBox" Content="LZHファイル (.lzh)"
                                  Margin="0,2" />
                        <CheckBox x:Name="CabCheckBox" Content="CABファイル (.cab)"
                                  Margin="0,2" />
                        <CheckBox x:Name="ArjCheckBox" Content="ARJファイル (.arj)"
                                  Margin="0,2" />
                        <CheckBox x:Name="ZCheckBox" Content="Zファイル (.z)"
                                  Margin="0,2" />
                    </UniformGrid>
                </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="圧縮形式:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="CompressionFormatComboBox" Width="75" Margin="0,10,12,10" />
            <Button x:Name="CreateShortcutButton" Content="デスクトップにショートカット作成"
                    Margin="0,0,8,0" Click="CreateShortcutButton_Click" />
            <Button x:Name="SaveButton" Content="設定を保存"
                    Margin="0,0,8,0" Click="SaveSettingsButton_Click" />
            <Button x:Name="CancelButton" Content="キャンセル"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
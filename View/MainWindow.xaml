<Window
    x:Class="Lhamiel.View.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:input="using:Avalonia.Input"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:vm="using:Lhamiel.ViewModels"
    Title="Lhamiel - アーカイブ圧縮・展開ツール"
    Width="720"
    Height="560"
    input:DragDrop.AllowDrop="True"
    input:DragDrop.DragLeave="DropZone_DragLeave"
    input:DragDrop.DragOver="DropZone_DragOver"
    input:DragDrop.Drop="DropZone_Drop"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource Brush.Window}"
    CanResize="False"
    ExtendClientAreaChromeHints="PreferSystemChrome"
    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Panel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ═══ タブコンテンツ ═══  -->
            <TabControl Grid.Row="0" Margin="16,32,16,0">

                <!--  ━━━ 全般設定タブ ━━━  -->
                <TabItem Header="⚙️ 全般設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12">

                            <!--  テーマ選択  -->
                            <primitives:HeaderedContentControl Header="テーマ">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{x:Static vm:MainWindowViewModel.ThemeOptions}"
                                        SelectedValue="{Binding SelectedTheme}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:ThemeItem}"
                                        ToolTip.Tip="アプリケーションのテーマを切り替えます">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeItem">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  圧縮形式  -->
                            <primitives:HeaderedContentControl Header="デフォルトの圧縮形式">
                                <ComboBox
                                    x:Name="CompressionFormatComboBox"
                                    Width="120"
                                    ItemsSource="{Binding CompressionFormats}"
                                    SelectedItem="{Binding SelectedCompressionFormat}">
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                            </primitives:HeaderedContentControl>

                            <!--  ショートカット作成  -->
                            <primitives:HeaderedContentControl Header="ショートカット">
                                <Button
                                    x:Name="CreateShortcutButton"
                                    Command="{Binding CreateShortcutCommand}"
                                    Content="📌 デスクトップにショートカット作成" />
                            </primitives:HeaderedContentControl>

                            <!--  説明テキスト  -->
                            <TextBlock
                                Margin="4,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="ウィンドウにファイルをドラッグ＆ドロップして圧縮・展開できます" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 展開用設定タブ ━━━  -->
                <TabItem Header="📂 展開用設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12">
                            <primitives:HeaderedContentControl Header="出力先設定">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="ExtractionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="元のファイルと同じディレクトリに出力"
                                        IsChecked="{Binding ExtractionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="ExtractionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="ディレクトリを指定する"
                                        IsChecked="{Binding ExtractionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ExtractionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding ExtractionOutputDirectory}" />
                                        <Button
                                            x:Name="ExtractionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseExtractionCommand}"
                                            Content="参照..."
                                            ToolTip.Tip="展開先フォルダを選択" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenExtractionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="展開後に保存先のフォルダを開く"
                                        IsChecked="{Binding OpenExtractionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 圧縮用設定タブ ━━━  -->
                <TabItem Header="📦 圧縮用設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12">
                            <primitives:HeaderedContentControl Header="出力先設定">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="CompressionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="元のファイルと同じディレクトリに出力"
                                        IsChecked="{Binding CompressionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="CompressionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="ディレクトリを指定する"
                                        IsChecked="{Binding CompressionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CompressionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding CompressionOutputDirectory}" />
                                        <Button
                                            x:Name="CompressionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseCompressionCommand}"
                                            Content="参照..."
                                            ToolTip.Tip="圧縮先フォルダを選択" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenCompressionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="圧縮後に保存先のフォルダを開く"
                                        IsChecked="{Binding OpenCompressionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="まとめ圧縮">
                                <StackPanel>
                                    <CheckBox Content="複数ファイルを1つにまとめて圧縮" IsChecked="{Binding CompressMultipleAsOne}" />
                                    <TextBlock
                                        Margin="28,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="OFFの場合、ファイルごとに個別のアーカイブが作成されます"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="圧縮レベル設定">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="ZIP 圧縮レベル" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="7z 圧縮レベル" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedSevenZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </primitives:HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 関連付け設定タブ ━━━  -->
                <TabItem Header="🔗 関連付け設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="8,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="SelectAllButton"
                                    Command="{Binding SelectAllAssociationsCommand}"
                                    Content="全選択" />
                                <Button
                                    x:Name="DeselectAllButton"
                                    Command="{Binding DeselectAllAssociationsCommand}"
                                    Content="全解除" />
                            </StackPanel>

                            <ItemsControl
                                Grid.Row="1"
                                Margin="4,0"
                                ItemsSource="{Binding Associations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,4"
                                            Content="{Binding Description}"
                                            IsChecked="{Binding IsAssociated}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ バージョン情報タブ ━━━  -->
                <TabItem Header="ℹ️ バージョン">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,16,8,12">
                            <TextBlock
                                Margin="4,0,0,4"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="Lhamiel" />
                            <TextBlock
                                Margin="4,0,0,20"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="アーカイブ圧縮・展開ツール" />

                            <!--  バージョン情報パネル  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="バージョン" />
                                    <TextBlock
                                        x:Name="VersionTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding VersionText}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Command="{Binding CheckForUpdateCommand}"
                                        Content="アップデート確認"
                                        FontSize="12"
                                        IsEnabled="{Binding !IsCheckingUpdate}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Text="{Binding UpdateStatusText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!--  コピーライト  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="コピーライト" />
                                    <TextBlock
                                        x:Name="CopyrightTextBlock"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{Binding CopyrightText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ライセンス  -->
                            <Border
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="ライセンス" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="MIT License" />
                                    <TextBlock
                                        x:Name="LicenseTextBlock"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        LineHeight="16"
                                        Text="{Binding LicenseText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!--  ═══ 下部バー（保存・キャンセルのみ） ═══  -->
            <Border
                Grid.Row="1"
                Margin="16,0,16,16"
                Padding="12,10"
                Background="{DynamicResource Brush.Container}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="SaveButton"
                        MinWidth="100"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                    <Button
                        x:Name="CancelButton"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        Content="キャンセル" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ═══ ドラッグオーバーレイ（ドラッグ中のみ表示） ═══  -->
        <Border
            x:Name="DropOverlay"
            Background="#1C1C1E"
            CornerRadius="8"
            IsHitTestVisible="False"
            IsVisible="False">
            <Border
                Margin="24"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1.5"
                CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Text="📁" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        Text="ここにドロップして圧縮・展開" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

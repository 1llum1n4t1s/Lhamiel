<Window x:Class="Lhamiel.View.MainWindow"
       xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:primitives="using:Avalonia.Controls.Primitives"
       xmlns:input="using:Avalonia.Input"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       mc:Ignorable="d"
       Title="Lhamiel - アーカイブ圧縮・展開ツール"
       Height="500" Width="700"
       MinHeight="500" MinWidth="700"
       CanResize="False"
       WindowStartupLocation="CenterScreen"
       input:DragDrop.AllowDrop="True"
       input:DragDrop.Drop="DropZone_Drop"
       input:DragDrop.DragOver="DropZone_DragOver"
       input:DragDrop.DragLeave="DropZone_DragLeave">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />      <!-- タブコンテンツ -->
            <RowDefinition Height="Auto" />  <!-- 下部ボタン -->
        </Grid.RowDefinitions>

        <!-- タブコンテンツ -->
        <TabControl Grid.Row="0" Margin="0,0,0,16">
            <!-- ファイル操作タブ -->
            <TabItem Header="📁ファイル操作">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ドラッグ&ドロップゾーン -->
                    <Border Grid.Row="0" x:Name="DropZoneBorder"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="#F9F9F9"
                            Padding="24"
                            MinHeight="100">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁 ここにファイルをドラッグ&amp;ドロップ"
                                       FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="#666666" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 展開用設定タブ -->
            <TabItem Header="📂 展開用設定">
                <StackPanel Margin="12">
                    <primitives:HeaderedContentControl Header="展開用出力先設定">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 出力先パターン選択 -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <RadioButton x:Name="ExtractionOutputToSameDirectoryRadio"
                                             Content="元のファイルと同じディレクトリに出力"
                                             Margin="0,4"
                                             IsChecked="{Binding ExtractionOutputToSameDirectory}" />
                                <RadioButton x:Name="ExtractionOutputToDirectoryRadio"
                                             Content="ディレクトリを指定する"
                                             Margin="0,4"
                                             IsChecked="{Binding ExtractionOutputToDirectory}" />
                            </StackPanel>

                            <!-- ディレクトリ指定 -->
                            <TextBox x:Name="ExtractionOutputPathTextBox" Grid.Row="1" Grid.Column="0"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ExtractionOutputDirectory}" />
                            <Button x:Name="ExtractionBrowseButton" Grid.Row="1" Grid.Column="1"
                                    Content="参照..."
                                    Height="40"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseExtractionCommand}"
                                    ToolTip.Tip="展開先フォルダを選択" />
                        </Grid>
                    </primitives:HeaderedContentControl>

                    <primitives:HeaderedContentControl Header="展開後に保存先のフォルダを開く" Margin="0,12,0,0">
                        <StackPanel Margin="12">
                            <CheckBox x:Name="OpenExtractionOutputFolderCheckBox"
                                      Content="展開後に保存先のフォルダを開く"
                                      Margin="0,4"
                                      IsChecked="{Binding OpenExtractionOutputFolder}"
                                      ToolTip.Tip="展開が完了したときに、展開先フォルダを自動的に開きます" />
                        </StackPanel>
                    </primitives:HeaderedContentControl>
                </StackPanel>
            </TabItem>

            <!-- 圧縮用設定タブ -->
            <TabItem Header="📦 圧縮用設定">
                <StackPanel Margin="12">
                    <primitives:HeaderedContentControl Header="圧縮用出力先設定">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 出力先パターン選択 -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <RadioButton x:Name="CompressionOutputToSameDirectoryRadio"
                                             Content="元のファイルと同じディレクトリに出力"
                                             Margin="0,4"
                                             IsChecked="{Binding CompressionOutputToSameDirectory}" />
                                <RadioButton x:Name="CompressionOutputToDirectoryRadio"
                                             Content="ディレクトリを指定する"
                                             Margin="0,4"
                                             IsChecked="{Binding CompressionOutputToDirectory}" />
                            </StackPanel>

                            <!-- ディレクトリ指定 -->
                            <TextBox x:Name="CompressionOutputPathTextBox" Grid.Row="1" Grid.Column="0"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CompressionOutputDirectory}" />
                            <Button x:Name="CompressionBrowseButton" Grid.Row="1" Grid.Column="1"
                                    Content="参照..."
                                    Height="40"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseCompressionCommand}"
                                    ToolTip.Tip="圧縮先フォルダを選択" />
                        </Grid>
                    </primitives:HeaderedContentControl>

                    <primitives:HeaderedContentControl Header="圧縮後の動作設定" Margin="0,12,0,0">
                        <StackPanel Margin="12">
                            <CheckBox x:Name="OpenCompressionOutputFolderCheckBox"
                                      Content="圧縮後に保存先のフォルダを開く"
                                      Margin="0,4"
                                      IsChecked="{Binding OpenCompressionOutputFolder}"
                                      ToolTip.Tip="圧縮が完了したときに、圧縮先フォルダを自動的に開きます" />
                        </StackPanel>
                    </primitives:HeaderedContentControl>
                </StackPanel>
            </TabItem>

            <!-- ファイル関連付け設定タブ -->
            <TabItem Header="🔗 関連付け設定">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ボタンエリア -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 全選択・全解除ボタン -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Content="全選択"
                                    Width="70" Height="40"
                                    Margin="0,0,4,0"
                                    Command="{Binding SelectAllAssociationsCommand}"
                                    ToolTip.Tip="すべての形式を選択" />
                            <Button x:Name="DeselectAllButton" Content="全解除"
                                    Width="70" Height="40"
                                    Command="{Binding DeselectAllAssociationsCommand}"
                                    ToolTip.Tip="すべての選択を解除" />
                        </StackPanel>
                    </Grid>

                    <!-- チェックボックス一覧 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid Columns="4" Margin="12,8">
                            <CheckBox x:Name="ZipCheckBox" Content="ZIP (.zip)" Margin="0,4" IsChecked="{Binding ZipIsChecked}" />
                            <CheckBox x:Name="SevenZipCheckBox" Content="7-Zip (.7z)" Margin="0,4" IsChecked="{Binding SevenZipIsChecked}" />
                            <CheckBox x:Name="TarCheckBox" Content="TAR (.tar)" Margin="0,4" IsChecked="{Binding TarIsChecked}" />
                            <CheckBox x:Name="GzCheckBox" Content="GZIP (.gz)" Margin="0,4" IsChecked="{Binding GzIsChecked}" />
                            <CheckBox x:Name="Bz2CheckBox" Content="BZIP2 (.bz2)" Margin="0,4" IsChecked="{Binding Bz2IsChecked}" />
                            <CheckBox x:Name="LzmaCheckBox" Content="LZMA (.lzma)" Margin="0,4" IsChecked="{Binding LzmaIsChecked}" />
                            <CheckBox x:Name="XzCheckBox" Content="XZ (.xz)" Margin="0,4" IsChecked="{Binding XzIsChecked}" />
                            <CheckBox x:Name="RarCheckBox" Content="RAR (.rar)" Margin="0,4" IsChecked="{Binding RarIsChecked}" />
                            <CheckBox x:Name="LzhCheckBox" Content="LZH (.lzh)" Margin="0,4" IsChecked="{Binding LzhIsChecked}" />
                            <CheckBox x:Name="CabCheckBox" Content="CAB (.cab)" Margin="0,4" IsChecked="{Binding CabIsChecked}" />
                            <CheckBox x:Name="ArjCheckBox" Content="ARJ (.arj)" Margin="0,4" IsChecked="{Binding ArjIsChecked}" />
                            <CheckBox x:Name="ZCheckBox" Content="Z (.z)" Margin="0,4" IsChecked="{Binding ZIsChecked}" />
                            <CheckBox x:Name="TgzCheckBox" Content="TAR.GZ (.tgz)" Margin="0,4" IsChecked="{Binding TgzIsChecked}" />
                            <CheckBox x:Name="Tbz2CheckBox" Content="TAR.BZ2 (.tbz2)" Margin="0,4" IsChecked="{Binding Tbz2IsChecked}" />
                            <CheckBox x:Name="TbzCheckBox" Content="TAR.BZ (.tbz)" Margin="0,4" IsChecked="{Binding TbzIsChecked}" />
                            <CheckBox x:Name="TlzCheckBox" Content="TAR.LZMA (.tlz)" Margin="0,4" IsChecked="{Binding TlzIsChecked}" />
                            <CheckBox x:Name="TxzCheckBox" Content="TAR.XZ (.txz)" Margin="0,4" IsChecked="{Binding TxzIsChecked}" />
                            <CheckBox x:Name="TZCheckBox" Content="TAR.Z (.tz)" Margin="0,4" IsChecked="{Binding TzIsChecked}" />
                        </UniformGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- バージョン情報タブ -->
            <TabItem Header="ℹ️ バージョン">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!-- アプリケーション情報 -->
                        <TextBlock Text="Lhamiel" FontSize="32" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="圧縮・展開ソフトウェア" FontSize="16" Foreground="Gray" Margin="0,0,0,24" />

                        <!-- バージョン情報 -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="16" Margin="0,0,0,16" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="バージョン情報" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="バージョン:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,4" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VersionTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" Text="{Binding VersionText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- コピーライト -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="16" Margin="0,0,0,16" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="コピーライト" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="CopyrightTextBlock" TextWrapping="Wrap" Margin="0,4" Text="{Binding CopyrightText}" />
                            </StackPanel>
                        </Border>

                        <!-- ライセンス -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="16" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="ライセンス" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="MIT License" FontWeight="SemiBold" Margin="0,4,0,8" />
                                <TextBlock x:Name="LicenseTextBlock" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Margin="0,4" LineHeight="16" Text="{Binding LicenseText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 下部コントロールエリア -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 圧縮形式選択 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="デフォルトの圧縮形式:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                <ComboBox x:Name="CompressionFormatComboBox" Width="85" Height="40"
                          ItemsSource="{Binding CompressionFormats}"
                          SelectedItem="{Binding SelectedCompressionFormat}"
                          ToolTip.Tip="圧縮時に使用する形式を選択">
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- アクションボタン -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CreateShortcutButton" Content="📌 デスクトップにショートカット作成"
                        Height="40"
                        Margin="0,0,16,0"
                        Command="{Binding CreateShortcutCommand}"
                        ToolTip.Tip="デスクトップにアプリケーションのショートカットを作成" />
                <Button x:Name="SaveButton" Content="設定を保存"
                        Height="40"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="現在の設定を保存して閉じる" />
                <Button x:Name="CancelButton" Content="キャンセル"
                        Height="40"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="設定を保存せずに閉じる" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

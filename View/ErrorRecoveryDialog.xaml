<Window
    x:Class="Lhamiel.View.ErrorRecoveryDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:view="using:Lhamiel.View"
    Title="エラー回復オプション"
    Width="600"
    Height="500"
    x:DataType="view:ErrorRecoveryDialog"
    Background="{DynamicResource Brush.Window}"
    CanResize="True"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  エラー情報  -->
        <primitives:HeaderedContentControl
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="エラー情報">
            <StackPanel Margin="10">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="Red"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Text="{Binding ErrorDetails}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="Blue"
                    Text="{Binding RecommendedAction}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!--  ファイル情報  -->
        <primitives:HeaderedContentControl
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="問題のあるファイル">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="5"
                    FontWeight="Bold"
                    Text="{Binding ProblematicFilePath}"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Grid.Row="1"
                    Margin="5"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Text="{Binding FileDetails}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </primitives:HeaderedContentControl>

        <!--  回復オプション  -->
        <primitives:HeaderedContentControl
            Grid.Row="2"
            Margin="0,0,0,10"
            Header="回復オプション">
            <StackPanel Margin="10">
                <RadioButton
                    x:Name="SkipFileRadio"
                    Margin="0,2"
                    Content="このファイルをスキップして続行"
                    IsChecked="True" />
                <RadioButton
                    x:Name="RetryRadio"
                    Margin="0,2"
                    Content="再試行する" />
                <RadioButton
                    x:Name="StopRadio"
                    Margin="0,2"
                    Content="展開を停止する" />
                <RadioButton
                    x:Name="SkipAllRadio"
                    Margin="0,2"
                    Content="以降のエラーもすべてスキップ" />

                <CheckBox
                    x:Name="RememberChoiceCheck"
                    Margin="0,10,0,0"
                    Content="この選択を記憶する"
                    IsChecked="False" />
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!--  ボタン  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="OkButton"
                Width="80"
                Height="30"
                Margin="5,0"
                Click="OkButton_Click"
                Content="OK" />
            <Button
                x:Name="CancelButton"
                Width="80"
                Height="30"
                Margin="5,0"
                Click="CancelButton_Click"
                Content="キャンセル" />
        </StackPanel>
    </Grid>
</Window>

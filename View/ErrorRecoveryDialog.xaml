<Window x:Class="Lhamiel.View.ErrorRecoveryDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:view="using:Lhamiel.View"
        x:DataType="view:ErrorRecoveryDialog"
        Title="エラー回復オプション" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- エラー情報 -->
        <primitives:HeaderedContentControl Grid.Row="0" Header="エラー情報" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding ErrorMessage}" FontWeight="Bold" Foreground="Red" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorDetails}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="{Binding RecommendedAction}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="Blue"/>
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!-- ファイル情報 -->
        <primitives:HeaderedContentControl Grid.Row="1" Header="問題のあるファイル" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding ProblematicFilePath}" FontWeight="Bold" TextWrapping="Wrap" Margin="5"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                    <TextBlock Text="{Binding FileDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>
            </Grid>
        </primitives:HeaderedContentControl>

        <!-- 回復オプション -->
        <primitives:HeaderedContentControl Grid.Row="2" Header="回復オプション" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <RadioButton x:Name="SkipFileRadio" Content="このファイルをスキップして続行" IsChecked="True" Margin="0,2"/>
                <RadioButton x:Name="RetryRadio" Content="再試行する" Margin="0,2"/>
                <RadioButton x:Name="StopRadio" Content="展開を停止する" Margin="0,2"/>
                <RadioButton x:Name="SkipAllRadio" Content="以降のエラーもすべてスキップ" Margin="0,2"/>
                
                <CheckBox x:Name="RememberChoiceCheck" Content="この選択を記憶する" Margin="0,10,0,0" IsChecked="False"/>
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" Margin="5,0" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="キャンセル" Width="80" Height="30" Margin="5,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

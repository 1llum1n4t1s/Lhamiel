<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 公式NuGetフィード -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- 共通サポートSDK。資格情報はローカル設定またはGitHub Actionsで実行時に注入する。 -->
    <add key="github" value="https://nuget.pkg.github.com/1llum1n4t1s/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- すべてのパッケージをnuget.orgから取得 -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Kagayoi.Support.Client" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <!-- 実値は環境変数だけから受け取り、リポジトリへ資格情報を保存しない。 -->
    <github>
      <add key="Username" value="1llum1n4t1s" />
      <add key="ClearTextPassword" value="%KAGAYOI_GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>

  <config>
    <!-- グローバルパッケージフォルダのパス（デフォルト: ~/.nuget/packages） -->
    <!-- <add key="globalPackagesFolder" value="packages" /> -->

    <!-- リポジトリパス（デフォルト: プロジェクトのpackagesフォルダ） -->
    <!-- <add key="repositoryPath" value="packages" /> -->
  </config>

  <packageRestore>
    <!-- 自動パッケージ復元を有効化 -->
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <AssemblyTitle>GGEZArchiver</AssemblyTitle>
    <AssemblyProduct>GGEZArchiver</AssemblyProduct>
    <AssemblyCompany>GGEZArchiver</AssemblyCompany>
    <RootNamespace>GGEZArchiver</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="9.0.6" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
    <PackageReference Include="7z.Libs" Version="25.0.0" />
    <PackageReference Include="SevenZipSharp" Version="0.64.0" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
    <None Include="app.ico" />
  </ItemGroup>

</Project>

  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">文件：{0}\n错误：{1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">您可以选择重试或跳过。</x:String>

  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">当前位置 {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">目标位置 {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">磁盘空间不足</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">所需空间：</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">可用空间：</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">不足：</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">驱动器：{0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">磁盘空间不足。请删除不需要的文件，然后点击重试。</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">重试</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">取消</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">如果存在重复文件，解压后将显示确认对话框</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} 个文件冲突</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">选择要包含在压缩包中的文件。如果选择多个，将在文件名中添加编号。</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">您想保留哪些文件？</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">跳过 {0} 个日期和大小相同的文件</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">继续</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">取消</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">全部覆盖</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">解压完成：{0}/{1} 个文件成功</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">未知</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">无法加载许可证信息。</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">因磁盘空间不足而取消。</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">用户取消了解压。</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">未找到压缩文件：{0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">准备目标位置时发生错误。文件可能正在使用或您没有删除权限。</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">无法将内容移动到目标位置。原始内容仍保留在备份位置。</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">未指定要压缩的文件。</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">未找到指定的路径：{0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">无法生成唯一的文件名：{0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">保存设置失败：{0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">未找到已解压的文件。</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">文件路径为空。</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">路径过长。最大允许 {0} 个字符。（当前：{1} 个字符）</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">目录路径过长。最大允许 {0} 个字符。</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">文件名过长。最大允许 {0} 个字符。</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">无法解析路径：{0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">路径包含无效字符：'{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">文件名包含无效字符：'{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">验证文件名时发生错误：{0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">检测到无效的路径格式</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">路径验证失败：{0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">使用了保留的设备名称：{0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' 受系统保护，无法被覆盖。请选择其他位置。</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">正在压缩...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">归档包含指向解压目标之外的不安全条目: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">需要密码</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">此压缩档案受密码保护。请输入密码以解压。</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">密码</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">先前输入的密码不正确，请重试。</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">需要密码或密码不正确</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">此压缩档案受密码保护。未提供密码或密码不匹配: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">请重新解压并输入正确的密码。</x:String>
</ResourceDictionary>

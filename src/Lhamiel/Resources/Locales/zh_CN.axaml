<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Lhamiel/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - 压缩与解压工具</x:String>
  <x:String x:Key="Text.Progress.Title" xml:space="preserve">处理中...</x:String>
  <x:String x:Key="Text.Overwrite.Title" xml:space="preserve">替换文件</x:String>
  <x:String x:Key="Text.ErrorRecovery.Title" xml:space="preserve">错误恢复选项</x:String>

  <!-- Drop Zone -->

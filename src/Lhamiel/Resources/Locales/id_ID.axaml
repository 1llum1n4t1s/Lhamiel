  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">Buka folder tujuan setelah kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">Kompresi Gabungan</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">Opsi Kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">Kompres beberapa berkas menjadi satu arsip</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">Jika MATI, setiap berkas akan dikompres menjadi arsip terpisah</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">Sertakan direktori root saat kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">Kecualikan direktori root saat kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">Kecualikan semua direktori saat kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">Tingkat Kompresi</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">Tingkat Kompresi ZIP</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">Tingkat Kompresi 7z</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystem" xml:space="preserve">Sertakan file dan folder tersembunyi/sistem</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystemDescription" xml:space="preserve">Entri dengan atribut Hidden atau System juga ditambahkan ke arsip.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Header" xml:space="preserve">Pengecualian Kompresi</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Description" xml:space="preserve">Pengaturan di halaman ini berlaku untuk semua kompresi Lhamiel bagi pengguna Windows ini. Tentukan pengecualian khusus sumber dalam berkas aturan di setiap folder sumber.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Header" xml:space="preserve">Aturan pengecualian bersama</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Description" xml:space="preserve">Pola yang didaftarkan di sini berlaku untuk semua sumber kompresi. Sintaksis kompatibel .gitignore didukung.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Path" xml:space="preserve">Disimpan di: %LocalAppData%\Lhamiel\.lhaignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Placeholder" xml:space="preserve">mis. *.log atau node_modules/</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Add" xml:space="preserve">Tambah</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Remove" xml:space="preserve">Hapus</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Reset" xml:space="preserve">Pulihkan aturan bersama</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile" xml:space="preserve">Buka berkas pengecualian bersama</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile.Tip" xml:space="preserve">Membuka .lhaignore yang menyimpan aturan bersama di editor teks default</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Header" xml:space="preserve">Muat aturan khusus folder</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Description" xml:space="preserve">Mencari berkas aturan dalam folder sumber dan menerapkan setiap berkas di bawah foldernya. Kebijakan pemuatan ini berlaku untuk semua kompresi.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore" xml:space="preserve">Gunakan aturan pengecualian dari folder sumber</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore.Tip" xml:space="preserve">Mencari berkas kandidat di setiap folder dan menerapkan aturan terpilih di bawah folder tersebut</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Label" xml:space="preserve">Nama berkas yang dikenali (prioritas tertinggi di atas)</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Placeholder" xml:space="preserve">mis. .lhamielignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Tip" xml:space="preserve">Masukkan satu nama berkas per baris. Subfolder mempertahankan kandidat warisan atau beralih ke kandidat berprioritas lebih tinggi; tidak pernah kembali ke prioritas yang lebih rendah.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Invalid" xml:space="preserve">Masukkan satu nama berkas sederhana per baris. Jalur, karakter pengganti, dan nama cadangan tidak diizinkan.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Notice" xml:space="preserve">Daftar nama ini adalah pengaturan global Lhamiel. Ini menentukan berkas yang dicari, bukan isi aturan pengecualian.</x:String>


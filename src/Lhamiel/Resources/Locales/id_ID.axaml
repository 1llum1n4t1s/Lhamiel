  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">Dibatalkan karena ruang disk tidak mencukupi.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">Pengguna membatalkan ekstraksi.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">Berkas arsip tidak ditemukan: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">Terjadi kesalahan saat menyiapkan tujuan. Berkas mungkin sedang digunakan atau Anda tidak memiliki izin hapus.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">Gagal memindahkan konten ke tujuan. Konten asli tetap berada di lokasi cadangan.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">Tidak ada berkas yang ditentukan untuk dikompresi.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">Jalur yang ditentukan tidak ditemukan: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">Tidak dapat menghasilkan nama berkas unik: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">Gagal menyimpan pengaturan: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">Berkas yang diekstrak tidak ditemukan.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">Jalur berkas kosong.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">Jalur terlalu panjang. Maksimum {0} karakter diperbolehkan. (Saat ini: {1} karakter)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">Jalur direktori terlalu panjang. Maksimum {0} karakter diperbolehkan.</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">Nama berkas terlalu panjang. Maksimum {0} karakter diperbolehkan.</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">Gagal mengurai jalur: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">Jalur mengandung karakter tidak valid: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">Nama berkas mengandung karakter tidak valid: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">Terjadi kesalahan saat memvalidasi nama berkas: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">Format jalur tidak valid terdeteksi</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">Validasi jalur gagal: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">Nama perangkat yang dicadangkan sedang digunakan: {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' dilindungi oleh sistem dan tidak dapat ditimpa. Pilih lokasi lain.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">Mengompresi...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">Arsip berisi entri tidak aman yang menunjuk keluar dari target ekstraksi: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">Kata sandi diperlukan</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">Arsip ini dilindungi kata sandi. Masukkan kata sandi untuk mengekstraknya.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">Kata sandi</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">Kata sandi sebelumnya salah. Silakan coba lagi.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">Kata sandi diperlukan atau salah</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">Arsip ini dilindungi kata sandi. Tidak ada kata sandi yang diberikan atau tidak cocok: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">Ulangi ekstraksi dan masukkan kata sandi yang benar.</x:String>
</ResourceDictionary>

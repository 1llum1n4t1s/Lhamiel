  <x:String x:Key="Text.Settings.Theme.Tooltip" xml:space="preserve">Cambiar el tema de la aplicación</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">Sistema (seguir el SO)</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Oscuro</x:String>

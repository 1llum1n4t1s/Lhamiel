  <x:String x:Key="Text.Sidebar.Version" xml:space="preserve">ℹ️ Versión</x:String>

  <!-- General Settings -->
  <x:String x:Key="Text.Settings.Theme.Header" xml:space="preserve">Tema</x:String>

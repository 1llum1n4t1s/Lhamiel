  <!-- Protección con contraseña (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">Protección con contraseña</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">Proteger con contraseña</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">Cifra ZIP con AES-256 (WinZip AE-2) y 7z con AES-256.</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR no admite protección con contraseña. Elija ZIP o 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">Nota: los ZIP cifrados con AES-256 no se pueden abrir con el Explorador integrado de Windows. Los destinatarios necesitan 7-Zip, WinRAR u otra herramienta compatible.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">Cifrar también los nombres de archivo</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">Cifra la lista de nombres de archivo (encabezado) dentro del archivo. Sin la contraseña, ni siquiera el contenido se podrá examinar.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">El formato ZIP no puede cifrar los nombres de archivo (directorio central). Cambie a 7z para habilitar esta opción.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">Cómo introducir la contraseña</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">Preguntar en cada acción de soltar</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">Guardar y reutilizar (cifrado DPAPI)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">Contraseña: establecida</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">Contraseña: no establecida (se solicitará en la próxima compresión)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">Cambiar contraseña</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">Borrar contraseña</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">Establecer contraseña</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">Establezca una contraseña para cifrar el archivo. Introdúzcala dos veces para confirmarla.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">Contraseña (confirmación)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">Las contraseñas no coinciden. Vuelva a introducir la confirmación.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">Introduzca una contraseña.</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">La contraseña debe tener al menos 4 caracteres.</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">Puede pegar desde un gestor de contraseñas (Ctrl+V).</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">¿Eliminar la contraseña guardada?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">Cambiar a "Preguntar en cada acción de soltar" eliminará la contraseña guardada actualmente. ¿Continuar?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">¿Eliminar la contraseña guardada?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">Se eliminará la contraseña guardada. Deberá introducirla de nuevo en la próxima compresión. ¿Continuar?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">No se pudo restaurar la contraseña guardada (posiblemente debido a una copia de la configuración desde otro PC o un restablecimiento de la contraseña de Windows). Vuelva a establecer la contraseña.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">La contraseña guardada contiene caracteres que no se pueden usar con el formato ZIP (solo ASCII). Introduzca una contraseña para esta compresión (la contraseña guardada no se modificará).</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">La contraseña guardada es demasiado corta para usarse (se requieren al menos {0} caracteres). Establezca una nueva contraseña.</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">Se omitieron {0} archivo(s) por ser inaccesibles. Se creó un archivo protegido con contraseña con los archivos restantes.</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">Todos los archivos de origen eran inaccesibles, por lo que se canceló la compresión. No se creó un archivo vacío.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">El formato {0} no admite protección con contraseña. Elija ZIP o 7z.</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">Las contraseñas ZIP solo pueden contener caracteres ASCII (letras, dígitos y símbolos). Para usar otros caracteres (como letras acentuadas o japonés), elija el formato 7z.</x:String>
</ResourceDictionary>

  <x:String x:Key="Text.Settings.AppIcon.Description" xml:space="preserve">Elige el icono que se muestra en las ventanas y los accesos directos.</x:String>
  <x:String x:Key="Text.Settings.AppIcon.Classic" xml:space="preserve">Clásico</x:String>
  <x:String x:Key="Text.Settings.AppIcon.Crystal" xml:space="preserve">Cristal pastel</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">Formato de compresión predeterminado</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Header" xml:space="preserve">Acceso directo</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Create" xml:space="preserve">📌 Crear acceso directo en el escritorio</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Header" xml:space="preserve">Menú contextual</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Enable" xml:space="preserve">Mostrar «Lhamielへ» en el menú contextual de archivos y carpetas</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">Idioma</x:String>

  <!-- Output Settings (shared) -->
  <x:String x:Key="Text.Settings.Output.Header" xml:space="preserve">Directorio de salida</x:String>
  <x:String x:Key="Text.Settings.Output.SameDirectory" xml:space="preserve">Guardar en el mismo directorio que el archivo de origen</x:String>
  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">Especificar un directorio</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">Examinar...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">Seleccionar carpeta de extracción</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseCompression" xml:space="preserve">Seleccionar carpeta de compresión</x:String>


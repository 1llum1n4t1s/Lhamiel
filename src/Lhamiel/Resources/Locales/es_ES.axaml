  <x:String x:Key="Text.Overwrite.FolderTitle" xml:space="preserve">Confirmar sobrescritura de carpeta</x:String>
  <x:String x:Key="Text.Overwrite.FileTitle" xml:space="preserve">Reemplazar archivo</x:String>
  <x:String x:Key="Text.Overwrite.DefaultMessage" xml:space="preserve">El archivo ya existe.\n\n¿Desea reemplazarlo?</x:String>


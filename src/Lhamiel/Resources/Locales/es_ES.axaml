<ResourceDictionary xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Lhamiel/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - Herramienta de compresión y extracción de archivos</x:String>
  <x:String x:Key="Text.Progress.Title" xml:space="preserve">Procesando...</x:String>
  <x:String x:Key="Text.Overwrite.Title" xml:space="preserve">Reemplazar archivo</x:String>
  <x:String x:Key="Text.ErrorRecovery.Title" xml:space="preserve">Opciones de recuperación de errores</x:String>

  <!-- Drop Zone -->
  <x:String x:Key="Text.DropZone.Message" xml:space="preserve">Suelte archivos aquí para comprimir o extraer</x:String>
  <x:String x:Key="Text.DropZone.Footer" xml:space="preserve">Arrastre y suelte archivos en esta ventana para comprimir o extraer</x:String>


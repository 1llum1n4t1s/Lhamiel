  <x:String x:Key="Text.Error.FolderNotFound" xml:space="preserve">No se encontró el archivo o carpeta especificado.\n{0}</x:String>
  <x:String x:Key="Text.Error.IpcForwardFailed">No se pudo comunicar con la instancia de Lhamiel en ejecución. Es posible que se esté actualizando. La solicitud no se procesó; inténtelo de nuevo en unos momentos.</x:String>
  <x:String x:Key="Text.Error.UnsupportedFormat" xml:space="preserve">Formato de archivo no compatible.\n{0}</x:String>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Lhamiel/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - Herramienta de compresión y extracción de archivos</x:String>

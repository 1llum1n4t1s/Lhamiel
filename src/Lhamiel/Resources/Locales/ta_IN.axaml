  <x:String x:Key="Text.Version.AppName" xml:space="preserve">Lhamiel</x:String>
  <x:String x:Key="Text.Version.Description" xml:space="preserve">காப்பக சுருக்கம் &amp; பிரித்தெடுத்தல் கருவி</x:String>
  <x:String x:Key="Text.Version.Label" xml:space="preserve">பதிப்பு</x:String>

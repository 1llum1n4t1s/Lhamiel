  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - காப்பக சுருக்கம் &amp; பிரித்தெடுத்தல் கருவி</x:String>
  <x:String x:Key="Text.Progress.Title" xml:space="preserve">செயலாக்கம்...</x:String>
  <x:String x:Key="Text.Overwrite.Title" xml:space="preserve">கோப்பை மாற்றவும்</x:String>
  <x:String x:Key="Text.ErrorRecovery.Title" xml:space="preserve">பிழை மீட்பு விருப்பங்கள்</x:String>

  <!-- Drop Zone -->
  <x:String x:Key="Text.DropZone.Message" xml:space="preserve">சுருக்க அல்லது பிரித்தெடுக்க கோப்புகளை இங்கே இழுக்கவும்</x:String>
  <x:String x:Key="Text.DropZone.Footer" xml:space="preserve">சுருக்க அல்லது பிரித்தெடுக்க கோப்புகளை இந்த சாளரத்தில் இழுத்து விடவும்</x:String>

  <!-- Settings Tabs -->
  <x:String x:Key="Text.Settings.Tab.General" xml:space="preserve">⚙️ பொது</x:String>
  <x:String x:Key="Text.Settings.Tab.Extraction" xml:space="preserve">📂 பிரித்தெடுத்தல்</x:String>
  <x:String x:Key="Text.Settings.Tab.Compression" xml:space="preserve">📦 சுருக்கம்</x:String>
  <x:String x:Key="Text.Settings.Tab.Association" xml:space="preserve">🔗 கோப்பு தொடர்புகள்</x:String>
  <x:String x:Key="Text.Settings.Tab.Version" xml:space="preserve">ℹ️ பதிப்பு</x:String>

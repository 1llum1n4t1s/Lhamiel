  <x:String x:Key="Text.Dialog.Error" xml:space="preserve">பிழை</x:String>
  <x:String x:Key="Text.Dialog.Info" xml:space="preserve">தகவல்</x:String>
  <x:String x:Key="Text.Dialog.Warning" xml:space="preserve">எச்சரிக்கை</x:String>
  <x:String x:Key="Text.Dialog.Completed" xml:space="preserve">நிறைவடைந்தது</x:String>
  <x:String x:Key="Text.Dialog.Details" xml:space="preserve">விவரங்கள்: </x:String>

  <!-- Error Messages -->
  <x:String x:Key="Text.Error.FileNotFound" xml:space="preserve">குறிப்பிட்ட கோப்பு கிடைக்கவில்லை.\n{0}</x:String>
  <x:String x:Key="Text.Error.FolderNotFound" xml:space="preserve">குறிப்பிட்ட கோப்பு அல்லது கோப்புறை கிடைக்கவில்லை.\n{0}</x:String>
  <x:String x:Key="Text.Error.UnsupportedFormat" xml:space="preserve">ஆதரிக்கப்படாத கோப்பு வடிவம்.\n{0}</x:String>
  <x:String x:Key="Text.Error.UnsupportedCompression" xml:space="preserve">ஆதரிக்கப்படாத சுருக்க வடிவம்.\n{0}</x:String>
  <x:String x:Key="Text.Error.DuringExtraction" xml:space="preserve">பிரித்தெடுக்கும் போது பிழை ஏற்பட்டது.\n{0}</x:String>
  <x:String x:Key="Text.Error.CrcVerificationFailed" xml:space="preserve">CRC ஒருமைப்பாடு சரிபார்ப்பு தோல்வி: {0}\n{1}</x:String>
  <x:String x:Key="Text.Error.DuringCompression" xml:space="preserve">சுருக்கும் போது பிழை ஏற்பட்டது.\n{0}</x:String>
  <x:String x:Key="Text.Error.DuringProcessing" xml:space="preserve">செயலாக்கத்தின் போது பிழை ஏற்பட்டது.\n{0}</x:String>
  <x:String x:Key="Text.Error.FileLocked" xml:space="preserve">வெளியீடு '{0}' பயன்பாட்டில் உள்ளது அல்லது அணுகல் மறுக்கப்பட்டது.</x:String>
  <x:String x:Key="Text.Error.SaveSettings" xml:space="preserve">அமைப்புகளைச் சேமிக்க இயலவில்லை.</x:String>
  <x:String x:Key="Text.Error.ProcessFiles" xml:space="preserve">கோப்புகளைச் செயலாக்க இயலவில்லை.</x:String>
  <x:String x:Key="Text.Error.ApplyAssociation" xml:space="preserve">கோப்பு தொடர்பு அமைப்புகளைப் பயன்படுத்த இயலவில்லை.</x:String>
  <x:String x:Key="Text.Error.InitApp" xml:space="preserve">பயன்பாட்டை துவக்க இயலவில்லை.</x:String>
  <x:String x:Key="Text.Error.OverwriteDialog" xml:space="preserve">மேலெழுதல் உறுதிப்படுத்தல் உரையாடலைக் காட்ட இயலவில்லை: {0}</x:String>
  <x:String x:Key="Text.Error.SelectAll" xml:space="preserve">அனைத்தையும் தேர்வுசெய்யும் போது பிழை ஏற்பட்டது.</x:String>
  <x:String x:Key="Text.Error.DeselectAll" xml:space="preserve">அனைத்தையும் நீக்கும் போது பிழை ஏற்பட்டது.</x:String>
  <x:String x:Key="Text.Error.ExtractionTitle" xml:space="preserve">பிரித்தெடுத்தல் பிழை</x:String>

  <!-- Shortcut Messages -->
  <x:String x:Key="Text.Shortcut.Created" xml:space="preserve">டெஸ்க்டாப்பில் குறுக்குவழி உருவாக்கப்பட்டது.</x:String>
  <x:String x:Key="Text.Shortcut.Failed" xml:space="preserve">குறுக்குவழியை உருவாக்க இயலவில்லை.</x:String>
  <x:String x:Key="Text.Shortcut.Error" xml:space="preserve">குறுக்குவழியை உருவாக்கும் போது பிழை ஏற்பட்டது.</x:String>

  <!-- Update Messages -->
  <x:String x:Key="Text.Update.Applying" xml:space="preserve">புதுப்பிப்பைப் பயன்படுத்துகிறது... மறுதொடக்கம்.</x:String>
  <x:String x:Key="Text.Update.UpToDate" xml:space="preserve">✅ ஏற்கனவே புதுப்பித்த நிலையில் உள்ளது.</x:String>
  <x:String x:Key="Text.Update.DevEnvironment" xml:space="preserve">⚠ மேம்பாட்டு சூழலில் புதுப்பிப்புகளைச் சரிபார்க்க இயலாது.</x:String>
  <x:String x:Key="Text.Update.NoRepository" xml:space="preserve">⚠ புதுப்பிப்பு களஞ்சியம் கட்டமைக்கப்படவில்லை.</x:String>
  <x:String x:Key="Text.Update.Error" xml:space="preserve">⚠ புதுப்பிப்புகளைச் சரிபார்க்கும் போது பிழை ஏற்பட்டது.</x:String>
  <x:String x:Key="Text.Update.Timeout" xml:space="preserve">புதுப்பிப்பு சரிபார்ப்பு காலாவதியானது.</x:String>
  <x:String x:Key="Text.Update.Downloading" xml:space="preserve">புதுப்பிப்பைப் பதிவிறக்குகிறது...</x:String>
  <x:String x:Key="Text.Update.Downloaded" xml:space="preserve">புதுப்பிப்பு பதிவிறக்கப்பட்டது. பயன்படுத்துகிறது...</x:String>
  <x:String x:Key="Text.Update.Latest" xml:space="preserve">ஏற்கனவே சமீபத்திய பதிப்பு.</x:String>
  <x:String x:Key="Text.Update.DownloadTimeout" xml:space="preserve">பதிவிறக்கம் காலாவதியானது.</x:String>
  <x:String x:Key="Text.Update.CheckError" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்க்கும் போது பிழை ஏற்பட்டது.</x:String>
  <x:String x:Key="Text.Update.RepoNotConfigured" xml:space="preserve">புதுப்பிப்பு களஞ்சியம் கட்டமைக்கப்படவில்லை.</x:String>
  <x:String x:Key="Text.Update.DevSkip" xml:space="preserve">மேம்பாட்டு சூழலில் புதுப்பிப்புகளைச் சரிபார்க்க இயலாது.</x:String>

  <!-- Self Update Dialog (VelopackUpdateDialog.Avalonia) -->
  <x:String x:Key="Text.Close" xml:space="preserve">மூடு</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">மென்பொருள் புதுப்பி</x:String>
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">இந்த மென்பொருளின் புதிய பதிப்பு கிடைக்கிறது: </x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்க்கிறது…</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்க்க முடியவில்லை!</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">பதிவிறக்கி நிறுவு</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">இந்தப் பதிப்பைத் தவிர்</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">தற்போது புதுப்பிப்புகள் எதுவும் கிடைக்கவில்லை.</x:String>
  <x:String x:Key="Text.Settings.Update.Header" xml:space="preserve">புதுப்பிப்புகள்</x:String>
  <x:String x:Key="Text.Settings.Update.Check4UpdatesOnStartup" xml:space="preserve">தொடக்கத்தில் புதுப்பிப்புகளைச் சரிபார்</x:String>
  <x:String x:Key="Text.Settings.Version.SkippedVersion" xml:space="preserve">{0} இன் புதுப்பிப்பு அறிவிப்புகள் தவிர்க்கப்படுகின்றன</x:String>
  <x:String x:Key="Text.Settings.Version.ClearSkippedVersion" xml:space="preserve">தவிர்ப்பை ரத்து செய்</x:String>

  <!-- Error Handler -->
  <x:String x:Key="Text.ErrorHandler.FileNotFound" xml:space="preserve">காப்பகக் கோப்பு கிடைக்கவில்லை</x:String>
  <x:String x:Key="Text.ErrorHandler.FileNotFoundDetail" xml:space="preserve">குறிப்பிட்ட கோப்பு இல்லை: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileNotFoundAction" xml:space="preserve">கோப்பு பாதையைச் சரிபார்த்து கோப்பு இருப்பதை உறுதிசெய்யவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDenied" xml:space="preserve">அணுகல் மறுக்கப்பட்டது</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDeniedDetail" xml:space="preserve">கோப்பு அல்லது அடைவுக்கான அணுகல் மறுக்கப்பட்டது: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDeniedAction" xml:space="preserve">நிர்வாகியாக இயக்கவும் அல்லது கோப்பு அனுமதிகளைச் சரிபார்க்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFull" xml:space="preserve">போதுமான வட்டு இடம் இல்லை</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullDetail" xml:space="preserve">இலக்கு வட்டில் போதுமான இடம் இல்லை: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullAction" xml:space="preserve">வட்டு இடத்தை காலி செய்யவும் அல்லது வேறு வட்டில் பிரித்தெடுக்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUse" xml:space="preserve">கோப்பு பயன்பாட்டில் உள்ளது</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseDetail" xml:space="preserve">கோப்பு வேறொரு பயன்பாட்டால் பயன்படுத்தப்படுகிறது: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseAction" xml:space="preserve">கோப்பைப் பயன்படுத்தும் பயன்பாட்டை மூடிவிட்டு மீண்டும் முயற்சிக்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnected" xml:space="preserve">Device is not responding</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedDetail" xml:space="preserve">External device (USB / NAS / removable media) was disconnected or is not responding: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedAction" xml:space="preserve">Check the device connection and reconnect before retrying.</x:String>
  <x:String x:Key="Text.ErrorHandler.IOError" xml:space="preserve">I/O பிழை ஏற்பட்டது</x:String>
  <x:String x:Key="Text.ErrorHandler.IOErrorAction" xml:space="preserve">கோப்பின் நிலையைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.Corrupted" xml:space="preserve">காப்பகக் கோப்பு சிதைந்துள்ளது</x:String>
  <x:String x:Key="Text.ErrorHandler.CorruptedAction" xml:space="preserve">கோப்பை மீண்டும் பதிவிறக்கவும் அல்லது பழுதுபார்க்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperation" xml:space="preserve">தவறான செயல்பாடு நிகழ்த்தப்பட்டது</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperationAction" xml:space="preserve">செயல்பாட்டைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormat" xml:space="preserve">ஆதரிக்கப்படாத கோப்பு வடிவம்</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatDetail" xml:space="preserve">இந்தக் கோப்பு வடிவம் ஆதரிக்கப்படவில்லை: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatAction" xml:space="preserve">ஆதரிக்கப்படும் வடிவத்தைப் பயன்படுத்தவும் (ZIP, 7Z, RAR போன்றவை).</x:String>
  <x:String x:Key="Text.ErrorHandler.Unexpected" xml:space="preserve">எதிர்பாராத பிழை ஏற்பட்டது</x:String>
  <x:String x:Key="Text.ErrorHandler.UnexpectedAction" xml:space="preserve">பிழை விவரங்களை மதிப்பாய்வு செய்து தேவைப்பட்டால் ஆதரவைத் தொடர்புகொள்ளவும்.</x:String>
  <x:String x:Key="Text.ErrorHandler.ArchiveFile" xml:space="preserve">காப்பகக் கோப்பு: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.ErrorMessage" xml:space="preserve">பிழை செய்தி: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileSize" xml:space="preserve">கோப்பு அளவு: {0:N0} பைட்டுகள்</x:String>
  <x:String x:Key="Text.ErrorHandler.LastModified" xml:space="preserve">கடைசியாக மாற்றப்பட்டது: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInfoFailed" xml:space="preserve">கோப்பு தகவலைப் பெற இயலவில்லை</x:String>

  <!-- Error Recovery File Info -->
  <x:String x:Key="Text.ErrorRecovery.FileName" xml:space="preserve">கோப்பு பெயர்: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileSize" xml:space="preserve">அளவு: {0:N0} பைட்டுகள்</x:String>
  <x:String x:Key="Text.ErrorRecovery.CreatedDate" xml:space="preserve">உருவாக்கப்பட்டது: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ModifiedDate" xml:space="preserve">மாற்றப்பட்டது: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.Attributes" xml:space="preserve">பண்புகள்: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.DiskInfo" xml:space="preserve">வட்டுத் தகவல்:</x:String>
  <x:String x:Key="Text.ErrorRecovery.AvailableSpace" xml:space="preserve">கிடைக்கும் இடம்: {0:N0} பைட்டுகள்</x:String>
  <x:String x:Key="Text.ErrorRecovery.TotalSpace" xml:space="preserve">மொத்த கொள்ளளவு: {0:N0} பைட்டுகள்</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileInfoFailed" xml:space="preserve">கோப்பு தகவலைப் பெற இயலவில்லை: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionDetails" xml:space="preserve">விதிவிலக்கு விவரங்கள்:</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionType" xml:space="preserve">வகை: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionMessage" xml:space="preserve">செய்தி: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.InnerException" xml:space="preserve">உள் விதிவிலக்கு: {0}</x:String>

  <!-- Partial Extraction -->
  <x:String x:Key="Text.Extraction.Progress" xml:space="preserve">பிரித்தெடுக்கிறது: {0}</x:String>
  <x:String x:Key="Text.Extraction.ReExtracting" xml:space="preserve">மீண்டும் பிரித்தெடுக்கிறது: {0}</x:String>
  <x:String x:Key="Text.Extraction.FileNotInArchive" xml:space="preserve">இலக்குக் கோப்பு காப்பகத்தில் கிடைக்கவில்லை.</x:String>
  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">கோப்பு: {0}\nபிழை: {1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">மீண்டும் முயற்சிக்கவும் அல்லது தவிர்க்கவும் தேர்வுசெய்யலாம்.</x:String>

  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">தற்போதைய இடம் {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">இலக்கு {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">போதுமான வட்டு இடம் இல்லை</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">தேவையான இடம்:</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">கிடைக்கும் இடம்:</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">பற்றாக்குறை:</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">இயக்கி: {0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">வட்டு இடம் போதவில்லை. தேவையற்ற கோப்புகளை நீக்கிவிட்டு மீண்டும் முயற்சி அழுத்தவும்.</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">மீண்டும் முயற்சி</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">ரத்துசெய்</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">நகல் கோப்புகள் இருந்தால், பிரித்தெடுத்த பின் உறுதிப்படுத்தல் உரையாடல் தோன்றும்</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} கோப்பு மோதல்கள்</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">காப்பகத்தில் சேர்க்க வேண்டிய கோப்புகளைத் தேர்ந்தெடுக்கவும். பல தேர்ந்தெடுத்தால், எண்கள் சேர்க்கப்படும்.</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">எந்த கோப்புகளை வைத்திருக்க விரும்புகிறீர்கள்?</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">ஒரே தேதி மற்றும் அளவு கொண்ட {0} கோப்புகளை தவிர்</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">தொடரவும்</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">ரத்துசெய்</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">அனைத்தையும் மேலெழுது</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">பிரித்தெடுத்தல் முடிந்தது: {0}/{1} கோப்புகள் வெற்றி</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">தெரியாது</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">உரிம தகவலை ஏற்ற இயலவில்லை.</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">போதுமான வட்டு இடம் இல்லாததால் ரத்துசெய்யப்பட்டது.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">பயனர் பிரித்தெடுத்தலை ரத்துசெய்தார்.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">காப்பகக் கோப்பு கிடைக்கவில்லை: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">இலக்கை தயார் செய்யும்போது பிழை ஏற்பட்டது. கோப்பு பயன்பாட்டில் இருக்கலாம் அல்லது நீக்குவதற்கான அனுமதி இல்லை.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">உள்ளடக்கங்களை இலக்குக்கு நகர்த்த இயலவில்லை. அசல் உள்ளடக்கங்கள் காப்புப் பிரதி இடத்தில் உள்ளன.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">சுருக்குவதற்கு கோப்புகள் குறிப்பிடப்படவில்லை.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">குறிப்பிட்ட பாதை கிடைக்கவில்லை: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">தனித்துவமான கோப்புப் பெயரை உருவாக்க இயலவில்லை: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">அமைப்புகளைச் சேமிக்க இயலவில்லை: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">பிரித்தெடுக்கப்பட்ட கோப்பு கிடைக்கவில்லை.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">கோப்பு பாதை காலியாக உள்ளது.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">பாதை மிகவும் நீளமானது. அதிகபட்சம் {0} எழுத்துகள் அனுமதிக்கப்படுகின்றன. (தற்போது: {1} எழுத்துகள்)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">அடைவு பாதை மிகவும் நீளமானது. அதிகபட்சம் {0} எழுத்துகள் அனுமதிக்கப்படுகின்றன.</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">கோப்புப் பெயர் மிகவும் நீளமானது. அதிகபட்சம் {0} எழுத்துகள் அனுமதிக்கப்படுகின்றன.</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">பாதையை பகுப்பாய்வு செய்ய இயலவில்லை: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">பாதையில் தவறான எழுத்து உள்ளது: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">கோப்புப் பெயரில் தவறான எழுத்து உள்ளது: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">கோப்புப் பெயரைச் சரிபார்க்கும்போது பிழை ஏற்பட்டது: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">தவறான பாதை வடிவம் கண்டறியப்பட்டது</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">பாதை சரிபார்ப்பு தோல்வியடைந்தது: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">ஒதுக்கப்பட்ட சாதனப் பெயர் பயன்படுத்தப்படுகிறது: {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' கணினியால் பாதுகாக்கப்பட்டுள்ளது மற்றும் மேலெழுத முடியாது. வேறு இடத்தைத் தேர்ந்தெடுக்கவும்.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">சுருக்குகிறது...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">பிரித்தெடுப்பதற்கான இலக்கிற்கு வெளியே சுட்டிக்காட்டும் பாதுகாப்பற்ற உள்ளீட்டை காப்பகம் கொண்டுள்ளது: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">கடவுச்சொல் தேவை</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">இந்த காப்பகம் கடவுச்சொல்லால் பாதுகாக்கப்பட்டுள்ளது. பிரித்தெடுக்க கடவுச்சொல்லை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">கடவுச்சொல்</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">முந்தைய கடவுச்சொல் தவறானது. மீண்டும் முயற்சிக்கவும்.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">கடவுச்சொல் தேவை அல்லது தவறு</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">இந்த காப்பகம் கடவுச்சொல்லால் பாதுகாக்கப்பட்டுள்ளது. கடவுச்சொல் வழங்கப்படவில்லை அல்லது பொருந்தவில்லை: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">பிரித்தெடுப்பதை மீண்டும் முயற்சித்து சரியான கடவுச்சொல்லை உள்ளிடவும்.</x:String>

  <!-- கடவுச்சொல் பாதுகாப்பு (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">கடவுச்சொல் பாதுகாப்பு</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">கடவுச்சொல்லால் பாதுகாக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">ZIP-க்கு AES-256 (WinZip AE-2), 7z-க்கு AES-256 மூலம் குறியாக்குகிறது.</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR கடவுச்சொல் பாதுகாப்பை ஆதரிக்காது. ZIP அல்லது 7z-ஐ தேர்வுசெய்க.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">குறிப்பு: AES-256 மூலம் குறியாக்கப்பட்ட ZIP-ஐ Windows-இன் உள்ளமைக்கப்பட்ட Explorer மூலம் திறக்க முடியாது. பெறுபவர்களுக்கு 7-Zip, WinRAR அல்லது இணக்கமான கருவி தேவை.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">கோப்பு பெயர்களையும் குறியாக்கு</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">காப்பகத்தினுள் உள்ள கோப்பு பெயர்கள் பட்டியலையும் (தலைப்பு) குறியாக்குகிறது. கடவுச்சொல் இல்லாமல் உள்ளடக்கத்தைக் கூட பார்க்க முடியாது.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">ZIP வடிவத்தின் விவரக்குறிப்புப்படி கோப்பு பெயர்களை (மைய அடைவு) குறியாக்க முடியாது. இந்த விருப்பத்தை இயக்க 7z-க்கு மாறவும்.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">கடவுச்சொல் உள்ளீட்டு முறை</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">ஒவ்வொரு போடுதலிலும் கேள்</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">சேமித்து மீண்டும் பயன்படுத்து (DPAPI குறியாக்கம்)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">கடவுச்சொல்: அமைக்கப்பட்டது</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">கடவுச்சொல்: அமைக்கப்படவில்லை (அடுத்த அமுக்கத்தில் கேட்கப்படும்)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">கடவுச்சொல்லை மாற்று</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">கடவுச்சொல்லை அழி</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">கடவுச்சொல்லை அமை</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">காப்பகத்தை குறியாக்க கடவுச்சொல்லை அமைக்கவும். உறுதிப்படுத்த இருமுறை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">கடவுச்சொல் (உறுதிப்படுத்தல்)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">கடவுச்சொற்கள் பொருந்தவில்லை. உறுதிப்படுத்தலை மீண்டும் உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">கடவுச்சொல்லை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">கடவுச்சொல் மேலாளரிலிருந்து ஒட்டலாம் (Ctrl+V).</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">சேமிக்கப்பட்ட கடவுச்சொல்லை அழிக்கவா?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">"ஒவ்வொரு போடுதலிலும் கேள்" என்பதற்கு மாறுவது தற்போது சேமிக்கப்பட்டுள்ள கடவுச்சொல்லை அழிக்கும். தொடரவா?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">சேமிக்கப்பட்ட கடவுச்சொல்லை அழிக்கவா?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">சேமிக்கப்பட்ட கடவுச்சொல் அழிக்கப்படும். அடுத்த அமுக்கத்தில் மீண்டும் உள்ளிட வேண்டியிருக்கும். தொடரவா?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">சேமிக்கப்பட்ட கடவுச்சொல்லை மீட்டெடுக்க முடியவில்லை (வேறு கணினியிலிருந்து அமைப்புகளை நகலெடுத்தது அல்லது Windows கடவுச்சொல் மீட்டமைப்பு காரணமாக இருக்கலாம்). கடவுச்சொல்லை மீண்டும் அமைக்கவும்.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">சேமிக்கப்பட்ட கடவுச்சொல்லில் ZIP வடிவத்தில் பயன்படுத்த முடியாத எழுத்துகள் உள்ளன (ASCII மட்டும்). இந்தச் சுருக்கத்திற்கான கடவுச்சொல்லை உள்ளிடவும் (சேமிக்கப்பட்ட கடவுச்சொல் மாற்றப்படாது).</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">அணுக முடியாததால் {0} கோப்புகள் தவிர்க்கப்பட்டன. மீதமுள்ள கோப்புகளுடன் கடவுச்சொல்லால் பாதுகாக்கப்பட்ட காப்பகம் உருவாக்கப்பட்டது.</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">அனைத்து மூல கோப்புகளும் அணுக முடியாதவை, எனவே அமுக்கம் இரத்து செய்யப்பட்டது. வெற்று காப்பகம் உருவாக்கப்படவில்லை.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">{0} வடிவம் கடவுச்சொல் பாதுகாப்பை ஆதரிக்காது. ZIP அல்லது 7z-ஐ தேர்வுசெய்க.</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">ZIP கடவுச்சொற்களில் ASCII எழுத்துகள் (லத்தீன் எழுத்துகள், எண்கள், குறியீடுகள்) மட்டுமே இருக்க முடியும். தமிழ் போன்ற பிற எழுத்துகளைப் பயன்படுத்த 7z வடிவத்தைத் தேர்ந்தெடுக்கவும்.</x:String>
</ResourceDictionary>

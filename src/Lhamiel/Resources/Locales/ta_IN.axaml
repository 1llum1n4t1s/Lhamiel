  <!-- Error Recovery Dialog -->
  <x:String x:Key="Text.ErrorRecovery.ErrorInfo" xml:space="preserve">பிழைத் தகவல்</x:String>
  <x:String x:Key="Text.ErrorRecovery.ProblematicFile" xml:space="preserve">சிக்கலான கோப்பு</x:String>
  <x:String x:Key="Text.ErrorRecovery.RecoveryOptions" xml:space="preserve">மீட்பு விருப்பங்கள்</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAndContinue" xml:space="preserve">இந்தக் கோப்பைத் தவிர்த்துத் தொடரவும்</x:String>
  <x:String x:Key="Text.ErrorRecovery.Retry" xml:space="preserve">மீண்டும் முயற்சி</x:String>
  <x:String x:Key="Text.ErrorRecovery.StopExtraction" xml:space="preserve">பிரித்தெடுத்தலை நிறுத்து</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAllErrors" xml:space="preserve">அடுத்தடுத்த அனைத்துப் பிழைகளையும் தவிர்</x:String>
  <x:String x:Key="Text.ErrorRecovery.RememberChoice" xml:space="preserve">இந்தத் தேர்வை நினைவில் கொள்</x:String>

  <!-- Overwrite Dialog -->
  <x:String x:Key="Text.Overwrite.FolderMessage" xml:space="preserve">'{0}' கோப்புறை ஏற்கனவே உள்ளது.\n\nஏற்கனவே உள்ள கோப்புறையை நீக்கி மேலெழுதவா?</x:String>
  <x:String x:Key="Text.Overwrite.FileMessage" xml:space="preserve">'{0}' கோப்பு ஏற்கனவே உள்ளது.\n\nஅதை மாற்றவா?</x:String>
  <x:String x:Key="Text.Overwrite.FolderTitle" xml:space="preserve">கோப்புறை மேலெழுதலை உறுதிப்படுத்து</x:String>
  <x:String x:Key="Text.Overwrite.FileTitle" xml:space="preserve">கோப்பை மாற்றவும்</x:String>
  <x:String x:Key="Text.Overwrite.DefaultMessage" xml:space="preserve">கோப்பு ஏற்கனவே உள்ளது.\n\nஅதை மாற்றவா?</x:String>


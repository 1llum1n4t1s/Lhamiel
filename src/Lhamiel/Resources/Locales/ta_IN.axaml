  <x:String x:Key="Text.CompressionLevel.Maximum" xml:space="preserve">அதிகபட்ச</x:String>
  <x:String x:Key="Text.CompressionLevel.Ultra" xml:space="preserve">உச்ச</x:String>

  <!-- Association Settings -->
  <x:String x:Key="Text.Settings.Association.SelectAll" xml:space="preserve">அனைத்தையும் தேர்</x:String>
  <x:String x:Key="Text.Settings.Association.DeselectAll" xml:space="preserve">அனைத்தையும் நீக்கு</x:String>

  <!-- Version Tab -->
  <x:String x:Key="Text.Version.AppName" xml:space="preserve">Lhamiel</x:String>
  <x:String x:Key="Text.Version.Description" xml:space="preserve">காப்பக சுருக்கம் &amp; பிரித்தெடுத்தல் கருவி</x:String>
  <x:String x:Key="Text.Version.Label" xml:space="preserve">பதிப்பு</x:String>
  <x:String x:Key="Text.Version.SevenZipLabel" xml:space="preserve">7-Zip</x:String>
  <x:String x:Key="Text.Version.CheckUpdate" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்</x:String>
  <x:String x:Key="Text.Version.Copyright" xml:space="preserve">பதிப்புரிமை</x:String>
  <x:String x:Key="Text.Version.License" xml:space="preserve">உரிமம்</x:String>
  <x:String x:Key="Text.Version.Feedback.Description" xml:space="preserve">உங்கள் கருத்துகளையும் ஆலோசனைகளையும் எங்களுக்கு அனுப்புங்கள்</x:String>
  <x:String x:Key="Text.Version.Feedback.Button" xml:space="preserve">கருத்து அனுப்பு (GitHub)</x:String>
  <x:String x:Key="Text.Version.Feedback.Confirm" xml:space="preserve">GitHub Issues பக்கத்தை உலாவியில் திறக்கவா?</x:String>
  <x:String x:Key="Text.Version.Feedback.ConfirmTitle" xml:space="preserve">உறுதிப்படுத்தல்</x:String>

  <!-- Buttons -->
  <x:String x:Key="Text.Button.Save" xml:space="preserve">சேமி</x:String>
  <x:String x:Key="Text.Button.Cancel" xml:space="preserve">ரத்துசெய்</x:String>
  <x:String x:Key="Text.Button.OK" xml:space="preserve">சரி</x:String>
  <x:String x:Key="Text.Button.Yes" xml:space="preserve">ஆம்</x:String>
  <x:String x:Key="Text.Button.No" xml:space="preserve">இல்லை</x:String>

  <!-- Progress Window -->
  <x:String x:Key="Text.Progress.Processing" xml:space="preserve">செயலாக்கம்</x:String>
  <x:String x:Key="Text.Progress.Cancelled" xml:space="preserve">ரத்துசெய்யப்பட்டது.</x:String>
  <x:String x:Key="Text.Progress.PreparingFiles" xml:space="preserve">கோப்புகள் தயாராகின்றன...</x:String>
  <x:String x:Key="Text.Progress.MovingFiles" xml:space="preserve">கோப்புகள் நகர்த்தப்படுகின்றன...</x:String>
  <x:String x:Key="Text.Progress.Extracting" xml:space="preserve">பிரித்தெடுத்தல்</x:String>
  <x:String x:Key="Text.Progress.Compressing" xml:space="preserve">சுருக்குதல்</x:String>
  <x:String x:Key="Text.Progress.VerifyingIntegrity" xml:space="preserve">ஒருமைப்பாடு சரிபார்ப்பு...</x:String>
  <x:String x:Key="Text.Progress.ApplyingSecurityMark" xml:space="preserve">பாதுகாப்பு அடையாளம் செலுத்துகிறது...</x:String>

  <!-- Error Recovery Dialog -->
  <x:String x:Key="Text.ErrorRecovery.ErrorInfo" xml:space="preserve">பிழைத் தகவல்</x:String>
  <x:String x:Key="Text.ErrorRecovery.ProblematicFile" xml:space="preserve">சிக்கலான கோப்பு</x:String>
  <x:String x:Key="Text.ErrorRecovery.RecoveryOptions" xml:space="preserve">மீட்பு விருப்பங்கள்</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAndContinue" xml:space="preserve">இந்தக் கோப்பைத் தவிர்த்துத் தொடரவும்</x:String>
  <x:String x:Key="Text.ErrorRecovery.Retry" xml:space="preserve">மீண்டும் முயற்சி</x:String>
  <x:String x:Key="Text.ErrorRecovery.StopExtraction" xml:space="preserve">பிரித்தெடுத்தலை நிறுத்து</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAllErrors" xml:space="preserve">அடுத்தடுத்த அனைத்துப் பிழைகளையும் தவிர்</x:String>
  <x:String x:Key="Text.ErrorRecovery.RememberChoice" xml:space="preserve">இந்தத் தேர்வை நினைவில் கொள்</x:String>

  <!-- Overwrite Dialog -->
  <x:String x:Key="Text.Overwrite.FolderMessage" xml:space="preserve">'{0}' கோப்புறை ஏற்கனவே உள்ளது.\n\nஏற்கனவே உள்ள கோப்புறையை நீக்கி மேலெழுதவா?</x:String>
  <x:String x:Key="Text.Overwrite.FileMessage" xml:space="preserve">'{0}' கோப்பு ஏற்கனவே உள்ளது.\n\nஅதை மாற்றவா?</x:String>
  <x:String x:Key="Text.Overwrite.FolderTitle" xml:space="preserve">கோப்புறை மேலெழுதலை உறுதிப்படுத்து</x:String>
  <x:String x:Key="Text.Overwrite.FileTitle" xml:space="preserve">கோப்பை மாற்றவும்</x:String>
  <x:String x:Key="Text.Overwrite.DefaultMessage" xml:space="preserve">கோப்பு ஏற்கனவே உள்ளது.\n\nஅதை மாற்றவா?</x:String>


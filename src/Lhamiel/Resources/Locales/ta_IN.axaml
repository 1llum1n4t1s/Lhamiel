  <x:String x:Key="Text.Sidebar.Extraction" xml:space="preserve">📂 பிரித்தல்</x:String>
  <x:String x:Key="Text.Sidebar.Compression" xml:space="preserve">📦 சுருக்கம்</x:String>
  <x:String x:Key="Text.Sidebar.Association" xml:space="preserve">🔗 இணைப்பு</x:String>
  <x:String x:Key="Text.Sidebar.Version" xml:space="preserve">ℹ️ பதிப்பு</x:String>

  <!-- General Settings -->
  <x:String x:Key="Text.Settings.Theme.Header" xml:space="preserve">தீம்</x:String>
  <x:String x:Key="Text.Settings.Theme.Tooltip" xml:space="preserve">பயன்பாட்டின் தீமை மாற்றவும்</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">அமைப்பு (OS ஐ பின்பற்று)</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">இருண்ட</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">ஒளிர்</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">இயல்புநிலை சுருக்க வடிவம்</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Header" xml:space="preserve">குறுக்குவழி</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Create" xml:space="preserve">📌 டெஸ்க்டாப் குறுக்குவழியை உருவாக்கு</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">மொழி</x:String>

  <!-- Output Settings (shared) -->
  <x:String x:Key="Text.Settings.Output.Header" xml:space="preserve">வெளியீட்டு அடைவு</x:String>
  <x:String x:Key="Text.Settings.Output.SameDirectory" xml:space="preserve">மூலக் கோப்பின் அதே அடைவில் வெளியிடு</x:String>
  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">ஒரு அடைவைக் குறிப்பிடு</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">உலாவு...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">பிரித்தெடுக்கும் கோப்புறையைத் தேர்ந்தெடுக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseCompression" xml:space="preserve">சுருக்கக் கோப்புறையைத் தேர்ந்தெடுக்கவும்</x:String>

  <!-- Extraction Settings -->
  <x:String x:Key="Text.Settings.Extraction.OpenFolder" xml:space="preserve">பிரித்தெடுத்த பின் இலக்கு கோப்புறையைத் திற</x:String>
  <x:String x:Key="Text.Settings.Extraction.OptionHeader" xml:space="preserve">பிரித்தெடுக்கும் விருப்பங்கள்</x:String>
  <x:String x:Key="Text.Settings.Extraction.CreateFolder" xml:space="preserve">காப்பக பெயருடன் கோப்புறையை உருவாக்கவும்</x:String>

  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">சுருக்கிய பின் இலக்கு கோப்புறையைத் திற</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">ஒருங்கிணைந்த சுருக்கம்</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">சுருக்க விருப்பங்கள்</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">பல கோப்புகளை ஒரே காப்பகமாக சுருக்கு</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">முடக்கப்பட்டால், ஒவ்வொரு கோப்பும் தனித்தனி காப்பகமாக சுருக்கப்படும்</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">சுருக்கும்போது ரூட் கோப்பகத்தை சேர்க்கவும்</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">சுருக்கும்போது ரூட் கோப்பகத்தை நீக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">சுருக்கும்போது கோப்பகங்களை நீக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">சுருக்க நிலை</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">ZIP சுருக்க நிலை</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">7z சுருக்க நிலை</x:String>

  <!-- Compression Level Names -->

  <x:String x:Key="Text.CompressionLevel.Fast" xml:space="preserve">வேகமான</x:String>
  <x:String x:Key="Text.CompressionLevel.Normal" xml:space="preserve">சாதாரண</x:String>
  <x:String x:Key="Text.CompressionLevel.Maximum" xml:space="preserve">அதிகபட்ச</x:String>
  <x:String x:Key="Text.CompressionLevel.Ultra" xml:space="preserve">உச்ச</x:String>


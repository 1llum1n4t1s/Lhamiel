  <x:String x:Key="Text.Settings.ContextMenu.Enable" xml:space="preserve">Afficher « Lhamielへ » dans le menu contextuel des fichiers et dossiers</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">Langue</x:String>


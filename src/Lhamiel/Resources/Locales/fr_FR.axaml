  <x:String x:Key="Text.ErrorHandler.DiskFull" xml:space="preserve">Espace disque insuffisant</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullDetail" xml:space="preserve">Le disque de destination n'a pas assez d'espace : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullAction" xml:space="preserve">Libérez de l'espace disque ou extrayez sur un autre disque.</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUse" xml:space="preserve">Fichier en cours d'utilisation</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseDetail" xml:space="preserve">Le fichier est utilisé par une autre application : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseAction" xml:space="preserve">Fermez l'application utilisant le fichier et réessayez.</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnected" xml:space="preserve">Le périphérique ne répond pas</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedDetail" xml:space="preserve">Le périphérique externe (USB / NAS / support amovible) a été déconnecté ou ne répond pas : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedAction" xml:space="preserve">Vérifiez la connexion du périphérique et reconnectez-le avant de réessayer.</x:String>
  <x:String x:Key="Text.ErrorHandler.IOError" xml:space="preserve">Une erreur d'E/S est survenue</x:String>
  <x:String x:Key="Text.ErrorHandler.IOErrorAction" xml:space="preserve">Vérifiez l'état du fichier et réessayez.</x:String>
  <x:String x:Key="Text.ErrorHandler.ResourceLimit" xml:space="preserve">L'archive dépasse une limite de sécurité de traitement</x:String>
  <x:String x:Key="Text.ErrorHandler.ResourceLimitAction" xml:space="preserve">Scindez l'archive ou réessayez avec des fichiers plus petits.</x:String>
  <x:String x:Key="Text.ErrorHandler.Corrupted" xml:space="preserve">Le fichier d'archive est corrompu</x:String>
  <x:String x:Key="Text.ErrorHandler.CorruptedAction" xml:space="preserve">Essayez de retélécharger ou de réparer le fichier.</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperation" xml:space="preserve">Une opération non valide a été effectuée</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperationAction" xml:space="preserve">Vérifiez l'opération et réessayez.</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormat" xml:space="preserve">Format de fichier non pris en charge</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatDetail" xml:space="preserve">Ce format de fichier n'est pas pris en charge : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatAction" xml:space="preserve">Utilisez un format pris en charge (ZIP, 7Z, RAR, etc.).</x:String>
  <x:String x:Key="Text.ErrorHandler.Unexpected" xml:space="preserve">Une erreur inattendue est survenue</x:String>
  <x:String x:Key="Text.ErrorHandler.UnexpectedAction" xml:space="preserve">Consultez les détails de l'erreur et contactez le support si nécessaire.</x:String>
  <x:String x:Key="Text.ErrorHandler.ArchiveFile" xml:space="preserve">Fichier d'archive : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.ErrorMessage" xml:space="preserve">Message d'erreur : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileSize" xml:space="preserve">Taille du fichier : {0:N0} octets</x:String>
  <x:String x:Key="Text.ErrorHandler.LastModified" xml:space="preserve">Dernière modification : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInfoFailed" xml:space="preserve">Échec de la récupération des informations du fichier</x:String>

  <!-- Partial Extraction -->

  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">Emplacement actuel {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">Destination {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">Espace disque insuffisant</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">Espace requis :</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">Espace disponible :</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">Manquant :</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">Lecteur : {0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">Espace disque insuffisant. Supprimez les fichiers inutiles puis cliquez sur Réessayer.</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">Réessayer</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">Annuler</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">En cas de fichiers en double, un dialogue de confirmation apparaîtra après l'extraction</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} conflits de fichiers</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">Sélectionnez les fichiers à inclure dans l'archive. En cas de sélection multiple, des numéros seront ajoutés aux noms.</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">Quels fichiers souhaitez-vous conserver ?</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">Ignorer {0} fichiers ayant la même date et taille</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">Continuer</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">Annuler</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">Tout remplacer</x:String>
  <x:String x:Key="Text.Overwrite.ConfirmTitle" xml:space="preserve">Confirmer le remplacement</x:String>
  <x:String x:Key="Text.Overwrite.Header" xml:space="preserve">Un fichier du même nom existe déjà</x:String>
  <x:String x:Key="Text.Overwrite.Description" xml:space="preserve">Si vous remplacez, le fichier existant sera remplacé par la nouvelle archive.</x:String>
  <x:String x:Key="Text.Overwrite.Location" xml:space="preserve">Destination : {0}</x:String>
  <x:String x:Key="Text.Overwrite.Existing" xml:space="preserve">Fichier existant</x:String>
  <x:String x:Key="Text.Overwrite.New" xml:space="preserve">Nouveau contenu à compresser</x:String>
  <x:String x:Key="Text.Overwrite.Modified" xml:space="preserve">Modifié le : {0}</x:String>
  <x:String x:Key="Text.Overwrite.Size" xml:space="preserve">Taille : {0}</x:String>
  <x:String x:Key="Text.Overwrite.SourceTotal" xml:space="preserve">Total avant compression : {0} ({1} fichiers, avant application des exclusions)</x:String>
  <x:String x:Key="Text.Overwrite.Calculating" xml:space="preserve">Calcul du total avant compression…</x:String>
  <x:String x:Key="Text.Overwrite.CalculationFailed" xml:space="preserve">Impossible d'obtenir le total avant compression</x:String>
  <x:String x:Key="Text.Overwrite.SourceMore" xml:space="preserve">{0} autres</x:String>
  <x:String x:Key="Text.Overwrite.Overwrite" xml:space="preserve">Remplacer</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">Inconnu</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">Impossible de charger les informations de licence.</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">Annulé en raison d'un espace disque insuffisant.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">L'utilisateur a annulé l'extraction.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">Fichier archive introuvable : {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">Une erreur s'est produite lors de la préparation de la destination. Le fichier est peut-être en cours d'utilisation ou vous n'avez pas les droits de suppression.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">Impossible de déplacer le contenu vers la destination. Le contenu original reste à l'emplacement de sauvegarde.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">Aucun fichier spécifié pour la compression.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">Le chemin spécifié est introuvable : {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">Échec de l'enregistrement des paramètres : {0}</x:String>
  <x:String x:Key="Text.Error.SaveAbortedStartupUnreadable" xml:space="preserve">settings.json n'a pas pu être lu au démarrage ; l'enregistrement a été annulé pour protéger vos paramètres existants. Veuillez redémarrer l'application</x:String>
  <x:String x:Key="Text.Error.SaveAbortedFileUnreadable" xml:space="preserve">settings.json est actuellement illisible (une autre application l'a peut-être ouvert) ; l'enregistrement a été annulé pour protéger vos paramètres existants</x:String>
  <x:String x:Key="Text.Error.SettingsUnreadableStartup" xml:space="preserve">Lhamiel n'a pas pu lire settings.json et a démarré avec les paramètres par défaut. Les modifications de cette session ne seront pas enregistrées. Le mot de passe de compression enregistré et la protection par mot de passe n'ont pas pu être lus non plus ; les archives risquent donc d'être créées sans protection par mot de passe. Vérifiez qu'aucun autre Lhamiel ou aucune autre application n'a ouvert settings.json, puis redémarrez Lhamiel.</x:String>
  <x:String x:Key="Text.Error.SettingsUnreadableExternalChange" xml:space="preserve">settings.json n'ayant pas pu être lu, cette modification (menu contextuel, associations de fichiers, icônes ou raccourcis) ne peut pas être appliquée. Veuillez redémarrer l'application.</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">Fichier extrait introuvable.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">La validation du chemin a échoué : {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' est protégé par le système et ne peut pas être écrasé. Veuillez choisir un autre emplacement.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">Compression en cours...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">L'archive contient une entrée non sécurisée pointant à l'extérieur du répertoire cible : {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">Mot de passe requis</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">Cette archive est protégée par mot de passe. Veuillez saisir le mot de passe pour l'extraire.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">Mot de passe</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">Le mot de passe précédent était incorrect. Veuillez réessayer.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">Mot de passe requis ou incorrect</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">Cette archive est protégée par mot de passe. Aucun mot de passe n'a été fourni ou le mot de passe ne correspond pas : {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">Réessayez l'extraction et saisissez le bon mot de passe.</x:String>

  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">Protection par mot de passe</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">Protéger par mot de passe</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">Chiffrement AES-256 (WinZip AE-2) pour ZIP, AES-256 pour 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.UnsupportedEncryptionNote" xml:space="preserve">TAR et LZH ne prennent pas en charge la protection par mot de passe. Choisissez ZIP ou 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">Remarque : les fichiers ZIP chiffrés en AES-256 ne peuvent pas être ouverts par l'Explorateur Windows intégré. Les destinataires ont besoin de 7-Zip, WinRAR ou d'un autre outil compatible.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">Chiffrer aussi les noms de fichiers</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">Chiffre la liste des noms de fichiers (en-tête) dans l'archive. Sans le mot de passe, même le contenu ne peut pas être parcouru.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">Le format ZIP ne permet pas de chiffrer les noms de fichiers (répertoire central). Passez à 7z pour activer cette option.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">Mode de saisie du mot de passe</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">Demander à chaque dépôt</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">Enregistrer et réutiliser (chiffré avec DPAPI)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">Mot de passe : défini</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">Mot de passe : non défini (il vous sera demandé à la prochaine compression)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">Modifier le mot de passe</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">Effacer le mot de passe</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">Définir un mot de passe</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">Définissez un mot de passe pour chiffrer l'archive. Saisissez-le deux fois pour confirmation.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">Mot de passe (confirmation)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">Les mots de passe ne correspondent pas. Veuillez ressaisir la confirmation.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">Veuillez saisir un mot de passe.</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">Le mot de passe doit comporter au moins 4 caractères.</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">Supprimer le mot de passe enregistré ?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">Passer à « Demander à chaque dépôt » supprimera le mot de passe actuellement enregistré. Continuer ?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">Supprimer le mot de passe enregistré ?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">Le mot de passe enregistré sera supprimé. Il vous sera redemandé à la prochaine compression. Continuer ?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">Impossible de restaurer le mot de passe enregistré (probablement dû à la copie des paramètres depuis un autre PC ou à une réinitialisation du mot de passe Windows). Veuillez définir à nouveau le mot de passe.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">Le mot de passe enregistré contient des caractères inutilisables au format ZIP (ASCII uniquement). Saisissez un mot de passe pour cette compression (le mot de passe enregistré ne sera pas modifié).</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">Le mot de passe enregistré est trop court pour être utilisé (au moins {0} caractères sont requis). Veuillez définir un nouveau mot de passe.</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} fichier(s) ont été ignorés car inaccessibles. Une archive protégée par mot de passe a été créée avec les fichiers restants.</x:String>
  <x:String x:Key="Text.Notify.NothingToCompress" xml:space="preserve">Aucun fichier à compresser ne restait, aucune archive n'a donc été créée.</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">Tous les fichiers sources étaient inaccessibles ; la compression a donc été abandonnée. Aucune archive vide n'a été créée.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">Le format {0} ne prend pas en charge la protection par mot de passe. Choisissez ZIP ou 7z.</x:String>
  <x:String x:Key="Text.Error.LzhEntryTooLarge" xml:space="preserve">LZH prend en charge jusqu'à {1} Mio par fichier. Fichier dépassant la limite : {0}</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">Les mots de passe ZIP ne peuvent contenir que des caractères ASCII (lettres, chiffres et symboles). Pour utiliser d'autres caractères (lettres accentuées, japonais, etc.), choisissez le format 7z.</x:String>
</ResourceDictionary>

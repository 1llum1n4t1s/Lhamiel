  <x:String x:Key="Text.Settings.AppIcon.Crystal" xml:space="preserve">Cristal pastel</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">Format de compression par défaut</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Header" xml:space="preserve">Raccourci</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Create" xml:space="preserve">📌 Créer un raccourci sur le bureau</x:String>

  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">Spécifier un répertoire</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">Parcourir...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">Sélectionner le dossier d'extraction</x:String>

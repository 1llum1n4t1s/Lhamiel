  <x:String x:Key="Text.Settings.Extraction.CreateFolder" xml:space="preserve">Creer un dossier avec le nom de l archive</x:String>

  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">Ouvrir le dossier de destination après la compression</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">Compression fusionnée</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">Options de compression</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">Compresser plusieurs fichiers en une seule archive</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">Lorsque désactivé, chaque fichier sera compressé dans une archive séparée</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">Inclure le répertoire racine lors de la compression</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">Exclure le répertoire racine lors de la compression</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">Exclure tous les répertoires lors de la compression</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">Niveau de compression</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">Niveau de compression ZIP</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">Niveau de compression 7z</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystem" xml:space="preserve">Inclure les fichiers et dossiers cachés/système</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystemDescription" xml:space="preserve">Les éléments avec les attributs Hidden ou System sont aussi ajoutés aux archives.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Header" xml:space="preserve">Exclusions de compression</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Description" xml:space="preserve">Les paramètres de cette page s'appliquent à toutes les compressions effectuées par Lhamiel pour cet utilisateur Windows. Définissez les exclusions propres à une source dans les fichiers de règles de chaque dossier.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Header" xml:space="preserve">Règles d'exclusion communes</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Description" xml:space="preserve">Les motifs enregistrés ici s'appliquent à toutes les sources de compression. La syntaxe compatible .gitignore est prise en charge.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Path" xml:space="preserve">Emplacement : %LocalAppData%\Lhamiel\.lhaignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Placeholder" xml:space="preserve">ex. *.log ou node_modules/</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Add" xml:space="preserve">Ajouter</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Remove" xml:space="preserve">Supprimer</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Reset" xml:space="preserve">Réinitialiser les règles communes</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile" xml:space="preserve">Ouvrir le fichier d'exclusion commun</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile.Tip" xml:space="preserve">Ouvre le fichier .lhaignore qui contient les règles communes dans l'éditeur de texte par défaut</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Header" xml:space="preserve">Charger les règles propres aux dossiers</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Description" xml:space="preserve">Recherche les fichiers de règles dans les dossiers sources et applique chaque fichier sous son dossier. Cette stratégie de chargement est commune à toutes les compressions.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore" xml:space="preserve">Utiliser les règles d'exclusion des dossiers sources</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore.Tip" xml:space="preserve">Recherche un fichier candidat dans chaque dossier et applique les règles sélectionnées sous ce dossier</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Label" xml:space="preserve">Noms de fichiers reconnus (priorité la plus haute en premier)</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Placeholder" xml:space="preserve">ex. .lhamielignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Tip" xml:space="preserve">Saisissez un nom de fichier par ligne. Les sous-dossiers conservent le candidat hérité ou passent à un candidat plus prioritaire, sans jamais revenir à une priorité inférieure.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Invalid" xml:space="preserve">Saisissez un nom de fichier simple par ligne. Les chemins, jokers et noms réservés sont interdits.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Notice" xml:space="preserve">Cette liste de noms est un paramètre global de Lhamiel. Elle indique les fichiers à rechercher, pas les règles d'exclusion elles-mêmes.</x:String>


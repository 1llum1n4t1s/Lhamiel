  <x:String x:Key="Text.Settings.Shortcut.CreateExtraction" xml:space="preserve">Gumawa ng Extraction Shortcut</x:String>
  <x:String x:Key="Text.Settings.Shortcut.CreateCompression" xml:space="preserve">Gumawa ng Compression Shortcut</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Header" xml:space="preserve">Context Menu</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.EnableExtraction" xml:space="preserve">Ipakita ang “I-extract gamit ang Lhamiel”</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.EnableCompression" xml:space="preserve">Ipakita ang “I-compress gamit ang Lhamiel”</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">Wika</x:String>

  <!-- Output Settings (shared) -->
  <x:String x:Key="Text.Settings.Output.Header" xml:space="preserve">Output na Direktoryo</x:String>
  <x:String x:Key="Text.Settings.Output.SameDirectory" xml:space="preserve">I-output sa parehong direktoryo ng source file</x:String>
  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">Tumukoy ng direktoryo</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">Mag-browse...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">Pumili ng folder para sa extraction</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseCompression" xml:space="preserve">Pumili ng folder para sa compression</x:String>

  <!-- Extraction Settings -->
  <x:String x:Key="Text.Settings.Extraction.OpenFolder" xml:space="preserve">Buksan ang destinasyon na folder pagkatapos mag-extract</x:String>
  <x:String x:Key="Text.Settings.Extraction.OptionHeader" xml:space="preserve">Mga Opsyon sa Extraction</x:String>
  <x:String x:Key="Text.Settings.Extraction.CreateFolder" xml:space="preserve">Gumawa ng folder gamit ang pangalan ng archive</x:String>

  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">Buksan ang destinasyon na folder pagkatapos mag-compress</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">Pagsasamang Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">Mga Opsyon sa Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">I-compress ang maraming file sa isang archive</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">Kapag OFF, bawat file ay i-co-compress sa magkahiwalay na archive</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">Isama ang root directory kapag nagko-compress</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">Huwag isama ang root directory kapag nagko-compress</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">Huwag isama ang mga directory kapag nagko-compress</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">Antas ng Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">Antas ng ZIP Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">Antas ng 7z Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystem" xml:space="preserve">Isama ang hidden/System na file at folder</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystemDescription" xml:space="preserve">Isinasama rin sa archive ang mga entry na may Hidden o System attribute.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Header" xml:space="preserve">Mga Hindi Isasama sa Compression</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Description" xml:space="preserve">Nalalapat ang mga setting sa pahinang ito sa lahat ng compression ng Lhamiel para sa Windows user na ito. Ilagay ang source-specific na exclusions sa rule files sa bawat source folder.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Header" xml:space="preserve">Mga shared exclusion rule</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Description" xml:space="preserve">Nalalapat sa lahat ng compression source ang mga pattern dito. Sinusuportahan ang .gitignore-compatible syntax.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Global.Path" xml:space="preserve">Naka-save sa: %LocalAppData%\Lhamiel\.lhaignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Placeholder" xml:space="preserve">hal. *.log o node_modules/</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Add" xml:space="preserve">Idagdag</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Remove" xml:space="preserve">Alisin</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Reset" xml:space="preserve">I-reset ang shared rules</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile" xml:space="preserve">Buksan ang shared exclusion file</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile.Tip" xml:space="preserve">Binubuksan ang .lhaignore na naglalaman ng shared rules sa default na text editor</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Header" xml:space="preserve">I-load ang folder-specific rules</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Folder.Description" xml:space="preserve">Naghahanap ng exclusion rule files sa source folders at inilalapat ang bawat file sa ilalim ng folder nito. Ang loading policy na ito ay para sa lahat ng compression.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore" xml:space="preserve">Gamitin ang exclusion rules mula sa source folders</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore.Tip" xml:space="preserve">Naghahanap ng candidate file sa bawat folder at inilalapat ang napiling rules sa ilalim nito</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Label" xml:space="preserve">Mga kinikilalang file name (pinakamataas ang nasa itaas)</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Placeholder" xml:space="preserve">hal. .lhamielignore</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Tip" xml:space="preserve">Maglagay ng isang file name bawat linya. Pinapanatili ng mga child folder ang minanang candidate o lumilipat sa mas mataas ang priority; hindi sila bumabalik sa mas mababang priority.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Invalid" xml:space="preserve">Maglagay ng simpleng file name bawat linya. Hindi pinapayagan ang path, wildcard, at reserved name.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.SourceFileNames.Notice" xml:space="preserve">Global na setting ng Lhamiel ang listahang ito. Tinutukoy nito ang mga file na hahanapin, hindi ang exclusion rules mismo.</x:String>


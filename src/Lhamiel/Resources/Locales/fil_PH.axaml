  <x:String x:Key="Text.Settings.AppIcon.Description" xml:space="preserve">Piliin ang icon na ipinapakita sa mga window at shortcut.</x:String>
  <x:String x:Key="Text.Settings.AppIcon.Classic" xml:space="preserve">Classic</x:String>
  <x:String x:Key="Text.Settings.AppIcon.Crystal" xml:space="preserve">Pastel crystal</x:String>
  <x:String x:Key="Text.Settings.AppIcon.Legacy" xml:space="preserve">Legacy</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">Default na Format ng Compression</x:String>

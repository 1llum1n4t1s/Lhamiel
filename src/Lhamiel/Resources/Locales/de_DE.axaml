  <x:String x:Key="Text.Extraction.ReExtracting" xml:space="preserve">Erneutes Entpacken: {0}</x:String>
  <x:String x:Key="Text.Extraction.FileNotInArchive" xml:space="preserve">Zieldatei im Archiv nicht gefunden.</x:String>
  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">Datei: {0}\nFehler: {1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">Sie können erneut versuchen oder überspringen.</x:String>


  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">Zielort {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">Unzureichender Speicherplatz</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">Erforderlich:</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">Verfügbar:</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">Fehlend:</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">Laufwerk: {0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">Nicht genügend Speicherplatz. Bitte löschen Sie unnötige Dateien und klicken Sie auf Wiederholen.</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">Wiederholen</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">Abbrechen</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">Bei doppelten Dateien wird nach der Extraktion ein Bestätigungsdialog angezeigt</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} Dateikonflikte</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">Wählen Sie die Dateien aus, die ins Archiv aufgenommen werden sollen. Bei Mehrfachauswahl werden Nummern an die Dateinamen angehängt.</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">Welche Dateien möchten Sie behalten?</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">{0} Dateien mit gleichem Datum und Größe überspringen</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">Fortfahren</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">Abbrechen</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">Alle überschreiben</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">Entpacken abgeschlossen: {0}/{1} Dateien erfolgreich</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">Unbekannt</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">Lizenzinformationen konnten nicht geladen werden.</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">Abgebrochen wegen unzureichendem Speicherplatz.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">Der Benutzer hat die Entpackung abgebrochen.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">Archivdatei nicht gefunden: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">Beim Vorbereiten des Ziels ist ein Fehler aufgetreten. Die Datei wird möglicherweise verwendet oder Sie haben keine Löschberechtigung.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">Inhalte konnten nicht zum Ziel verschoben werden. Die Originalinhalte befinden sich noch am Sicherungsort.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">Keine Dateien zum Komprimieren angegeben.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">Der angegebene Pfad wurde nicht gefunden: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">Ein eindeutiger Dateiname konnte nicht generiert werden: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">Einstellungen konnten nicht gespeichert werden: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">Entpackte Datei nicht gefunden.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">Dateipfad ist leer.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">Pfad ist zu lang. Maximal {0} Zeichen erlaubt. (Aktuell: {1} Zeichen)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">Verzeichnispfad ist zu lang. Maximal {0} Zeichen erlaubt.</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">Dateiname ist zu lang. Maximal {0} Zeichen erlaubt.</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">Pfad konnte nicht analysiert werden: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">Pfad enthält ein ungültiges Zeichen: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">Dateiname enthält ein ungültiges Zeichen: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">Beim Überprüfen des Dateinamens ist ein Fehler aufgetreten: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">Ungültiges Pfadformat erkannt</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">Pfadvalidierung fehlgeschlagen: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">Reservierter Gerätename wird verwendet: {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' ist vom System geschützt und kann nicht überschrieben werden. Bitte wählen Sie einen anderen Speicherort.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">Komprimiere...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">Das Archiv enthält einen unsicheren Eintrag, der außerhalb des Zielverzeichnisses liegt: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">Passwort erforderlich</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">Dieses Archiv ist passwortgeschützt. Bitte geben Sie das Passwort ein, um es zu extrahieren.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">Passwort</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">Das vorherige Passwort war falsch. Bitte versuchen Sie es erneut.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">Passwort erforderlich oder falsch</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">Dieses Archiv ist passwortgeschützt. Es wurde entweder kein Passwort angegeben oder das Passwort stimmt nicht überein: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">Wiederholen Sie die Extraktion und geben Sie das richtige Passwort ein.</x:String>

  <!-- Passwortschutz (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">Passwortschutz</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">Mit Passwort schützen</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">Verschlüsselt ZIP mit AES-256 (WinZip AE-2) und 7z mit AES-256.</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR unterstützt keinen Passwortschutz. Wählen Sie ZIP oder 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">Hinweis: AES-256-verschlüsselte ZIPs können nicht mit dem in Windows integrierten Explorer geöffnet werden. Empfänger benötigen 7-Zip, WinRAR oder ein kompatibles Tool.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">Auch Dateinamen verschlüsseln</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">Verschlüsselt die Dateinamenliste (Header) im Archiv. Ohne Passwort kann nicht einmal der Inhalt eingesehen werden.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">Das ZIP-Format kann Dateinamen (Zentralverzeichnis) nicht verschlüsseln. Wechseln Sie zu 7z, um diese Option zu aktivieren.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">Eingabe des Passworts</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">Bei jedem Ablegen abfragen</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">Speichern und wiederverwenden (DPAPI-verschlüsselt)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">Passwort: gesetzt</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">Passwort: nicht gesetzt (wird beim nächsten Komprimieren abgefragt)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">Passwort ändern</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">Passwort löschen</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">Passwort festlegen</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">Legen Sie ein Passwort zur Verschlüsselung des Archivs fest. Geben Sie es zur Bestätigung zweimal ein.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">Passwort (Bestätigung)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">Passwörter stimmen nicht überein. Bitte erneut bestätigen.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">Bitte geben Sie ein Passwort ein.</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">Das Passwort muss mindestens 4 Zeichen lang sein.</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">Sie können aus einem Passwortmanager einfügen (Strg+V).</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">Gespeichertes Passwort löschen?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">Wenn Sie auf "Bei jedem Ablegen abfragen" wechseln, wird das aktuell gespeicherte Passwort gelöscht. Fortfahren?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">Gespeichertes Passwort löschen?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">Das gespeicherte Passwort wird gelöscht. Beim nächsten Komprimieren müssen Sie es erneut eingeben. Fortfahren?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">Das gespeicherte Passwort konnte nicht wiederhergestellt werden (möglicherweise durch Übernahme der Einstellungen von einem anderen PC oder Zurücksetzen des Windows-Passworts). Bitte legen Sie das Passwort erneut fest.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">Das gespeicherte Passwort enthält Zeichen, die im ZIP-Format nicht verwendet werden können (nur ASCII). Geben Sie ein Passwort für diese Komprimierung ein (das gespeicherte Passwort wird nicht geändert).</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">Das gespeicherte Passwort ist zu kurz und kann nicht verwendet werden (mindestens {0} Zeichen erforderlich). Bitte legen Sie ein neues Passwort fest.</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} Datei(en) wurden übersprungen, da sie nicht zugänglich waren. Mit den restlichen Dateien wurde ein passwortgeschütztes Archiv erstellt.</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">Alle Quelldateien waren nicht zugänglich, daher wurde die Komprimierung abgebrochen. Es wurde kein leeres Archiv erstellt.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">Das Format {0} unterstützt keinen Passwortschutz. Wählen Sie ZIP oder 7z.</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">ZIP-Passwörter dürfen nur ASCII-Zeichen enthalten (Buchstaben, Ziffern und Symbole). Für andere Zeichen (z. B. Umlaute oder japanische Zeichen) wählen Sie das 7z-Format.</x:String>
</ResourceDictionary>

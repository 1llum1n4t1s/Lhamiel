  <x:String x:Key="Text.ErrorHandler.FileSize" xml:space="preserve">檔案大小：{0:N0} 位元組</x:String>
  <x:String x:Key="Text.ErrorHandler.LastModified" xml:space="preserve">最後修改時間：{0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInfoFailed" xml:space="preserve">無法取得檔案資訊</x:String>

  <!-- Error Recovery File Info -->
  <x:String x:Key="Text.ErrorRecovery.FileName" xml:space="preserve">檔案名稱：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileSize" xml:space="preserve">大小：{0:N0} 位元組</x:String>
  <x:String x:Key="Text.ErrorRecovery.CreatedDate" xml:space="preserve">建立日期：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ModifiedDate" xml:space="preserve">修改日期：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.Attributes" xml:space="preserve">屬性：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.DiskInfo" xml:space="preserve">磁碟資訊：</x:String>
  <x:String x:Key="Text.ErrorRecovery.AvailableSpace" xml:space="preserve">可用空間：{0:N0} 位元組</x:String>
  <x:String x:Key="Text.ErrorRecovery.TotalSpace" xml:space="preserve">總容量：{0:N0} 位元組</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileInfoFailed" xml:space="preserve">無法取得檔案資訊：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionDetails" xml:space="preserve">例外狀況詳細資訊：</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionType" xml:space="preserve">類型：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionMessage" xml:space="preserve">訊息：{0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.InnerException" xml:space="preserve">內部例外狀況：{0}</x:String>

  <!-- Partial Extraction -->
  <x:String x:Key="Text.Extraction.Progress" xml:space="preserve">解壓縮中：{0}</x:String>
  <x:String x:Key="Text.Extraction.ReExtracting" xml:space="preserve">重新解壓縮中：{0}</x:String>
  <x:String x:Key="Text.Extraction.FileNotInArchive" xml:space="preserve">在壓縮檔中找不到目標檔案。</x:String>
  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">檔案：{0}\n錯誤：{1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">您可以選擇重試或略過。</x:String>

  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">目前位置 {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">目標位置 {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">磁碟空間不足</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">所需空間：</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">可用空間：</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">不足：</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">磁碟機：{0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">磁碟空間不足。請刪除不需要的檔案，然後按下重試。</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">重試</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">取消</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">如果存在重複檔案，解壓後將顯示確認對話方塊</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} 個檔案衝突</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">選擇要包含在壓縮檔中的檔案。如果選擇多個，將在檔名中加入編號。</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">您想保留哪些檔案？</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">跳過 {0} 個日期和大小相同的檔案</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">繼續</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">取消</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">全部覆寫</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">解壓完成：{0}/{1} 個檔案成功</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">未知</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">無法載入授權資訊。</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">因磁碟空間不足而取消。</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">使用者取消了解壓。</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">找不到壓縮檔：{0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">準備目標位置時發生錯誤。檔案可能正在使用中或您沒有刪除權限。</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">無法將內容移動到目標位置。原始內容仍保留在備份位置。</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">未指定要壓縮的檔案。</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">找不到指定的路徑：{0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">無法產生唯一的檔案名稱：{0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">儲存設定失敗：{0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">找不到已解壓的檔案。</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">檔案路徑為空。</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">路徑過長。最大允許 {0} 個字元。（目前：{1} 個字元）</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">目錄路徑過長。最大允許 {0} 個字元。</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">檔案名稱過長。最大允許 {0} 個字元。</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">無法解析路徑：{0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">路徑包含無效字元：'{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">檔案名稱包含無效字元：'{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">驗證檔案名稱時發生錯誤：{0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">偵測到無效的路徑格式</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">路徑驗證失敗：{0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">使用了保留的裝置名稱：{0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' 受到系統保護，無法覆寫。請選擇其他位置。</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">正在壓縮...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">壓縮檔包含指向解壓目標之外的不安全項目：{0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">需要密碼</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">此壓縮檔案受密碼保護。請輸入密碼以解壓縮。</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">密碼</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">先前輸入的密碼不正確，請重試。</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">需要密碼或密碼不正確</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">此壓縮檔案受密碼保護。未提供密碼或密碼不相符: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">請重新解壓縮並輸入正確的密碼。</x:String>

  <!-- 密碼保護 (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">密碼保護</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">使用密碼保護</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">ZIP 以 AES-256 (WinZip AE-2) 加密,7z 以 AES-256 加密。</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR 格式不支援密碼保護。請選擇 ZIP 或 7z。</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">注意:AES-256 加密的 ZIP 無法以 Windows 內建的檔案總管解壓縮。收件人需要 7-Zip、WinRAR 等相容工具。</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">同時加密檔名</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">同時加密壓縮檔內的檔名清單(標頭)。沒有密碼連內容也無法瀏覽。</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">ZIP 格式的規範不支援檔名(中央目錄)加密。切換為 7z 即可啟用此選項。</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">密碼輸入方式</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">每次拖放時確認</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">儲存並重複使用 (DPAPI 加密)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">密碼:已設定</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">密碼:未設定 (下次壓縮時會要求設定)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">變更密碼</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">刪除密碼</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">設定密碼</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">請設定用於加密壓縮檔的密碼。為了確認,請輸入兩次。</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">密碼 (確認)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">兩次輸入的密碼不一致,請重新輸入。</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">請輸入密碼。</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">密碼長度至少需 4 個字元。</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">可以從密碼管理工具貼上 (Ctrl+V)。</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">要刪除已儲存的密碼嗎?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">切換為「每次拖放時確認」將會刪除目前儲存的密碼。確定要繼續嗎?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">要刪除已儲存的密碼嗎?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">將刪除已儲存的密碼。下次壓縮時需要重新輸入。確定要繼續嗎?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">無法還原已儲存的密碼 (可能是從其他電腦複製設定或 Windows 密碼重設所致)。請重新設定密碼。</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">已儲存的密碼包含 ZIP 格式無法使用的字元（僅支援 ASCII）。請輸入本次壓縮使用的密碼（已儲存的密碼不會被變更）。</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">儲存的密碼太短，無法使用（至少需要 {0} 個字元）。請設定新密碼。</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} 個檔案因無法存取而被跳過。已使用其餘檔案建立了受密碼保護的壓縮檔。</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">所有來源檔案皆無法存取,已中止壓縮。未建立空的壓縮檔。</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">{0} 格式不支援密碼保護。請選擇 ZIP 或 7z。</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">ZIP 格式的密碼只能包含 ASCII 字元（字母、數字與符號）。如需使用中文等其他字元，請選擇 7z 格式。</x:String>
</ResourceDictionary>

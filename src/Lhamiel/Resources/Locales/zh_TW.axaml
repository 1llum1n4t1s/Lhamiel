  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">ZIP 壓縮等級</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">7z 壓縮等級</x:String>

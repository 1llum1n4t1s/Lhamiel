  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Check for updates failed!</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Download &amp; Install</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">Skip This Version</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">There are currently no updates available.</x:String>
  <x:String x:Key="Text.Settings.Update.Header" xml:space="preserve">Updates</x:String>
  <x:String x:Key="Text.Settings.Update.Check4UpdatesOnStartup" xml:space="preserve">Check for updates on startup</x:String>
  <x:String x:Key="Text.Settings.Version.SkippedVersion" xml:space="preserve">Skipping update notifications for {0}</x:String>
  <x:String x:Key="Text.Settings.Version.ClearSkippedVersion" xml:space="preserve">Clear skip</x:String>

  <!-- Error Handler -->
  <x:String x:Key="Text.ErrorHandler.FileNotFound" xml:space="preserve">Archive file not found</x:String>
  <x:String x:Key="Text.ErrorHandler.FileNotFoundDetail" xml:space="preserve">The specified file does not exist: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileNotFoundAction" xml:space="preserve">Please verify the file path and ensure the file exists.</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDenied" xml:space="preserve">Access denied</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDeniedDetail" xml:space="preserve">Access to the file or directory was denied: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.AccessDeniedAction" xml:space="preserve">Run as administrator or check the file permissions.</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFull" xml:space="preserve">Insufficient disk space</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullDetail" xml:space="preserve">The destination disk has insufficient space: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DiskFullAction" xml:space="preserve">Free up disk space or extract to a different disk.</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUse" xml:space="preserve">File is in use</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseDetail" xml:space="preserve">The file is being used by another application: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInUseAction" xml:space="preserve">Close the application using the file and retry.</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnected" xml:space="preserve">Device is not responding</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedDetail" xml:space="preserve">External device (USB / NAS / removable media) was disconnected or is not responding: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.DeviceDisconnectedAction" xml:space="preserve">Check the device connection and reconnect before retrying.</x:String>
  <x:String x:Key="Text.ErrorHandler.IOError" xml:space="preserve">An I/O error occurred</x:String>
  <x:String x:Key="Text.ErrorHandler.IOErrorAction" xml:space="preserve">Check the file status and retry.</x:String>
  <x:String x:Key="Text.ErrorHandler.Corrupted" xml:space="preserve">The archive file is corrupted</x:String>
  <x:String x:Key="Text.ErrorHandler.CorruptedAction" xml:space="preserve">Try re-downloading or repairing the file.</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperation" xml:space="preserve">An invalid operation was performed</x:String>
  <x:String x:Key="Text.ErrorHandler.InvalidOperationAction" xml:space="preserve">Verify the operation and retry.</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormat" xml:space="preserve">Unsupported file format</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatDetail" xml:space="preserve">This file format is not supported: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatAction" xml:space="preserve">Use a supported format (ZIP, 7Z, RAR, etc.).</x:String>
  <x:String x:Key="Text.ErrorHandler.Unexpected" xml:space="preserve">An unexpected error occurred</x:String>
  <x:String x:Key="Text.ErrorHandler.UnexpectedAction" xml:space="preserve">Review the error details and contact support if necessary.</x:String>
  <x:String x:Key="Text.ErrorHandler.ArchiveFile" xml:space="preserve">Archive file: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.ErrorMessage" xml:space="preserve">Error message: {0}</x:String>

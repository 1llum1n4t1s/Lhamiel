  <!-- Error Messages -->
  <x:String x:Key="Text.Error.FileNotFound" xml:space="preserve">The specified file was not found.\n{0}</x:String>
  <x:String x:Key="Text.Error.FolderNotFound" xml:space="preserve">The specified file or folder was not found.\n{0}</x:String>
  <x:String x:Key="Text.Error.UnsupportedFormat" xml:space="preserve">Unsupported file format.\n{0}</x:String>

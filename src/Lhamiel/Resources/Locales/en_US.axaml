<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - Archive Compression &amp; Extraction Tool</x:String>
  <x:String x:Key="Text.Progress.Title" xml:space="preserve">Processing...</x:String>
  <x:String x:Key="Text.Overwrite.Title" xml:space="preserve">Replace File</x:String>
  <x:String x:Key="Text.ErrorRecovery.Title" xml:space="preserve">Error Recovery Options</x:String>

  <!-- Drop Zone -->
  <x:String x:Key="Text.DropZone.Message" xml:space="preserve">Drop files here to compress or extract</x:String>
  <x:String x:Key="Text.DropZone.Footer" xml:space="preserve">Drag &amp; drop files onto this window to compress or extract</x:String>

  <!-- Settings Tabs -->
  <x:String x:Key="Text.Settings.Tab.General" xml:space="preserve">⚙️ General</x:String>
  <x:String x:Key="Text.Settings.Tab.Extraction" xml:space="preserve">📂 Extraction</x:String>
  <x:String x:Key="Text.Settings.Tab.Compression" xml:space="preserve">📦 Compression</x:String>
  <x:String x:Key="Text.Settings.Tab.Association" xml:space="preserve">🔗 File Associations</x:String>
  <x:String x:Key="Text.Settings.Tab.Version" xml:space="preserve">ℹ️ Version</x:String>
  <x:String x:Key="Text.Sidebar.General" xml:space="preserve">⚙️ General</x:String>
  <x:String x:Key="Text.Sidebar.Extraction" xml:space="preserve">📂 Extraction</x:String>
  <x:String x:Key="Text.Sidebar.Compression" xml:space="preserve">📦 Compression</x:String>
  <x:String x:Key="Text.Sidebar.Association" xml:space="preserve">🔗 Associations</x:String>
  <x:String x:Key="Text.Sidebar.Version" xml:space="preserve">ℹ️ Version</x:String>

  <!-- General Settings -->
  <x:String x:Key="Text.Settings.Theme.Header" xml:space="preserve">Theme</x:String>

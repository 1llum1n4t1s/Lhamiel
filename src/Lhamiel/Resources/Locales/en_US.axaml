  <x:String x:Key="Text.Overwrite.FolderTitle" xml:space="preserve">Confirm Folder Overwrite</x:String>
  <x:String x:Key="Text.Overwrite.FileTitle" xml:space="preserve">Replace File</x:String>
  <x:String x:Key="Text.Overwrite.DefaultMessage" xml:space="preserve">The file already exists.\n\nReplace it?</x:String>

  <!-- Dialog Titles (MessageService) -->
  <x:String x:Key="Text.Dialog.Error" xml:space="preserve">Error</x:String>

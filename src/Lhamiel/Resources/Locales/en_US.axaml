  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} file conflicts</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">Select which files to include in the archive. If multiple are selected, numbers will be added to file names.</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">Which files do you want to keep?</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">Skip {0} files with same date and size</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">Continue</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">Overwrite All</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">Extraction complete: {0}/{1} files succeeded</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">Unknown</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">Failed to load license information.</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">Cancelled due to insufficient disk space.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">User cancelled the extraction.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">Archive file not found: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">An error occurred while preparing the destination. The file may be in use or you may lack delete permissions.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">Failed to move contents to the destination. The original contents remain in the backup location.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">No files specified for compression.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">The specified path was not found: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">Unable to generate a unique file name: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">Failed to save settings: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">Extracted file not found.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">File path is empty.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">Path is too long. Maximum {0} characters allowed. (Current: {1} characters)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">Directory path is too long. Maximum {0} characters allowed.</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">File name is too long. Maximum {0} characters allowed.</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">Failed to parse path: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">Path contains an invalid character: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">File name contains an invalid character: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">An error occurred while validating the file name: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">Invalid path format detected</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">Path validation failed: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">Reserved device name is used: {0}</x:String>

  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">The output '{0}' is protected by the system and cannot be overwritten. Please choose a different location.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">Compressing...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">The archive contains an unsafe entry pointing outside the extraction target: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">Password Required</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">This archive is password-protected. Please enter the password to extract it.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">Password</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">The previous password was incorrect. Please try again.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">Password required or incorrect</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">This archive is password-protected. Either no password was provided or the password did not match: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">Retry the extraction and enter the correct password.</x:String>

  <!-- Password protection (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">Password Protection</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">Protect with password</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">Encrypts with AES-256 (WinZip AE-2) for ZIP, AES-256 for 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR does not support password protection. Choose ZIP or 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">Note: AES-256 encrypted ZIPs cannot be opened by the built-in Windows Explorer. Recipients need 7-Zip, WinRAR, or another compatible tool.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">Encrypt file names too</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">Encrypts the file-name listing (header) inside the archive. Without the password, even the contents cannot be browsed.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">The ZIP format cannot encrypt file names (central directory). Switch to 7z to enable this option.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">How to enter the password</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">Prompt on every drop</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">Save and reuse (DPAPI encrypted)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">Password: set</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">Password: not set (you will be asked on the next compression)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">Change Password</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">Clear Password</x:String>

  <!-- PasswordDialog CompressNew mode -->
  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">Set a Password</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">Set a password to encrypt the archive. Enter it twice for confirmation.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">Password (confirm)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">Passwords do not match. Please re-enter the confirmation.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">Please enter a password.</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">Password must be at least 4 characters long.</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">You can paste from a password manager (Ctrl+V).</x:String>

  <!-- Confirm dialogs -->
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">Delete the saved password?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">Switching to "Prompt on every drop" will delete the currently saved password. Continue?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">Delete the saved password?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">The saved password will be deleted. You will be asked to enter it again on the next compression. Continue?</x:String>

  <!-- Notifications -->
  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">The saved password could not be restored (likely caused by copying settings from another PC or a Windows password reset). Please set the password again.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">The saved password contains characters that cannot be used with the ZIP format (ASCII only). Enter a password to use for this compression (the saved password will not be changed).</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">The saved password is too short to use (at least {0} characters are required). Please set a new password.</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} file(s) were skipped because they were inaccessible. A password-protected archive was created with the remaining files.</x:String>

  <!-- Password-related errors -->
  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">All source files were inaccessible, so compression was aborted. An empty archive was not created.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">The {0} format does not support password protection. Choose ZIP or 7z.</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">ZIP passwords can only contain ASCII characters (letters, digits, and symbols). To use other characters (such as accented letters or Japanese), choose the 7z format.</x:String>
</ResourceDictionary>

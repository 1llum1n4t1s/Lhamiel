  <x:String x:Key="Text.Progress.PreparingFiles" xml:space="preserve">Preparing files...</x:String>
  <x:String x:Key="Text.Progress.MovingFiles" xml:space="preserve">Moving files...</x:String>
  <x:String x:Key="Text.Progress.Extracting" xml:space="preserve">Extracting</x:String>
  <x:String x:Key="Text.Progress.Compressing" xml:space="preserve">Compressing</x:String>

  <!-- Error Recovery Dialog -->
  <x:String x:Key="Text.ErrorRecovery.ErrorInfo" xml:space="preserve">Error Information</x:String>

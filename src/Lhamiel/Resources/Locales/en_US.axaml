  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">System (Follow OS)</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Dark</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Light</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">Default Compression Format</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Header" xml:space="preserve">Shortcut</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Create" xml:space="preserve">📌 Create Desktop Shortcut</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">Language</x:String>

  <!-- Output Settings (shared) -->
  <x:String x:Key="Text.Settings.Output.Header" xml:space="preserve">Output Directory</x:String>
  <x:String x:Key="Text.Settings.Output.SameDirectory" xml:space="preserve">Output to the same directory as the source file</x:String>
  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">Specify a directory</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">Browse...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">Select extraction folder</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseCompression" xml:space="preserve">Select compression folder</x:String>

  <!-- Extraction Settings -->
  <x:String x:Key="Text.Settings.Extraction.OpenFolder" xml:space="preserve">Open destination folder after extraction</x:String>
  <x:String x:Key="Text.Settings.Extraction.OptionHeader" xml:space="preserve">Extraction Options</x:String>
  <x:String x:Key="Text.Settings.Extraction.CreateFolder" xml:space="preserve">Create folder with archive name</x:String>

  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">Open destination folder after compression</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">Merge Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">Compression Options</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">Compress multiple files into a single archive</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">When OFF, each file will be compressed into a separate archive</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">Include root directory when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">Exclude root directory when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">Exclude all directories when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">Compression Level</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">ZIP Compression Level</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">7z Compression Level</x:String>

  <!-- Compression Level Names -->
  <x:String x:Key="Text.CompressionLevel.None" xml:space="preserve">No Compression</x:String>
  <x:String x:Key="Text.CompressionLevel.Fastest" xml:space="preserve">Fastest</x:String>
  <x:String x:Key="Text.CompressionLevel.Fast" xml:space="preserve">Fast</x:String>

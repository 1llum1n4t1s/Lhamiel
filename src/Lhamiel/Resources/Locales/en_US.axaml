  <x:String x:Key="Text.Update.Latest" xml:space="preserve">Already the latest version.</x:String>
  <x:String x:Key="Text.Update.DownloadTimeout" xml:space="preserve">Download timed out.</x:String>
  <x:String x:Key="Text.Update.CheckError" xml:space="preserve">An error occurred while checking for updates.</x:String>

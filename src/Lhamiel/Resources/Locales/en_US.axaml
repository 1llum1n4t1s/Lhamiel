  <x:String x:Key="Text.Progress.Finalizing" xml:space="preserve">Finalizing...</x:String>
  <x:String x:Key="Text.Progress.CheckingDiskSpace" xml:space="preserve">Checking free disk space...</x:String>

  <!-- Error Recovery Dialog -->
  <x:String x:Key="Text.ErrorRecovery.ErrorInfo" xml:space="preserve">Error Information</x:String>
  <x:String x:Key="Text.ErrorRecovery.ProblematicFile" xml:space="preserve">Problematic File</x:String>
  <x:String x:Key="Text.ErrorRecovery.RecoveryOptions" xml:space="preserve">Recovery Options</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAndContinue" xml:space="preserve">Skip this file and continue</x:String>
  <x:String x:Key="Text.ErrorRecovery.Retry" xml:space="preserve">Retry</x:String>
  <x:String x:Key="Text.ErrorRecovery.StopExtraction" xml:space="preserve">Stop extraction</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAllErrors" xml:space="preserve">Skip all subsequent errors</x:String>
  <x:String x:Key="Text.ErrorRecovery.RememberChoice" xml:space="preserve">Remember this choice</x:String>

  <!-- Overwrite Dialog -->
  <x:String x:Key="Text.Overwrite.FolderMessage" xml:space="preserve">Folder '{0}' already exists.\n\nDelete the existing folder and overwrite?</x:String>
  <x:String x:Key="Text.Overwrite.FileMessage" xml:space="preserve">File '{0}' already exists.\n\nReplace it?</x:String>
  <x:String x:Key="Text.Overwrite.FolderTitle" xml:space="preserve">Confirm Folder Overwrite</x:String>
  <x:String x:Key="Text.Overwrite.FileTitle" xml:space="preserve">Replace File</x:String>
  <x:String x:Key="Text.Overwrite.DefaultMessage" xml:space="preserve">The file already exists.\n\nReplace it?</x:String>

  <!-- Dialog Titles (MessageService) -->
  <x:String x:Key="Text.Dialog.Error" xml:space="preserve">Error</x:String>

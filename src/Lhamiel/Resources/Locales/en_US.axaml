  <x:String x:Key="Text.ErrorRecovery.StopExtraction" xml:space="preserve">Stop extraction</x:String>
  <x:String x:Key="Text.ErrorRecovery.SkipAllErrors" xml:space="preserve">Skip all subsequent errors</x:String>
  <x:String x:Key="Text.ErrorRecovery.RememberChoice" xml:space="preserve">Remember this choice</x:String>

  <!-- Overwrite Dialog -->
  <x:String x:Key="Text.Overwrite.FolderMessage" xml:space="preserve">Folder '{0}' already exists.\n\nDelete the existing folder and overwrite?</x:String>

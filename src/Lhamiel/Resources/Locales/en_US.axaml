<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Window Titles -->
  <x:String x:Key="Text.App.Title" xml:space="preserve">Lhamiel - Archive Compression &amp; Extraction Tool</x:String>
  <x:String x:Key="Text.Progress.Title" xml:space="preserve">Processing...</x:String>
  <x:String x:Key="Text.Overwrite.Title" xml:space="preserve">Replace File</x:String>
  <x:String x:Key="Text.ErrorRecovery.Title" xml:space="preserve">Error Recovery Options</x:String>

  <!-- Drop Zone -->
  <x:String x:Key="Text.DropZone.Message" xml:space="preserve">Drop files here to compress or extract</x:String>
  <x:String x:Key="Text.DropZone.Footer" xml:space="preserve">Drag &amp; drop files onto this window to compress or extract</x:String>

  <!-- Settings Tabs -->
  <x:String x:Key="Text.Settings.Tab.General" xml:space="preserve">⚙️ General</x:String>
  <x:String x:Key="Text.Settings.Tab.Extraction" xml:space="preserve">📂 Extraction</x:String>
  <x:String x:Key="Text.Settings.Tab.Compression" xml:space="preserve">📦 Compression</x:String>
  <x:String x:Key="Text.Settings.Tab.Association" xml:space="preserve">🔗 File Associations</x:String>
  <x:String x:Key="Text.Settings.Tab.Version" xml:space="preserve">ℹ️ Version</x:String>
  <x:String x:Key="Text.Sidebar.General" xml:space="preserve">⚙️ General</x:String>
  <x:String x:Key="Text.Sidebar.Extraction" xml:space="preserve">📂 Extraction</x:String>
  <x:String x:Key="Text.Sidebar.Compression" xml:space="preserve">📦 Compression</x:String>
  <x:String x:Key="Text.Sidebar.Association" xml:space="preserve">🔗 Associations</x:String>
  <x:String x:Key="Text.Sidebar.Version" xml:space="preserve">ℹ️ Version</x:String>

  <!-- General Settings -->
  <x:String x:Key="Text.Settings.Theme.Header" xml:space="preserve">Theme</x:String>
  <x:String x:Key="Text.Settings.Theme.Tooltip" xml:space="preserve">Switch the application theme</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">System (Follow OS)</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Dark</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Light</x:String>
  <x:String x:Key="Text.Settings.CompressionFormat.Header" xml:space="preserve">Default Compression Format</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Header" xml:space="preserve">Shortcut</x:String>
  <x:String x:Key="Text.Settings.Shortcut.Create" xml:space="preserve">📌 Create Desktop Shortcut</x:String>
  <x:String x:Key="Text.Settings.Language.Header" xml:space="preserve">Language</x:String>

  <!-- Output Settings (shared) -->
  <x:String x:Key="Text.Settings.Output.Header" xml:space="preserve">Output Directory</x:String>
  <x:String x:Key="Text.Settings.Output.SameDirectory" xml:space="preserve">Output to the same directory as the source file</x:String>
  <x:String x:Key="Text.Settings.Output.SpecifyDirectory" xml:space="preserve">Specify a directory</x:String>
  <x:String x:Key="Text.Settings.Output.Browse" xml:space="preserve">Browse...</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseExtraction" xml:space="preserve">Select extraction folder</x:String>
  <x:String x:Key="Text.Settings.Output.BrowseCompression" xml:space="preserve">Select compression folder</x:String>

  <!-- Extraction Settings -->
  <x:String x:Key="Text.Settings.Extraction.OpenFolder" xml:space="preserve">Open destination folder after extraction</x:String>
  <x:String x:Key="Text.Settings.Extraction.OptionHeader" xml:space="preserve">Extraction Options</x:String>
  <x:String x:Key="Text.Settings.Extraction.CreateFolder" xml:space="preserve">Create folder with archive name</x:String>

  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">Open destination folder after compression</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">Merge Compression</x:String>
  <x:String x:Key="Text.Settings.Compression.OptionHeader" xml:space="preserve">Compression Options</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeOption" xml:space="preserve">Compress multiple files into a single archive</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeDescription" xml:space="preserve">When OFF, each file will be compressed into a separate archive</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.IncludeRoot" xml:space="preserve">Include root directory when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.ExcludeRoot" xml:space="preserve">Exclude root directory when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.DirMode.Flat" xml:space="preserve">Exclude all directories when compressing</x:String>
  <x:String x:Key="Text.Settings.Compression.LevelHeader" xml:space="preserve">Compression Level</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipLevel" xml:space="preserve">ZIP Compression Level</x:String>
  <x:String x:Key="Text.Settings.Compression.SevenZipLevel" xml:space="preserve">7z Compression Level</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystem" xml:space="preserve">Include hidden/System files and folders</x:String>
  <x:String x:Key="Text.Settings.Compression.IncludeHiddenAndSystemDescription" xml:space="preserve">Entries with Hidden or System attributes are also added to archives.</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Header" xml:space="preserve">Compression Exclusion List</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Description" xml:space="preserve">Patterns in this list are skipped during compression. Supports .gitignore-compatible syntax (e.g. *.log, node_modules/, !keep.txt).</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Placeholder" xml:space="preserve">e.g. *.log or node_modules/</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Add" xml:space="preserve">Add</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Remove" xml:space="preserve">Remove</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.Reset" xml:space="preserve">Reset Defaults</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile" xml:space="preserve">Open Exclusion File</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.OpenFile.Tip" xml:space="preserve">Opens .lhaignore in the default text editor</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore" xml:space="preserve">Also use .gitignore files inside the source</x:String>
  <x:String x:Key="Text.Settings.ExcludedPatterns.RespectGitignore.Tip" xml:space="preserve">When a subdirectory in the source contains a .gitignore, apply its rules in that scope (e.g. compressing C:\Users\IMT\dev honors each repository's .gitignore)</x:String>

  <!-- Compression Level Names -->
  <x:String x:Key="Text.CompressionLevel.None" xml:space="preserve">No Compression</x:String>
  <x:String x:Key="Text.CompressionLevel.Fastest" xml:space="preserve">Fastest</x:String>
  <x:String x:Key="Text.CompressionLevel.Fast" xml:space="preserve">Fast</x:String>
  <x:String x:Key="Text.CompressionLevel.Normal" xml:space="preserve">Normal</x:String>
  <x:String x:Key="Text.CompressionLevel.Maximum" xml:space="preserve">Maximum</x:String>
  <x:String x:Key="Text.CompressionLevel.Ultra" xml:space="preserve">Ultra</x:String>

  <!-- Association Settings -->
  <x:String x:Key="Text.Settings.Association.SelectAll" xml:space="preserve">Select All</x:String>
  <x:String x:Key="Text.Settings.Association.DeselectAll" xml:space="preserve">Deselect All</x:String>

  <!-- Version Tab -->
  <x:String x:Key="Text.Version.AppName" xml:space="preserve">Lhamiel</x:String>
  <x:String x:Key="Text.Version.Description" xml:space="preserve">Archive Compression &amp; Extraction Tool</x:String>
  <x:String x:Key="Text.Version.Label" xml:space="preserve">Version</x:String>
  <x:String x:Key="Text.Version.SevenZipLabel" xml:space="preserve">7-Zip</x:String>
  <x:String x:Key="Text.Version.CheckUpdate" xml:space="preserve">Check for Updates</x:String>
  <x:String x:Key="Text.Version.Copyright" xml:space="preserve">Copyright</x:String>
  <x:String x:Key="Text.Version.License" xml:space="preserve">License</x:String>
  <x:String x:Key="Text.Version.Feedback.Description" xml:space="preserve">Send us your feedback and suggestions</x:String>
  <x:String x:Key="Text.Version.Feedback.Button" xml:space="preserve">Send Feedback (GitHub)</x:String>
  <x:String x:Key="Text.Version.Feedback.Confirm" xml:space="preserve">Open the GitHub Issues page in your browser?</x:String>
  <x:String x:Key="Text.Version.Feedback.ConfirmTitle" xml:space="preserve">Confirm</x:String>

  <!-- Buttons -->
  <x:String x:Key="Text.Button.Save" xml:space="preserve">Save</x:String>
  <x:String x:Key="Text.Button.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Button.OK" xml:space="preserve">OK</x:String>
  <x:String x:Key="Text.Button.Yes" xml:space="preserve">Yes</x:String>
  <x:String x:Key="Text.Button.No" xml:space="preserve">No</x:String>

  <!-- Progress Window -->
  <x:String x:Key="Text.Progress.Processing" xml:space="preserve">Processing</x:String>
  <x:String x:Key="Text.Progress.Cancelled" xml:space="preserve">Cancelled.</x:String>
  <x:String x:Key="Text.Progress.PreparingFiles" xml:space="preserve">Preparing files...</x:String>
  <x:String x:Key="Text.Progress.MovingFiles" xml:space="preserve">Moving files...</x:String>
  <x:String x:Key="Text.Progress.Extracting" xml:space="preserve">Extracting</x:String>
  <x:String x:Key="Text.Progress.Compressing" xml:space="preserve">Compressing</x:String>
  <x:String x:Key="Text.Progress.VerifyingIntegrity" xml:space="preserve">Verifying integrity...</x:String>

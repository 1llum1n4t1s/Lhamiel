  <x:String x:Key="Text.Settings.Association.SelectAll" xml:space="preserve">Select All</x:String>
  <x:String x:Key="Text.Settings.Association.DeselectAll" xml:space="preserve">Deselect All</x:String>

  <!-- Version Tab -->
  <x:String x:Key="Text.Version.AppName" xml:space="preserve">Lhamiel</x:String>

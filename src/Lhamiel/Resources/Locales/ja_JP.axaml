  <!-- Compression Settings -->
  <x:String x:Key="Text.Settings.Compression.OpenFolder" xml:space="preserve">圧縮後に保存先のフォルダを開く</x:String>
  <x:String x:Key="Text.Settings.Compression.MergeHeader" xml:space="preserve">まとめ圧縮</x:String>

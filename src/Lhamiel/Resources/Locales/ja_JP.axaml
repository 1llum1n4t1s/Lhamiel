  <x:String x:Key="Text.ErrorHandler.UnsupportedFormat" xml:space="preserve">サポートされていないファイル形式です</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatDetail" xml:space="preserve">このファイル形式はサポートされていません: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.UnsupportedFormatAction" xml:space="preserve">サポートされている形式（ZIP、7Z、RAR等）のファイルを使用してください。</x:String>
  <x:String x:Key="Text.ErrorHandler.Unexpected" xml:space="preserve">予期しないエラーが発生しました</x:String>
  <x:String x:Key="Text.ErrorHandler.UnexpectedAction" xml:space="preserve">エラーの詳細を確認し、必要に応じてサポートに連絡してください。</x:String>
  <x:String x:Key="Text.ErrorHandler.ArchiveFile" xml:space="preserve">アーカイブファイル: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.ErrorMessage" xml:space="preserve">エラーメッセージ: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileSize" xml:space="preserve">ファイルサイズ: {0:N0} バイト</x:String>
  <x:String x:Key="Text.ErrorHandler.LastModified" xml:space="preserve">最終更新日時: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.FileInfoFailed" xml:space="preserve">ファイル情報の取得に失敗しました</x:String>

  <!-- Error Recovery File Info -->
  <x:String x:Key="Text.ErrorRecovery.FileName" xml:space="preserve">ファイル名: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileSize" xml:space="preserve">サイズ: {0:N0} バイト</x:String>
  <x:String x:Key="Text.ErrorRecovery.CreatedDate" xml:space="preserve">作成日時: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ModifiedDate" xml:space="preserve">更新日時: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.Attributes" xml:space="preserve">属性: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.DiskInfo" xml:space="preserve">ディスク情報:</x:String>
  <x:String x:Key="Text.ErrorRecovery.AvailableSpace" xml:space="preserve">利用可能容量: {0:N0} バイト</x:String>
  <x:String x:Key="Text.ErrorRecovery.TotalSpace" xml:space="preserve">総容量: {0:N0} バイト</x:String>
  <x:String x:Key="Text.ErrorRecovery.FileInfoFailed" xml:space="preserve">ファイル情報の取得に失敗: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionDetails" xml:space="preserve">例外詳細:</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionType" xml:space="preserve">種類: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.ExceptionMessage" xml:space="preserve">メッセージ: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.InnerException" xml:space="preserve">内部例外: {0}</x:String>

  <!-- Partial Extraction -->
  <x:String x:Key="Text.Extraction.Progress" xml:space="preserve">展開中: {0}</x:String>
  <x:String x:Key="Text.Extraction.ReExtracting" xml:space="preserve">再展開中: {0}</x:String>
  <x:String x:Key="Text.Extraction.FileNotInArchive" xml:space="preserve">アーカイブ内に対象ファイルが見つかりません。</x:String>
  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">ファイル: {0}\nエラー: {1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">再試行またはスキップを選択できます</x:String>

  <!-- ディスク容量不足ダイアログ -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">ディスク容量不足</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">必要な容量:</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">空き容量:</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">不足分:</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">ドライブ: {0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">ディスクの空き容量が不足しています。不要なファイルを削除してから「再開」を押してください。</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">再開</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">キャンセル</x:String>

  <!-- 進捗ダイアログ注意書き -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">重複するファイルがある場合、この後に確認ダイアログが表示されます</x:String>

  <!-- ファイル競合ダイアログ -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} 件のファイルの競合</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">アーカイブに含めるファイルを選択してください。複数選択した場合、ファイル名に番号が追加されます。</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">どのファイルを保存しますか？</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">日付とサイズが同じ {0} ファイルをスキップする</x:String>
  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">現在の場所 {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">宛先の場所 {0}</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">続行</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">キャンセル</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">すべて上書き</x:String>

  <!-- 進捗完了メッセージ -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">展開完了: {0}/{1} 個のファイルが成功</x:String>

  <!-- 情報表示 -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">不明</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">ライセンス情報を読み込めませんでした。</x:String>

  <!-- エラーメッセージ（例外） -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">ディスク容量不足でキャンセルされました。</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">ユーザーが展開処理をキャンセルしました。</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">アーカイブファイルが見つかりません: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">展開先の準備中にエラーが発生しました。ファイルが使用中か、削除権限がない可能性があります。</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">展開先への内容移動に失敗しました。元の内容は退避先に残っています。</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">圧縮するファイルが指定されていません。</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">指定されたパスが見つかりません: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">ユニークなファイル名を生成できません: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">設定の保存に失敗しました: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">展開されたファイルが見つかりません。</x:String>

  <!-- パス検証メッセージ -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">ファイルパスが空です。</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">パスが長すぎます。最大 {0} 文字まで許可されています。（現在: {1} 文字）</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">ディレクトリパスが長すぎます。最大 {0} 文字まで許可されています。</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">ファイル名が長すぎます。最大 {0} 文字まで許可されています。</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">パスの解析に失敗しました: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">パスに不正な文字が含まれています: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">ファイル名に不正な文字が含まれています: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">ファイル名の検証中にエラーが発生しました: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">不正なパス形式が検出されました</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">パスの検証に失敗しました: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">予約されたデバイス名が使用されています: {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' はシステムによって保護されているため、上書きできません。別の場所を選択してください。</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">圧縮処理中...</x:String>

  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">アーカイブに展開先の外側を指す不正なエントリが含まれています: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">パスワードの入力</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">このアーカイブはパスワードで保護されています。展開するためのパスワードを入力してください。</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">パスワード</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">パスワードが間違っています。もう一度入力してください。</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">パスワードが必要、または不一致です</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">このアーカイブはパスワード保護されています。パスワードが指定されていない、または一致しませんでした: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">もう一度展開し、正しいパスワードを入力してください。</x:String>

  <!-- パスワード保護 (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">パスワード保護</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">パスワードで保護する</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">ZIP は AES-256 (WinZip AE-2)、7z は AES-256 で暗号化します。</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR 形式はパスワード保護をサポートしていません。ZIP または 7z を選択してください。</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">注意: AES-256 で暗号化した ZIP は Windows 標準のエクスプローラーでは展開できません。受信者は 7-Zip / WinRAR 等の対応ツールが必要です。</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">ファイル名も暗号化する</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">アーカイブ内のファイル名一覧 (ヘッダ) も暗号化します。パスワード無しでは内容を見ることもできなくなります。</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">ZIP 形式の仕様上、ファイル名 (セントラルディレクトリ) は暗号化できません。7z を選択すると有効化できます。</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">パスワードの入力方法</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">ドロップごとに確認する</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">保存して再利用する (DPAPI 暗号化)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">パスワード: 設定済</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">パスワード: 未設定 (次回圧縮時に設定します)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">パスワードを変更</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">パスワードを削除</x:String>

  <!-- PasswordDialog CompressNew モード -->
  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">パスワードの設定</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">アーカイブを暗号化するためのパスワードを設定してください。確認のため 2 回入力します。</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">パスワード (確認)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">パスワードが一致しません。もう一度確認入力してください。</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">パスワードを入力してください。</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">パスワードは 4 文字以上で入力してください。</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">パスワード管理ツールから貼り付けできます (Ctrl+V)。</x:String>

  <!-- Confirm ダイアログ -->
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">保存済みパスワードを削除しますか？</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">「ドロップごとに確認」に切り替えると、現在保存されているパスワードは削除されます。よろしいですか？</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">保存済みパスワードを削除しますか？</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">保存されているパスワードを削除します。次回圧縮時にもう一度入力が必要になります。よろしいですか？</x:String>

  <!-- 通知 -->
  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">保存されていたパスワードを復元できませんでした (別 PC からの設定コピー / Windows パスワードのリセット等が原因の可能性があります)。再度パスワードを設定してください。</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">保存済みパスワードには ZIP 形式で使用できない文字が含まれています (ASCII 文字のみ対応)。この圧縮で使用するパスワードを入力してください (保存済みパスワードは変更されません)。</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordTooShort" xml:space="preserve">保存されているパスワードが短すぎるため使用できません（{0} 文字以上が必要です）。新しいパスワードを設定してください。</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} 件のファイルがアクセス不能でスキップされました。残りのファイルでパスワード保護アーカイブを作成しました。</x:String>

  <!-- パスワード関連エラー -->
  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">すべてのファイルがアクセス不能のため圧縮を中止しました。空のアーカイブは作成していません。</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">{0} 形式はパスワード保護をサポートしていません。ZIP または 7z を選択してください。</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">ZIP 形式のパスワードに使用できるのは半角英数字と記号 (ASCII 文字) のみです。日本語など他の文字を使う場合は 7z 形式を選択してください。</x:String>
</ResourceDictionary>

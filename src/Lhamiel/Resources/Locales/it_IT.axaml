  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">Il percorso del file è vuoto.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">Il percorso è troppo lungo. Massimo {0} caratteri consentiti. (Attuale: {1} caratteri)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">Il percorso della directory è troppo lungo. Massimo {0} caratteri consentiti.</x:String>

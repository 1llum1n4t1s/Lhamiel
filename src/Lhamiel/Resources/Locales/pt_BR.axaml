  <x:String x:Key="Text.ErrorRecovery.ExceptionMessage" xml:space="preserve">Mensagem: {0}</x:String>
  <x:String x:Key="Text.ErrorRecovery.InnerException" xml:space="preserve">Exceção interna: {0}</x:String>

  <!-- Partial Extraction -->
  <x:String x:Key="Text.Extraction.Progress" xml:space="preserve">Extraindo: {0}</x:String>
  <x:String x:Key="Text.Extraction.ReExtracting" xml:space="preserve">Re-extraindo: {0}</x:String>
  <x:String x:Key="Text.Extraction.FileNotInArchive" xml:space="preserve">Arquivo alvo não encontrado no arquivo compactado.</x:String>
  <x:String x:Key="Text.Extraction.ErrorFile" xml:space="preserve">Arquivo: {0}\nErro: {1}</x:String>
  <x:String x:Key="Text.Extraction.RetryOrSkip" xml:space="preserve">Você pode escolher tentar novamente ou pular.</x:String>

  <x:String x:Key="Text.Conflict.ColumnLeft" xml:space="preserve">Local atual {0}</x:String>
  <x:String x:Key="Text.Conflict.ColumnRight" xml:space="preserve">Destino {0}</x:String>


  <!-- Disk Space Dialog -->
  <x:String x:Key="Text.DiskSpace.Title" xml:space="preserve">Espaço em disco insuficiente</x:String>
  <x:String x:Key="Text.DiskSpace.Required" xml:space="preserve">Espaço necessário:</x:String>
  <x:String x:Key="Text.DiskSpace.Available" xml:space="preserve">Espaço disponível:</x:String>
  <x:String x:Key="Text.DiskSpace.Shortage" xml:space="preserve">Faltando:</x:String>
  <x:String x:Key="Text.DiskSpace.Drive" xml:space="preserve">Unidade: {0}</x:String>
  <x:String x:Key="Text.DiskSpace.Description" xml:space="preserve">Espaço em disco insuficiente. Exclua arquivos desnecessários e pressione Tentar novamente.</x:String>
  <x:String x:Key="Text.DiskSpace.Retry" xml:space="preserve">Tentar novamente</x:String>
  <x:String x:Key="Text.DiskSpace.Cancel" xml:space="preserve">Cancelar</x:String>

  <!-- Progress Notice -->
  <x:String x:Key="Text.Progress.ConflictNotice" xml:space="preserve">Se houver arquivos duplicados, um diálogo de confirmação será exibido após a extração</x:String>

  <!-- File Conflict Dialog -->
  <x:String x:Key="Text.Conflict.Header" xml:space="preserve">{0} conflitos de arquivos</x:String>
  <x:String x:Key="Text.Conflict.Description.Compress" xml:space="preserve">Selecione quais arquivos incluir no arquivo compactado. Se vários forem selecionados, números serão adicionados aos nomes.</x:String>
  <x:String x:Key="Text.Conflict.Description.Extract" xml:space="preserve">Quais arquivos você deseja manter?</x:String>
  <x:String x:Key="Text.Conflict.SkipIdentical" xml:space="preserve">Pular {0} arquivos com mesma data e tamanho</x:String>
  <x:String x:Key="Text.Conflict.Continue" xml:space="preserve">Continuar</x:String>
  <x:String x:Key="Text.Conflict.Cancel" xml:space="preserve">Cancelar</x:String>
  <x:String x:Key="Text.Conflict.OverwriteAll" xml:space="preserve">Substituir tudo</x:String>

  <!-- Progress completion -->
  <x:String x:Key="Text.Progress.ExtractionComplete" xml:space="preserve">Extração concluída: {0}/{1} arquivos com sucesso</x:String>

  <!-- Info display -->
  <x:String x:Key="Text.Info.Unknown" xml:space="preserve">Desconhecido</x:String>
  <x:String x:Key="Text.Info.LicenseLoadFailed" xml:space="preserve">Falha ao carregar as informações de licença.</x:String>

  <!-- Error messages (exceptions) -->
  <x:String x:Key="Text.Error.DiskSpaceCancelled" xml:space="preserve">Cancelado devido a espaço em disco insuficiente.</x:String>
  <x:String x:Key="Text.Error.UserCancelledExtraction" xml:space="preserve">O usuário cancelou a extração.</x:String>
  <x:String x:Key="Text.Error.ArchiveNotFound" xml:space="preserve">Arquivo compactado não encontrado: {0}</x:String>
  <x:String x:Key="Text.Error.PreparationFailed" xml:space="preserve">Ocorreu um erro ao preparar o destino. O arquivo pode estar em uso ou você não tem permissões de exclusão.</x:String>
  <x:String x:Key="Text.Error.MoveFailed" xml:space="preserve">Falha ao mover o conteúdo para o destino. O conteúdo original permanece no local de backup.</x:String>
  <x:String x:Key="Text.Error.NoFilesToCompress" xml:space="preserve">Nenhum arquivo especificado para compactação.</x:String>
  <x:String x:Key="Text.Error.PathNotFound" xml:space="preserve">O caminho especificado não foi encontrado: {0}</x:String>
  <x:String x:Key="Text.Error.UniqueNameFailed" xml:space="preserve">Não foi possível gerar um nome de arquivo único: {0}</x:String>
  <x:String x:Key="Text.Error.SaveSettingsFailed" xml:space="preserve">Falha ao salvar as configurações: {0}</x:String>
  <x:String x:Key="Text.Error.ExtractedFileNotFound" xml:space="preserve">Arquivo extraído não encontrado.</x:String>

  <!-- Path validation messages -->
  <x:String x:Key="Text.Validation.PathEmpty" xml:space="preserve">O caminho do arquivo está vazio.</x:String>
  <x:String x:Key="Text.Validation.PathTooLong" xml:space="preserve">O caminho é muito longo. Máximo de {0} caracteres permitidos. (Atual: {1} caracteres)</x:String>
  <x:String x:Key="Text.Validation.DirTooLong" xml:space="preserve">O caminho do diretório é muito longo. Máximo de {0} caracteres permitidos.</x:String>
  <x:String x:Key="Text.Validation.FilenameTooLong" xml:space="preserve">O nome do arquivo é muito longo. Máximo de {0} caracteres permitidos.</x:String>
  <x:String x:Key="Text.Validation.PathParseFailed" xml:space="preserve">Falha ao analisar o caminho: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathChar" xml:space="preserve">O caminho contém um caractere inválido: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.InvalidFileNameChar" xml:space="preserve">O nome do arquivo contém um caractere inválido: '{0}' ({1})</x:String>
  <x:String x:Key="Text.Validation.FileNameCheckFailed" xml:space="preserve">Ocorreu um erro ao validar o nome do arquivo: {0}</x:String>
  <x:String x:Key="Text.Validation.InvalidPathFormat" xml:space="preserve">Formato de caminho inválido detectado</x:String>
  <x:String x:Key="Text.Validation.PathCheckFailed" xml:space="preserve">A validação do caminho falhou: {0}</x:String>
  <x:String x:Key="Text.Validation.ReservedDeviceName" xml:space="preserve">Nome de dispositivo reservado está sendo usado: {0}</x:String>
  <x:String x:Key="Text.Error.ProtectedDirectory" xml:space="preserve">'{0}' está protegido pelo sistema e não pode ser substituído. Escolha outro local.</x:String>
  <x:String x:Key="Text.Compressor.Processing" xml:space="preserve">Compactando...</x:String>
  <x:String x:Key="Text.Error.ZipSlipDetected" xml:space="preserve">O arquivo contém uma entrada insegura apontando para fora do destino de extração: {0}</x:String>

  <!-- Password Dialog -->
  <x:String x:Key="Text.Password.Title" xml:space="preserve">Senha necessária</x:String>
  <x:String x:Key="Text.Password.Message" xml:space="preserve">Este arquivo está protegido por senha. Digite a senha para extraí-lo.</x:String>
  <x:String x:Key="Text.Password.Placeholder" xml:space="preserve">Senha</x:String>
  <x:String x:Key="Text.Password.WrongPasswordRetry" xml:space="preserve">A senha anterior estava incorreta. Tente novamente.</x:String>

  <!-- Encryption-related error -->
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPassword" xml:space="preserve">Senha necessária ou incorreta</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordDetail" xml:space="preserve">Este arquivo está protegido por senha. Nenhuma senha foi fornecida ou não coincide: {0}</x:String>
  <x:String x:Key="Text.ErrorHandler.EncryptedOrWrongPasswordAction" xml:space="preserve">Tente a extração novamente e digite a senha correta.</x:String>

  <!-- Proteção por senha (v1.0.181+) -->
  <x:String x:Key="Text.Settings.Compression.PasswordHeader" xml:space="preserve">Proteção por senha</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePassword" xml:space="preserve">Proteger com senha</x:String>
  <x:String x:Key="Text.Settings.Compression.EnablePasswordDescription" xml:space="preserve">Criptografa ZIP com AES-256 (WinZip AE-2) e 7z com AES-256.</x:String>
  <x:String x:Key="Text.Settings.Compression.TarNoEncryptionNote" xml:space="preserve">TAR não oferece suporte à proteção por senha. Escolha ZIP ou 7z.</x:String>
  <x:String x:Key="Text.Settings.Compression.ZipAesExplorerNote" xml:space="preserve">Observação: ZIPs criptografados com AES-256 não podem ser abertos pelo Explorador do Windows integrado. Os destinatários precisam de 7-Zip, WinRAR ou outra ferramenta compatível.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNames" xml:space="preserve">Criptografar também os nomes de arquivos</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesDescription" xml:space="preserve">Criptografa a lista de nomes de arquivos (cabeçalho) dentro do arquivo compactado. Sem a senha, nem o conteúdo pode ser navegado.</x:String>
  <x:String x:Key="Text.Settings.Compression.EncryptFileNamesZipUnsupported" xml:space="preserve">O formato ZIP não consegue criptografar os nomes de arquivos (diretório central). Mude para 7z para habilitar esta opção.</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.GroupLabel" xml:space="preserve">Como inserir a senha</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.PromptEachTime" xml:space="preserve">Perguntar a cada arrastar/soltar</x:String>
  <x:String x:Key="Text.Settings.Compression.PasswordMode.Remember" xml:space="preserve">Salvar e reutilizar (criptografado por DPAPI)</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.Set" xml:space="preserve">Senha: definida</x:String>
  <x:String x:Key="Text.Settings.Compression.SavedPasswordStatus.NotSet" xml:space="preserve">Senha: não definida (será solicitada na próxima compactação)</x:String>
  <x:String x:Key="Text.Settings.Compression.ChangeSavedPassword" xml:space="preserve">Alterar senha</x:String>
  <x:String x:Key="Text.Settings.Compression.ClearSavedPassword" xml:space="preserve">Excluir senha</x:String>

  <x:String x:Key="Text.Password.SetTitle" xml:space="preserve">Definir uma senha</x:String>
  <x:String x:Key="Text.Password.SetMessage" xml:space="preserve">Defina uma senha para criptografar o arquivo. Insira duas vezes para confirmação.</x:String>
  <x:String x:Key="Text.Password.ConfirmPlaceholder" xml:space="preserve">Senha (confirmação)</x:String>
  <x:String x:Key="Text.Password.MismatchWarning" xml:space="preserve">As senhas não conferem. Reinsira a confirmação.</x:String>
  <x:String x:Key="Text.Password.EmptyPasswordWarning" xml:space="preserve">Insira uma senha.</x:String>
  <x:String x:Key="Text.Password.TooShortWarning" xml:space="preserve">A senha deve ter pelo menos 4 caracteres.</x:String>
  <x:String x:Key="Text.Password.PasteHint" xml:space="preserve">Você pode colar de um gerenciador de senhas (Ctrl+V).</x:String>

  <x:String x:Key="Text.Confirm.WipeSavedPassword.Title" xml:space="preserve">Excluir a senha salva?</x:String>
  <x:String x:Key="Text.Confirm.WipeSavedPassword.Message" xml:space="preserve">Mudar para "Perguntar a cada arrastar/soltar" excluirá a senha salva atual. Continuar?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Title" xml:space="preserve">Excluir a senha salva?</x:String>
  <x:String x:Key="Text.Confirm.ClearSavedPassword.Message" xml:space="preserve">A senha salva será excluída. Você precisará digitá-la novamente na próxima compactação. Continuar?</x:String>

  <x:String x:Key="Text.Notify.SavedPasswordDecryptFailed" xml:space="preserve">Não foi possível restaurar a senha salva (provavelmente por copiar configurações de outro PC ou redefinir a senha do Windows). Defina a senha novamente.</x:String>
  <x:String x:Key="Text.Notify.SavedPasswordZipAsciiOnly" xml:space="preserve">A senha salva contém caracteres que não podem ser usados no formato ZIP (somente ASCII). Digite uma senha para esta compressão (a senha salva não será alterada).</x:String>
  <x:String x:Key="Text.Notify.PartialSkipWithPassword" xml:space="preserve">{0} arquivo(s) ignorado(s) por estarem inacessíveis. Um arquivo protegido por senha foi criado com os arquivos restantes.</x:String>

  <x:String x:Key="Text.Error.AllSourcesInaccessible" xml:space="preserve">Todos os arquivos de origem estavam inacessíveis, então a compactação foi abortada. Nenhum arquivo vazio foi criado.</x:String>
  <x:String x:Key="Text.Error.PasswordNotSupportedByFormat" xml:space="preserve">O formato {0} não oferece suporte à proteção por senha. Escolha ZIP ou 7z.</x:String>
  <x:String x:Key="Text.Error.ZipPasswordAsciiOnly" xml:space="preserve">Senhas ZIP podem conter apenas caracteres ASCII (letras, dígitos e símbolos). Para usar outros caracteres (como letras acentuadas ou japonês), escolha o formato 7z.</x:String>
</ResourceDictionary>

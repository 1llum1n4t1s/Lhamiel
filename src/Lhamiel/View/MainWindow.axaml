<Window
    x:Class="Lhamiel.View.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:input="using:Avalonia.Input"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:models="using:Lhamiel.Models"
    xmlns:sys="using:System"
    xmlns:vm="using:Lhamiel.ViewModels"
    x:CompileBindings="True"
    Title="{Binding VersionText, StringFormat='Lhamiel v{0}'}"
    Width="700"
    Height="600"
    input:DragDrop.AllowDrop="True"
    input:DragDrop.DragLeave="DropZone_DragLeave"
    input:DragDrop.DragOver="DropZone_DragOver"
    input:DragDrop.Drop="DropZone_Drop"
    x:DataType="vm:MainWindowViewModel"
    Background="Transparent"
    CanResize="False"

    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Panel>
        <!--  ウィンドウ背景：アクリルブラー  -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- 白いデスクトップが透けても文字とのコントラストを保つテーマ色のスクリム -->
        <Border
            Background="{DynamicResource Brush.Window}"
            IsHitTestVisible="False"
            Opacity="0.5" />
        <Grid>
            <!--  ═══ サイドバー + コンテンツ ═══  -->
            <TabControl Margin="16,36,16,16" Classes="sidebar">

                <!--  ━━━ 全般設定タブ ━━━  -->
                <!--
                  サイドバーのアイコンは Material Design Icons (Apache 2.0) の 24x24 パスを 16x16 で描画する。
                  PathIcon は親 TabItem の Foreground を継承するため、hover / selected の配色に自動追従する。
                  ヘッダーは Grid（Auto,*）にしてラベル列だけを可変にし、長い翻訳を省略記号で畳む。
                -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.General}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <!--  見出しアイコンはサイドバーと同じ MDI パスを使い、タブ切替で左右のアイコンが一致するようにする  -->
                            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Text.Settings.Tab.General}" />
                            </StackPanel>

                            <!--  テーマ選択  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Theme.Header}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding ThemeOptions}"
                                        SelectedValue="{Binding SelectedTheme}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:ThemeItem}"
                                        ToolTip.Tip="{DynamicResource Text.Settings.Theme.Tooltip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeItem">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  アプリアイコン選択  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.AppIcon.Header}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ComboBox
                                            Width="200"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding AppIconOptions}"
                                            SelectedValue="{Binding SelectedAppIconVariant}"
                                            SelectedValueBinding="{Binding Key, DataType=vm:AppIconOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AppIconOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Image
                                            Width="80"
                                            Height="80"
                                            RenderOptions.BitmapInterpolationMode="HighQuality"
                                            Source="{Binding AppIconPreview}"
                                            Stretch="Uniform" />
                                    </StackPanel>
                                    <TextBlock
                                        MaxWidth="420"
                                        Opacity="0.7"
                                        Text="{DynamicResource Text.Settings.AppIcon.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  言語選択  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Language.Header}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{x:Static vm:MainWindowViewModel.LocaleOptions}"
                                        SelectedValue="{Binding SelectedLocale}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:LocaleItem}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LocaleItem">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  圧縮形式  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.CompressionFormat.Header}">
                                <ComboBox
                                    x:Name="CompressionFormatComboBox"
                                    Width="120"
                                    ItemsSource="{Binding CompressionFormats}"
                                    SelectedItem="{Binding SelectedCompressionFormat}">
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                            </primitives:HeaderedContentControl>

                            <!--  アップデート確認  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Update.Header}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.Update.Check4UpdatesOnStartup}"
                                    IsChecked="{Binding Check4UpdatesOnStartup}" />
                            </primitives:HeaderedContentControl>

                            <!--  ショートカット作成  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Shortcut.Header}">
                                <Button
                                    x:Name="CreateShortcutButton"
                                    Command="{Binding CreateShortcutCommand}"
                                    Content="{DynamicResource Text.Settings.Shortcut.Create}" />
                            </primitives:HeaderedContentControl>

                            <!--  エクスプローラーの右クリックメニュー  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.ContextMenu.Header}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.ContextMenu.Enable}"
                                    IsChecked="{Binding AddToContextMenu}" />
                            </primitives:HeaderedContentControl>

                            <!--  説明テキスト  -->
                            <TextBlock
                                Margin="4,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="{DynamicResource Text.DropZone.Footer}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 展開用設定タブ ━━━  -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M5.12,5H18.87L17.93,4H5.93L5.12,5M20.54,5.23C20.83,5.57 21,6 21,6.5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V6.5C3,6 3.17,5.57 3.46,5.23L4.84,3.55C5.12,3.21 5.53,3 6,3H18C18.47,3 18.88,3.21 19.15,3.55L20.54,5.23M12,17.5L17.5,12H14V10H10V12H6.5L12,17.5Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.Extraction}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="M5.12,5H18.87L17.93,4H5.93L5.12,5M20.54,5.23C20.83,5.57 21,6 21,6.5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V6.5C3,6 3.17,5.57 3.46,5.23L4.84,3.55C5.12,3.21 5.53,3 6,3H18C18.47,3 18.88,3.21 19.15,3.55L20.54,5.23M12,17.5L17.5,12H14V10H10V12H6.5L12,17.5Z" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Text.Settings.Tab.Extraction}" />
                            </StackPanel>
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Output.Header}">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="ExtractionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SameDirectory}"
                                        IsChecked="{Binding ExtractionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="ExtractionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SpecifyDirectory}"
                                        IsChecked="{Binding ExtractionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ExtractionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding ExtractionOutputDirectory}" />
                                        <Button
                                            x:Name="ExtractionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseExtractionCommand}"
                                            Content="{DynamicResource Text.Settings.Output.Browse}"
                                            ToolTip.Tip="{DynamicResource Text.Settings.Output.BrowseExtraction}" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenExtractionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="{DynamicResource Text.Settings.Extraction.OpenFolder}"
                                        IsChecked="{Binding OpenExtractionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Extraction.OptionHeader}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.Extraction.CreateFolder}"
                                    IsChecked="{Binding CreateArchiveNameFolder}" />
                            </primitives:HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 圧縮用設定タブ ━━━  -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M20.54,5.23C20.83,5.57 21,6 21,6.5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V6.5C3,6 3.17,5.57 3.46,5.23L4.84,3.55C5.12,3.21 5.53,3 6,3H18C18.47,3 18.88,3.21 19.15,3.55L20.54,5.23M5.12,5H18.87L17.93,4H5.93L5.12,5M12,9.5L6.5,15H10V17H14V15H17.5L12,9.5Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.Compression}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="M20.54,5.23C20.83,5.57 21,6 21,6.5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V6.5C3,6 3.17,5.57 3.46,5.23L4.84,3.55C5.12,3.21 5.53,3 6,3H18C18.47,3 18.88,3.21 19.15,3.55L20.54,5.23M5.12,5H18.87L17.93,4H5.93L5.12,5M12,9.5L6.5,15H10V17H14V15H17.5L12,9.5Z" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Text.Settings.Tab.Compression}" />
                            </StackPanel>
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Output.Header}">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="CompressionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SameDirectory}"
                                        IsChecked="{Binding CompressionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="CompressionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SpecifyDirectory}"
                                        IsChecked="{Binding CompressionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CompressionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding CompressionOutputDirectory}" />
                                        <Button
                                            x:Name="CompressionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseCompressionCommand}"
                                            Content="{DynamicResource Text.Settings.Output.Browse}"
                                            ToolTip.Tip="{DynamicResource Text.Settings.Output.BrowseCompression}" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenCompressionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="{DynamicResource Text.Settings.Compression.OpenFolder}"
                                        IsChecked="{Binding OpenCompressionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.OptionHeader}">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="{DynamicResource Text.Settings.Compression.MergeOption}" IsChecked="{Binding CompressMultipleAsOne}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.MergeDescription}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        Content="{DynamicResource Text.Settings.Compression.IncludeHiddenAndSystem}"
                                        IsChecked="{Binding IncludeHiddenAndSystemEntries}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.IncludeHiddenAndSystemDescription}"
                                        TextWrapping="Wrap" />

                                    <Separator Margin="0,4" />

                                    <RadioButton
                                        x:Name="DirModeIncludeRoot"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.IncludeRoot}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="0" />
                                    <RadioButton
                                        x:Name="DirModeExcludeRoot"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.ExcludeRoot}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="1" />
                                    <RadioButton
                                        x:Name="DirModeFlat"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.Flat}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="2" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.LevelHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="{DynamicResource Text.Settings.Compression.ZipLevel}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="{DynamicResource Text.Settings.Compression.SevenZipLevel}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedSevenZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </primitives:HeaderedContentControl>

                            <!--  パスワード保護 (v1.0.181+)  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.PasswordHeader}">
                                <StackPanel Spacing="8">
                                    <!--  親チェックボックス (TAR では IsEnabled=false)  -->
                                    <CheckBox
                                        x:Name="EnablePasswordCheckBox"
                                        Content="{DynamicResource Text.Settings.Compression.EnablePassword}"
                                        IsChecked="{Binding IsPasswordProtectionEnabled}"
                                        IsEnabled="{Binding IsZipOrSevenZipFormat}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.EnablePasswordDescription}"
                                        TextWrapping="Wrap" />

                                    <!--  TAR 警告 (format = TAR のときだけ表示)  -->
                                    <TextBlock
                                        Margin="28,-2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                        IsVisible="{Binding IsTarFormat}"
                                        Text="{DynamicResource Text.Settings.Compression.TarNoEncryptionNote}"
                                        TextWrapping="Wrap" />

                                    <!--  ZIP Explorer 非互換注意 (format = ZIP かつ ON のときだけ表示)  -->
                                    <TextBlock
                                        Margin="28,-2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        IsVisible="{Binding ShowZipExplorerWarning}"
                                        Text="{DynamicResource Text.Settings.Compression.ZipAesExplorerNote}"
                                        TextWrapping="Wrap" />

                                    <!--  サブパネル: ON + format が ZIP/7z のときのみ可視  -->
                                    <StackPanel
                                        Margin="24,4,0,0"
                                        IsVisible="{Binding IsPasswordSubPanelVisible}"
                                        Spacing="6">

                                        <!--  ファイル名暗号化 (7z 専用、ZIP では disabled + 説明)  -->
                                        <CheckBox
                                            x:Name="EncryptFileNamesCheckBox"
                                            Content="{DynamicResource Text.Settings.Compression.EncryptFileNames}"
                                            IsChecked="{Binding EncryptFileNames}"
                                            IsEnabled="{Binding EncryptFileNamesEnabled}" />
                                        <TextBlock
                                            Margin="28,-4,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            Text="{DynamicResource Text.Settings.Compression.EncryptFileNamesDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="28,-2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            IsVisible="{Binding IsZipFormatAndPasswordOn}"
                                            Text="{DynamicResource Text.Settings.Compression.EncryptFileNamesZipUnsupported}"
                                            TextWrapping="Wrap" />

                                        <Separator Margin="0,4,0,4" />

                                        <!--  パスワード入力モード  -->
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Text.Settings.Compression.PasswordMode.GroupLabel}" />
                                        <RadioButton
                                            x:Name="PromptEachTimeRadio"
                                            Content="{DynamicResource Text.Settings.Compression.PasswordMode.PromptEachTime}"
                                            GroupName="PasswordMode"
                                            IsCheckedChanged="PasswordModeRadio_Changed"
                                            Tag="PromptEachTime" />
                                        <RadioButton
                                            x:Name="RememberPasswordRadio"
                                            Content="{DynamicResource Text.Settings.Compression.PasswordMode.Remember}"
                                            GroupName="PasswordMode"
                                            IsCheckedChanged="PasswordModeRadio_Changed"
                                            Tag="Remember" />

                                        <!--  保存済みパスワードの状態 + 変更/削除ボタン (Remember モード時のみ)  -->
                                        <StackPanel
                                            Margin="24,4,0,0"
                                            IsVisible="{Binding IsRememberModeActive}"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource Brush.FG2}"
                                                Text="{Binding SavedPasswordStatusText}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    Command="{Binding ChangeSavedPasswordCommand}"
                                                    Content="{DynamicResource Text.Settings.Compression.ChangeSavedPassword}" />
                                                <Button
                                                    Command="{Binding ClearSavedPasswordCommand}"
                                                    Content="{DynamicResource Text.Settings.Compression.ClearSavedPassword}"
                                                    IsEnabled="{Binding HasSavedPassword}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 圧縮除外設定タブ ━━━  -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M12 2C17.5 2 22 6.5 22 12S17.5 22 12 22 2 17.5 2 12 6.5 2 12 2M12 4C10.1 4 8.4 4.6 7.1 5.7L18.3 16.9C19.3 15.5 20 13.8 20 12C20 7.6 16.4 4 12 4M16.9 18.3L5.7 7.1C4.6 8.4 4 10.1 4 12C4 16.4 7.6 20 12 20C13.9 20 15.6 19.4 16.9 18.3Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.CompressionExclusions}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="M12 2C17.5 2 22 6.5 22 12S17.5 22 12 22 2 17.5 2 12 6.5 2 12 2M12 4C10.1 4 8.4 4.6 7.1 5.7L18.3 16.9C19.3 15.5 20 13.8 20 12C20 7.6 16.4 4 12 4M16.9 18.3L5.7 7.1C4.6 8.4 4 10.1 4 12C4 16.4 7.6 20 12 20C13.9 20 15.6 19.4 16.9 18.3Z" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Text.Settings.Tab.CompressionExclusions}" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.ExcludedPatterns.Description}"
                                        TextWrapping="Wrap" />

                                    <!--  全圧縮へ直接適用する共通ルール  -->
                                    <Border
                                        Padding="12"
                                        Background="{DynamicResource Brush.Container}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Text.Settings.ExcludedPatterns.Global.Header}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource Brush.FG2}"
                                                Text="{DynamicResource Text.Settings.ExcludedPatterns.Global.Description}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{DynamicResource Brush.FG2}"
                                                Text="{DynamicResource Text.Settings.ExcludedPatterns.Global.Path}"
                                                TextWrapping="Wrap" />

                                            <ListBox
                                                Height="180"
                                                ItemsSource="{Binding CompressionExcludedFilePatterns}"
                                                SelectedItem="{Binding SelectedExcludedFilePattern}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="sys:String">
                                                        <TextBlock Text="{Binding .}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    VerticalContentAlignment="Center"
                                                    PlaceholderText="{DynamicResource Text.Settings.ExcludedPatterns.Placeholder}"
                                                    Text="{Binding NewExcludedFilePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding AddExcludedPatternCommand}"
                                                    Content="{DynamicResource Text.Settings.ExcludedPatterns.Add}" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Command="{Binding OpenExcludedPatternsFileCommand}"
                                                    Content="{DynamicResource Text.Settings.ExcludedPatterns.OpenFile}"
                                                    ToolTip.Tip="{DynamicResource Text.Settings.ExcludedPatterns.OpenFile.Tip}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding RemoveExcludedPatternCommand}"
                                                    Content="{DynamicResource Text.Settings.ExcludedPatterns.Remove}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Command="{Binding ResetExcludedPatternsCommand}"
                                                    Content="{DynamicResource Text.Settings.ExcludedPatterns.Reset}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  読み込み方針はグローバル、ルール内容は圧縮元フォルダー別  -->
                                    <Border
                                        Padding="12"
                                        Background="{DynamicResource Brush.Container}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Text.Settings.ExcludedPatterns.Folder.Header}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource Brush.FG2}"
                                                Text="{DynamicResource Text.Settings.ExcludedPatterns.Folder.Description}"
                                                TextWrapping="Wrap" />
                                            <CheckBox
                                                Content="{DynamicResource Text.Settings.ExcludedPatterns.RespectGitignore}"
                                                IsChecked="{Binding RespectNestedGitignore}"
                                                ToolTip.Tip="{DynamicResource Text.Settings.ExcludedPatterns.RespectGitignore.Tip}" />

                                            <StackPanel
                                                IsEnabled="{Binding RespectNestedGitignore}"
                                                Spacing="6">
                                                <TextBlock Text="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Label}" />
                                                <TextBox
                                                    MinHeight="88"
                                                    AcceptsReturn="True"
                                                    PlaceholderText="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Placeholder}"
                                                    Text="{Binding SourceIgnoreFileNamesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip.Tip="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Tip}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.FG2}"
                                                    Text="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Tip}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="Red"
                                                    IsVisible="{Binding HasInvalidSourceIgnoreFileNames}"
                                                    Text="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Invalid}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.FG2}"
                                                    Text="{DynamicResource Text.Settings.ExcludedPatterns.SourceFileNames.Notice}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 関連付け設定タブ ━━━  -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.Association}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                                <PathIcon
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Text.Settings.Tab.Association}" />
                            </StackPanel>

                            <primitives:HeaderedContentControl
                                Margin="0,0,0,12"
                                Header="{DynamicResource Text.Settings.Association.IconHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox
                                        Width="200"
                                        VerticalAlignment="Top"
                                        ItemsSource="{Binding FileIconOptions}"
                                        SelectedValue="{Binding SelectedFileIconVariant}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:FileIconOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileIconOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!--  選択中バリアントのサンプルプレビュー（128px 取得を 80px 論理サイズで表示）。
                                          負マージンでヘッダー行の右側余白まで引き上げ、カードの間延びを防ぐ
                                          （-28 = ヘッダー TextBlock 高さ ~18px + ヘッダー下マージン 10px）  -->
                                    <Image
                                        Width="80"
                                        Height="80"
                                        Margin="0,-28,0,0"
                                        VerticalAlignment="Top"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        Source="{Binding FileIconPreview}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  全選択 / 全解除  -->
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="SelectAllButton"
                                    Command="{Binding SelectAllAssociationsCommand}"
                                    Content="{DynamicResource Text.Settings.Association.SelectAll}" />
                                <Button
                                    x:Name="DeselectAllButton"
                                    Command="{Binding DeselectAllAssociationsCommand}"
                                    Content="{DynamicResource Text.Settings.Association.DeselectAll}" />
                            </StackPanel>

                            <!--  Apple 式カード内リスト  -->
                            <Border
                                Padding="4,0"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <ItemsControl ItemsSource="{Binding Associations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileAssociationItem">
                                            <Border
                                                Padding="12,8"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Text="{Binding Description}" />
                                                    <ToggleSwitch
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsAssociated}"
                                                        OffContent=""
                                                        OnContent="" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ バージョン情報タブ ━━━  -->
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Text.Sidebar.Version}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,12">
                            <!--  アプリアイコン + タイトル (横並び)  -->
                            <StackPanel
                                Margin="4,0,0,20"
                                Orientation="Horizontal">
                                <Image
                                    Width="64"
                                    Height="64"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    Source="{Binding AppIconPreview}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="Lhamiel" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Description}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  バージョン情報パネル  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Label}" />
                                    <TextBlock
                                        x:Name="VersionTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding VersionText}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Command="{Binding CheckForUpdateCommand}"
                                        Content="{DynamicResource Text.Version.CheckUpdate}"
                                        FontSize="12"
                                        IsEnabled="{Binding !IsCheckingUpdate}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.SevenZipLabel}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding SevenZipVersionText}" />
                                    <Grid
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding HasIgnoredUpdateTag}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            Text="{Binding IgnoredUpdateTagDisplay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding ClearIgnoredUpdateTagCommand}"
                                            Content="{DynamicResource Text.Settings.Version.ClearSkippedVersion}"
                                            FontSize="12" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--  お問い合わせ  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Feedback.Description}" />
                                    <Button
                                        Command="{Binding OpenSupportCommand}"
                                        Content="{DynamicResource Text.Version.Feedback.Button}"
                                        FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!--  コピーライト  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource Text.Version.Copyright}" />
                                    <TextBlock
                                        x:Name="CopyrightTextBlock"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{Binding CopyrightText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ライセンス  -->
                            <Border
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource Text.Version.License}" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="MIT License" />
                                    <TextBlock
                                        x:Name="LicenseTextBlock"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        LineHeight="16"
                                        Text="{Binding LicenseText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </Grid>

        <!--  ═══ デバッグ用トリプルクリックエリア（右下隅、DEBUG ビルドのみ有効） ═══  -->
        <Border
            x:Name="DebugTapArea"
            Width="48"
            Height="48"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            IsVisible="False" />

        <!--  ═══ ドラッグオーバーレイ（ドラッグ中のみ表示） ═══  -->
        <Border
            x:Name="DropOverlay"
            Background="#1C1C1E"
            CornerRadius="8"
            IsHitTestVisible="False"
            IsVisible="False">
            <Border
                Margin="24"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1.5"
                CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Text="📁" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        Text="{DynamicResource Text.DropZone.Message}" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

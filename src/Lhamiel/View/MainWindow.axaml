<Window
    x:Class="Lhamiel.View.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:input="using:Avalonia.Input"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:models="using:Lhamiel.Models"
    xmlns:sys="using:System"
    xmlns:vm="using:Lhamiel.ViewModels"
    x:CompileBindings="True"
    Title="{Binding VersionText, StringFormat='Lhamiel v{0}'}"
    Width="700"
    Height="600"
    input:DragDrop.AllowDrop="True"
    input:DragDrop.DragLeave="DropZone_DragLeave"
    input:DragDrop.DragOver="DropZone_DragOver"
    input:DragDrop.Drop="DropZone_Drop"
    x:DataType="vm:MainWindowViewModel"
    Background="Transparent"
    CanResize="False"

    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Panel>
        <!--  ウィンドウ背景：アクリルブラー  -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintOpacity="0.4"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <Grid>
            <!--  ═══ サイドバー + コンテンツ ═══  -->
            <TabControl Margin="16,36,16,16" Classes="sidebar">

                <!--  ━━━ 全般設定タブ ━━━  -->
                <TabItem Header="{DynamicResource Text.Sidebar.General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <TextBlock
                                Margin="4,0,0,12"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Text.Settings.Tab.General}" />

                            <!--  テーマ選択  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Theme.Header}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding ThemeOptions}"
                                        SelectedValue="{Binding SelectedTheme}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:ThemeItem}"
                                        ToolTip.Tip="{DynamicResource Text.Settings.Theme.Tooltip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeItem">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  言語選択  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Language.Header}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{x:Static vm:MainWindowViewModel.LocaleOptions}"
                                        SelectedValue="{Binding SelectedLocale}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:LocaleItem}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LocaleItem">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  圧縮形式  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.CompressionFormat.Header}">
                                <ComboBox
                                    x:Name="CompressionFormatComboBox"
                                    Width="120"
                                    ItemsSource="{Binding CompressionFormats}"
                                    SelectedItem="{Binding SelectedCompressionFormat}">
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                            </primitives:HeaderedContentControl>

                            <!--  アップデート確認  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Update.Header}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.Update.Check4UpdatesOnStartup}"
                                    IsChecked="{Binding Check4UpdatesOnStartup}" />
                            </primitives:HeaderedContentControl>

                            <!--  ショートカット作成  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Shortcut.Header}">
                                <Button
                                    x:Name="CreateShortcutButton"
                                    Command="{Binding CreateShortcutCommand}"
                                    Content="{DynamicResource Text.Settings.Shortcut.Create}" />
                            </primitives:HeaderedContentControl>

                            <!--  エクスプローラーの右クリックメニュー  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.ContextMenu.Header}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.ContextMenu.Enable}"
                                    IsChecked="{Binding AddToContextMenu}" />
                            </primitives:HeaderedContentControl>

                            <!--  説明テキスト  -->
                            <TextBlock
                                Margin="4,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="{DynamicResource Text.DropZone.Footer}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 展開用設定タブ ━━━  -->
                <TabItem Header="{DynamicResource Text.Sidebar.Extraction}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <TextBlock
                                Margin="4,0,0,12"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Text.Settings.Tab.Extraction}" />
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Output.Header}">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="ExtractionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SameDirectory}"
                                        IsChecked="{Binding ExtractionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="ExtractionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SpecifyDirectory}"
                                        IsChecked="{Binding ExtractionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ExtractionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding ExtractionOutputDirectory}" />
                                        <Button
                                            x:Name="ExtractionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseExtractionCommand}"
                                            Content="{DynamicResource Text.Settings.Output.Browse}"
                                            ToolTip.Tip="{DynamicResource Text.Settings.Output.BrowseExtraction}" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenExtractionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="{DynamicResource Text.Settings.Extraction.OpenFolder}"
                                        IsChecked="{Binding OpenExtractionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Extraction.OptionHeader}">
                                <CheckBox
                                    Content="{DynamicResource Text.Settings.Extraction.CreateFolder}"
                                    IsChecked="{Binding CreateArchiveNameFolder}" />
                            </primitives:HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 圧縮用設定タブ ━━━  -->
                <TabItem Header="{DynamicResource Text.Sidebar.Compression}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <TextBlock
                                Margin="4,0,0,12"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Text.Settings.Tab.Compression}" />
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Output.Header}">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="CompressionOutputToSameDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SameDirectory}"
                                        IsChecked="{Binding CompressionOutputToSameDirectory}" />
                                    <RadioButton
                                        x:Name="CompressionOutputToDirectoryRadio"
                                        Margin="0,4"
                                        Content="{DynamicResource Text.Settings.Output.SpecifyDirectory}"
                                        IsChecked="{Binding CompressionOutputToDirectory}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CompressionOutputPathTextBox"
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding CompressionOutputDirectory}" />
                                        <Button
                                            x:Name="CompressionBrowseButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseCompressionCommand}"
                                            Content="{DynamicResource Text.Settings.Output.Browse}"
                                            ToolTip.Tip="{DynamicResource Text.Settings.Output.BrowseCompression}" />
                                    </Grid>

                                    <CheckBox
                                        x:Name="OpenCompressionOutputFolderCheckBox"
                                        Margin="0,12,0,0"
                                        Content="{DynamicResource Text.Settings.Compression.OpenFolder}"
                                        IsChecked="{Binding OpenCompressionOutputFolder}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.OptionHeader}">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="{DynamicResource Text.Settings.Compression.MergeOption}" IsChecked="{Binding CompressMultipleAsOne}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.MergeDescription}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        Content="{DynamicResource Text.Settings.Compression.IncludeHiddenAndSystem}"
                                        IsChecked="{Binding IncludeHiddenAndSystemEntries}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.IncludeHiddenAndSystemDescription}"
                                        TextWrapping="Wrap" />

                                    <Separator Margin="0,4" />

                                    <RadioButton
                                        x:Name="DirModeIncludeRoot"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.IncludeRoot}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="0" />
                                    <RadioButton
                                        x:Name="DirModeExcludeRoot"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.ExcludeRoot}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="1" />
                                    <RadioButton
                                        x:Name="DirModeFlat"
                                        Content="{DynamicResource Text.Settings.Compression.DirMode.Flat}"
                                        GroupName="DirStructureMode"
                                        IsCheckedChanged="DirModeRadio_Changed"
                                        Tag="2" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.LevelHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="{DynamicResource Text.Settings.Compression.ZipLevel}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="13"
                                            Text="{DynamicResource Text.Settings.Compression.SevenZipLevel}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding CompressionLevels}"
                                            SelectedItem="{Binding SelectedSevenZipLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompressionLevelItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </primitives:HeaderedContentControl>

                            <!--  パスワード保護 (v1.0.181+)  -->
                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.Compression.PasswordHeader}">
                                <StackPanel Spacing="8">
                                    <!--  親チェックボックス (TAR では IsEnabled=false)  -->
                                    <CheckBox
                                        x:Name="EnablePasswordCheckBox"
                                        Content="{DynamicResource Text.Settings.Compression.EnablePassword}"
                                        IsChecked="{Binding IsPasswordProtectionEnabled}"
                                        IsEnabled="{Binding IsZipOrSevenZipFormat}" />
                                    <TextBlock
                                        Margin="28,-4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.Compression.EnablePasswordDescription}"
                                        TextWrapping="Wrap" />

                                    <!--  TAR 警告 (format = TAR のときだけ表示)  -->
                                    <TextBlock
                                        Margin="28,-2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                        IsVisible="{Binding IsTarFormat}"
                                        Text="{DynamicResource Text.Settings.Compression.TarNoEncryptionNote}"
                                        TextWrapping="Wrap" />

                                    <!--  ZIP Explorer 非互換注意 (format = ZIP かつ ON のときだけ表示)  -->
                                    <TextBlock
                                        Margin="28,-2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        IsVisible="{Binding ShowZipExplorerWarning}"
                                        Text="{DynamicResource Text.Settings.Compression.ZipAesExplorerNote}"
                                        TextWrapping="Wrap" />

                                    <!--  サブパネル: ON + format が ZIP/7z のときのみ可視  -->
                                    <StackPanel
                                        Margin="24,4,0,0"
                                        IsVisible="{Binding IsPasswordSubPanelVisible}"
                                        Spacing="6">

                                        <!--  ファイル名暗号化 (7z 専用、ZIP では disabled + 説明)  -->
                                        <CheckBox
                                            x:Name="EncryptFileNamesCheckBox"
                                            Content="{DynamicResource Text.Settings.Compression.EncryptFileNames}"
                                            IsChecked="{Binding EncryptFileNames}"
                                            IsEnabled="{Binding EncryptFileNamesEnabled}" />
                                        <TextBlock
                                            Margin="28,-4,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            Text="{DynamicResource Text.Settings.Compression.EncryptFileNamesDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="28,-2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            IsVisible="{Binding IsZipFormatAndPasswordOn}"
                                            Text="{DynamicResource Text.Settings.Compression.EncryptFileNamesZipUnsupported}"
                                            TextWrapping="Wrap" />

                                        <Separator Margin="0,4,0,4" />

                                        <!--  パスワード入力モード  -->
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Text.Settings.Compression.PasswordMode.GroupLabel}" />
                                        <RadioButton
                                            x:Name="PromptEachTimeRadio"
                                            Content="{DynamicResource Text.Settings.Compression.PasswordMode.PromptEachTime}"
                                            GroupName="PasswordMode"
                                            IsCheckedChanged="PasswordModeRadio_Changed"
                                            Tag="PromptEachTime" />
                                        <RadioButton
                                            x:Name="RememberPasswordRadio"
                                            Content="{DynamicResource Text.Settings.Compression.PasswordMode.Remember}"
                                            GroupName="PasswordMode"
                                            IsCheckedChanged="PasswordModeRadio_Changed"
                                            Tag="Remember" />

                                        <!--  保存済みパスワードの状態 + 変更/削除ボタン (Remember モード時のみ)  -->
                                        <StackPanel
                                            Margin="24,4,0,0"
                                            IsVisible="{Binding IsRememberModeActive}"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource Brush.FG2}"
                                                Text="{Binding SavedPasswordStatusText}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    Command="{Binding ChangeSavedPasswordCommand}"
                                                    Content="{DynamicResource Text.Settings.Compression.ChangeSavedPassword}" />
                                                <Button
                                                    Command="{Binding ClearSavedPasswordCommand}"
                                                    Content="{DynamicResource Text.Settings.Compression.ClearSavedPassword}"
                                                    IsEnabled="{Binding HasSavedPassword}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <primitives:HeaderedContentControl Header="{DynamicResource Text.Settings.ExcludedPatterns.Header}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Settings.ExcludedPatterns.Description}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        Content="{DynamicResource Text.Settings.ExcludedPatterns.RespectGitignore}"
                                        IsChecked="{Binding RespectNestedGitignore}"
                                        ToolTip.Tip="{DynamicResource Text.Settings.ExcludedPatterns.RespectGitignore.Tip}" />

                                    <ListBox
                                        Height="220"
                                        ItemsSource="{Binding CompressionExcludedFilePatterns}"
                                        SelectedItem="{Binding SelectedExcludedFilePattern}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding .}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            VerticalContentAlignment="Center"
                                            PlaceholderText="{DynamicResource Text.Settings.ExcludedPatterns.Placeholder}"
                                            Text="{Binding NewExcludedFilePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddExcludedPatternCommand}"
                                            Content="{DynamicResource Text.Settings.ExcludedPatterns.Add}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding OpenExcludedPatternsFileCommand}"
                                            Content="{DynamicResource Text.Settings.ExcludedPatterns.OpenFile}"
                                            ToolTip.Tip="{DynamicResource Text.Settings.ExcludedPatterns.OpenFile.Tip}" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Command="{Binding RemoveExcludedPatternCommand}"
                                            Content="{DynamicResource Text.Settings.ExcludedPatterns.Remove}" />
                                        <Button
                                            Grid.Column="3"
                                            Command="{Binding ResetExcludedPatternsCommand}"
                                            Content="{DynamicResource Text.Settings.ExcludedPatterns.Reset}" />
                                    </Grid>
                                </StackPanel>
                            </primitives:HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ 関連付け設定タブ ━━━  -->
                <TabItem Header="{DynamicResource Text.Sidebar.Association}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <TextBlock
                                Margin="4,0,0,12"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Text.Settings.Tab.Association}" />

                            <primitives:HeaderedContentControl
                                Margin="0,0,0,12"
                                Header="{DynamicResource Text.Settings.Association.IconHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox
                                        Width="200"
                                        VerticalAlignment="Top"
                                        ItemsSource="{Binding FileIconOptions}"
                                        SelectedValue="{Binding SelectedFileIconVariant}"
                                        SelectedValueBinding="{Binding Key, DataType=vm:FileIconOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileIconOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!--  選択中バリアントのサンプルプレビュー（128px 取得を 80px 論理サイズで表示）。
                                          負マージンでヘッダー行の右側余白まで引き上げ、カードの間延びを防ぐ
                                          （-28 = ヘッダー TextBlock 高さ ~18px + ヘッダー下マージン 10px）  -->
                                    <Image
                                        Width="80"
                                        Height="80"
                                        Margin="0,-28,0,0"
                                        VerticalAlignment="Top"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        Source="{Binding FileIconPreview}" />
                                </StackPanel>
                            </primitives:HeaderedContentControl>

                            <!--  全選択 / 全解除  -->
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="SelectAllButton"
                                    Command="{Binding SelectAllAssociationsCommand}"
                                    Content="{DynamicResource Text.Settings.Association.SelectAll}" />
                                <Button
                                    x:Name="DeselectAllButton"
                                    Command="{Binding DeselectAllAssociationsCommand}"
                                    Content="{DynamicResource Text.Settings.Association.DeselectAll}" />
                            </StackPanel>

                            <!--  Apple 式カード内リスト  -->
                            <Border
                                Padding="4,0"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <ItemsControl ItemsSource="{Binding Associations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileAssociationItem">
                                            <Border
                                                Padding="12,8"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Text="{Binding Description}" />
                                                    <ToggleSwitch
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsAssociated}"
                                                        OffContent=""
                                                        OnContent="" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ━━━ バージョン情報タブ ━━━  -->
                <TabItem Header="{DynamicResource Text.Sidebar.Version}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,12">
                            <!--  アプリアイコン + タイトル (横並び)  -->
                            <StackPanel
                                Margin="4,0,0,20"
                                Orientation="Horizontal">
                                <Image
                                    Width="64"
                                    Height="64"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    Source="avares://Lhamiel/icon/app_icon.png" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="Lhamiel" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Description}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  バージョン情報パネル  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Label}" />
                                    <TextBlock
                                        x:Name="VersionTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding VersionText}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Command="{Binding CheckForUpdateCommand}"
                                        Content="{DynamicResource Text.Version.CheckUpdate}"
                                        FontSize="12"
                                        IsEnabled="{Binding !IsCheckingUpdate}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.SevenZipLabel}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding SevenZipVersionText}" />
                                    <Grid
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding HasIgnoredUpdateTag}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.FG2}"
                                            Text="{Binding IgnoredUpdateTagDisplay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding ClearIgnoredUpdateTagCommand}"
                                            Content="{DynamicResource Text.Settings.Version.ClearSkippedVersion}"
                                            FontSize="12" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--  ご意見・ご要望  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{DynamicResource Text.Version.Feedback.Description}" />
                                    <Button
                                        Command="{Binding OpenFeedbackLinkCommand}"
                                        Content="{DynamicResource Text.Version.Feedback.Button}"
                                        FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!--  コピーライト  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource Text.Version.Copyright}" />
                                    <TextBlock
                                        x:Name="CopyrightTextBlock"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="{Binding CopyrightText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ライセンス  -->
                            <Border
                                Padding="16"
                                Background="{DynamicResource Brush.Container}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource Text.Version.License}" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        Text="MIT License" />
                                    <TextBlock
                                        x:Name="LicenseTextBlock"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.FG2}"
                                        LineHeight="16"
                                        Text="{Binding LicenseText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </Grid>

        <!--  ═══ デバッグ用トリプルクリックエリア（右下隅、DEBUG ビルドのみ有効） ═══  -->
        <Border
            x:Name="DebugTapArea"
            Width="48"
            Height="48"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            IsVisible="False" />

        <!--  ═══ ドラッグオーバーレイ（ドラッグ中のみ表示） ═══  -->
        <Border
            x:Name="DropOverlay"
            Background="#1C1C1E"
            CornerRadius="8"
            IsHitTestVisible="False"
            IsVisible="False">
            <Border
                Margin="24"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1.5"
                CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Text="📁" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        Text="{DynamicResource Text.DropZone.Message}" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

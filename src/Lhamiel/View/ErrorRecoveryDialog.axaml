<Window
    x:Class="Lhamiel.View.ErrorRecoveryDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:view="using:Lhamiel.View"
    Title="{DynamicResource Text.ErrorRecovery.Title}"
    Width="600"
    Height="500"
    x:DataType="view:ErrorRecoveryDialog"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaChromeHints="PreferSystemChrome"
    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterOwner">
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    MaterialOpacity="0.65"
                    TintColor="{DynamicResource Color.Window}"
                    TintOpacity="0.8" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
    <Grid Margin="20,40,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  エラー情報  -->
        <primitives:HeaderedContentControl
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="{DynamicResource Text.ErrorRecovery.ErrorInfo}">
            <StackPanel Margin="10">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="Red"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Text="{Binding ErrorDetails}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="Blue"
                    Text="{Binding RecommendedAction}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!--  ファイル情報  -->
        <primitives:HeaderedContentControl
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="{DynamicResource Text.ErrorRecovery.ProblematicFile}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="5"
                    FontWeight="Bold"
                    Text="{Binding ProblematicFilePath}"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Grid.Row="1"
                    Margin="5"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Text="{Binding FileDetails}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </primitives:HeaderedContentControl>

        <!--  回復オプション  -->
        <primitives:HeaderedContentControl
            Grid.Row="2"
            Margin="0,0,0,10"
            Header="{DynamicResource Text.ErrorRecovery.RecoveryOptions}">
            <StackPanel Margin="10">
                <RadioButton
                    x:Name="SkipFileRadio"
                    Margin="0,2"
                    Content="{DynamicResource Text.ErrorRecovery.SkipAndContinue}"
                    IsChecked="True" />
                <RadioButton
                    x:Name="RetryRadio"
                    Margin="0,2"
                    Content="{DynamicResource Text.ErrorRecovery.Retry}" />
                <RadioButton
                    x:Name="StopRadio"
                    Margin="0,2"
                    Content="{DynamicResource Text.ErrorRecovery.StopExtraction}" />
                <RadioButton
                    x:Name="SkipAllRadio"
                    Margin="0,2"
                    Content="{DynamicResource Text.ErrorRecovery.SkipAllErrors}" />

                <CheckBox
                    x:Name="RememberChoiceCheck"
                    Margin="0,10,0,0"
                    Content="{DynamicResource Text.ErrorRecovery.RememberChoice}"
                    IsChecked="False" />
            </StackPanel>
        </primitives:HeaderedContentControl>

        <!--  ボタン  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="OkButton"
                Width="80"
                Height="30"
                Margin="5,0"
                Click="OkButton_Click"
                Content="{DynamicResource Text.Button.OK}" />
            <Button
                x:Name="CancelButton"
                Width="80"
                Height="30"
                Margin="5,0"
                Click="CancelButton_Click"
                Content="{DynamicResource Text.Button.Cancel}" />
        </StackPanel>
    </Grid>
    </Panel>
</Window>

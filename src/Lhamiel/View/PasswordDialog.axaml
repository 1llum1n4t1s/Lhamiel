<Window
    x:Class="Lhamiel.View.PasswordDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="using:Lhamiel.View"
    Width="480"
    SizeToContent="Height"
    x:DataType="view:PasswordDialog"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterOwner">
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- 白いデスクトップが透けても文字とのコントラストを保つテーマ色のスクリム -->
        <Border
            Background="{DynamicResource Brush.Window}"
            IsHitTestVisible="False"
            Opacity="0.5" />
        <Grid Margin="20,40,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Extract モードの説明  -->
            <TextBlock
                x:Name="ExtractMessage"
                Grid.Row="0"
                Margin="0,0,0,8"
                Text="{DynamicResource Text.Password.Message}"
                TextWrapping="Wrap" />

            <!--  CompressNew モードの説明  -->
            <TextBlock
                x:Name="CompressNewMessage"
                Grid.Row="0"
                Margin="0,0,0,8"
                IsVisible="False"
                Text="{DynamicResource Text.Password.SetMessage}"
                TextWrapping="Wrap" />

            <!--  ファイル名  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontWeight="Bold"
                Text="{Binding ArchiveName}"
                TextWrapping="Wrap" />

            <!--  リトライ時の警告メッセージ  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,8"
                FontSize="12"
                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                IsVisible="{Binding IsRetry}"
                Text="{DynamicResource Text.Password.WrongPasswordRetry}"
                TextWrapping="Wrap" />

            <!--  パスワード入力  -->
            <TextBox
                x:Name="PasswordBox"
                Grid.Row="3"
                Margin="0,0,0,8"
                KeyDown="PasswordBox_KeyDown"
                PasswordChar="●"
                PlaceholderText="{DynamicResource Text.Password.Placeholder}"
                TabIndex="0" />

            <!--  確認入力 (CompressNew モードのみ表示)  -->
            <TextBox
                x:Name="ConfirmBox"
                Grid.Row="4"
                Margin="0,0,0,8"
                IsVisible="False"
                KeyDown="ConfirmBox_KeyDown"
                PasswordChar="●"
                PlaceholderText="{DynamicResource Text.Password.ConfirmPlaceholder}"
                TabIndex="1" />

            <!--  Confirm 不一致警告 (初期非表示、code-behind で toggle)  -->
            <TextBlock
                x:Name="MismatchWarning"
                Grid.Row="5"
                Margin="0,0,0,4"
                FontSize="12"
                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                IsVisible="False"
                Text="{DynamicResource Text.Password.MismatchWarning}"
                TextWrapping="Wrap" />

            <!--  空パスワード警告 (初期非表示、code-behind で toggle)  -->
            <TextBlock
                x:Name="EmptyWarning"
                Grid.Row="6"
                Margin="0,0,0,8"
                FontSize="12"
                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                IsVisible="False"
                Text="{DynamicResource Text.Password.EmptyPasswordWarning}"
                TextWrapping="Wrap" />

            <!--  短すぎるパスワード警告 (初期非表示、code-behind で toggle)  -->
            <TextBlock
                x:Name="TooShortWarning"
                Grid.Row="6"
                Margin="0,0,0,8"
                FontSize="12"
                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                IsVisible="False"
                Text="{DynamicResource Text.Password.TooShortWarning}"
                TextWrapping="Wrap" />

            <!--  ボタン  -->
            <StackPanel
                Grid.Row="7"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    MinWidth="100"
                    Height="30"
                    Margin="5,0"
                    Padding="20,0"
                    Click="OkButton_Click"
                    Content="{DynamicResource Text.Button.OK}"
                    IsDefault="True" />
                <Button
                    x:Name="CancelButton"
                    MinWidth="100"
                    Height="30"
                    Margin="5,0"
                    Padding="20,0"
                    Click="CancelButton_Click"
                    Content="{DynamicResource Text.Button.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Panel>
</Window>

<Window
    x:Class="Lhamiel.View.SupportDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="580"
    Height="500"
    MinWidth="520"
    MinHeight="480"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterOwner">
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- 白いデスクトップが透けても文字とのコントラストを保つテーマ色のスクリム -->
        <Border
            Background="{DynamicResource Brush.Window}"
            IsHitTestVisible="False"
            Opacity="0.5" />

        <Grid Margin="22,42,22,18" RowDefinitions="*,Auto,Auto" RowSpacing="8">
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="7">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Text.Support.Title}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        Foreground="{DynamicResource Brush.FG2}"
                        Text="{DynamicResource Text.Support.Subtitle}"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Text.Support.Name}" />
                            <TextBox x:Name="NameBox" MaxLength="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Text.Support.Email}" />
                            <TextBox x:Name="EmailBox" MaxLength="254" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Spacing="5">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Text.Support.Category}" />
                        <ComboBox x:Name="CategoryBox" SelectedIndex="1">
                            <ComboBoxItem Content="{DynamicResource Text.Support.Category.Bug}" Tag="bug" />
                            <ComboBoxItem Content="{DynamicResource Text.Support.Category.Question}" Tag="question" />
                            <ComboBoxItem Content="{DynamicResource Text.Support.Category.Feature}" Tag="feature" />
                            <ComboBoxItem Content="{DynamicResource Text.Support.Category.Billing}" Tag="billing" />
                            <ComboBoxItem Content="{DynamicResource Text.Support.Category.Other}" Tag="other" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="4"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Text.Support.Message}" />
                    <TextBox
                        x:Name="ContentBox"
                        Grid.Row="5"
                        MinHeight="76"
                        AcceptsReturn="True"
                        MaxLength="10000"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap" />

                    <StackPanel
                        x:Name="CodePanel"
                        Grid.Row="6"
                        Margin="0,3,0,0"
                        IsVisible="False"
                        Spacing="5">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Text.Support.Code}" />
                        <WrapPanel Orientation="Horizontal">
                            <TextBox
                                x:Name="CodeBox"
                                Width="150"
                                Margin="0,0,8,6"
                                MaxLength="6" />
                            <Button
                                x:Name="ResendButton"
                                Margin="0,0,8,6"
                                Click="ResendButton_Click"
                                Content="{DynamicResource Text.Support.Resend}" />
                            <Button
                                x:Name="ChangeEmailButton"
                                Margin="0,0,0,6"
                                Click="ChangeEmailButton_Click"
                                Content="{DynamicResource Text.Support.ChangeEmail}" />
                        </WrapPanel>
                    </StackPanel>
            </Grid>

            <TextBlock
                x:Name="MessageText"
                Grid.Row="1"
                MinHeight="20"
                Foreground="{DynamicResource Brush.FG2}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                <Button
                    x:Name="StatusButton"
                    Grid.Column="0"
                    Click="StatusButton_Click"
                    Content="{DynamicResource Text.Support.Status}" />
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="CancelButton"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"
                        Content="{DynamicResource Text.Button.Cancel}"
                        IsCancel="True" />
                    <Button
                        x:Name="SendButton"
                        MinWidth="132"
                        Click="SendButton_Click"
                        Content="{DynamicResource Text.Support.Send}"
                        IsDefault="True" />
                </WrapPanel>
            </Grid>
        </Grid>
    </Panel>
</Window>

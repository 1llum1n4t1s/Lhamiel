<Window
    x:Class="Lhamiel.View.ConfirmDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="using:Lhamiel.View"
    Width="420"
    SizeToContent="Height"
    x:DataType="view:ConfirmDialog"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaTitleBarHeightHint="32"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterOwner">
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- 白いデスクトップが透けても文字とのコントラストを保つテーマ色のスクリム -->
        <Border
            Background="{DynamicResource Brush.Window}"
            IsHitTestVisible="False"
            Opacity="0.5" />
        <Grid x:Name="DialogBody" RowDefinitions="Auto,Auto">

            <!--  メッセージ  -->
            <TextBlock
                x:Name="MessageText"
                Grid.Row="0"
                FontSize="14"
                Foreground="{DynamicResource Brush.FG1}"
                TextWrapping="Wrap" />

            <!--  ボタン  -->
            <StackPanel x:Name="DialogActions"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="YesButton"
                    MinWidth="100"
                    Click="YesButton_Click"
                    Content="{DynamicResource Text.Button.Yes}"
                    IsDefault="True" />
                <Button
                    x:Name="NoButton"
                    MinWidth="100"
                    Click="NoButton_Click"
                    Content="{DynamicResource Text.Button.No}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Panel>
</Window>

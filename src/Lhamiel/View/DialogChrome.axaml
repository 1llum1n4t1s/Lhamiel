<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lhamiel.View.DialogChrome">
    <UserControl.Styles>
        <Style Selector="Button.dialogAction">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.dialogClose">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.dialogClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="32,*">
        <Grid x:Name="TitleBar" ColumnDefinitions="*,Auto" Background="Transparent">
            <TextBlock x:Name="Caption" Margin="16,0,10,0" FontSize="12.5"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG1}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
            <Button x:Name="CloseButton" Grid.Column="1" Classes="dialogClose"
                    AutomationProperties.Name="{DynamicResource Text.Close}">
                <PathIcon Width="10" Height="10" Data="M0,0 L1,0 L10,9 L10,10 L9,10 L0,1 Z M9,0 L10,0 L10,1 L1,10 L0,10 L0,9 Z" />
            </Button>
        </Grid>
        <Border x:Name="Surface" Grid.Row="1" Margin="6,0,6,6" CornerRadius="14"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                Background="{DynamicResource Brush.Container}">
            <Grid RowDefinitions="*,Auto">
                <ContentControl x:Name="BodyHost" Margin="24,22,24,20"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Border Grid.Row="1" Padding="24,14" CornerRadius="0,0,13,13"
                        Background="{DynamicResource Brush.ContainerAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <ContentControl x:Name="ActionHost" HorizontalContentAlignment="Stretch" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Application
    x:Class="Lhamiel.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Themes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Locale Resources は App.axaml.cs:ApplyLocale で動的ロードする（/rere #12）。
              17 言語をすべて起動時に MergedDictionaries に登録すると ~450KB が常駐し、
              Native AOT の起動速度の利点が削がれるため、選択ロケールのみオンデマンドロードする。
            -->
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--  ═══════════════════════════════════════════════════════════  -->
        <!--  macOS Tahoe 風グローバルスタイル  -->
        <!--  ═══════════════════════════════════════════════════════════  -->

        <!--  全ウィンドウ共通フォント：CJK フォールバック付き  -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI, Microsoft YaHei, Malgun Gothic, Noto Sans CJK, sans-serif" />
        </Style>

        <!--  サイドバー：Tahoe 風カスタムテンプレート  -->
        <Style Selector="TabControl.sidebar">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="180,*">
                        <!--  浮遊サイドバーパネル  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="6"
                            Background="{DynamicResource Brush.Container}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            BoxShadow="0 8 24 0 #18000000, 0 2 6 0 #10000000, inset 0 1 0 0 #30FFFFFF"
                            CornerRadius="14">
                            <ItemsPresenter Name="PART_ItemsPresenter">
                                <ItemsPresenter.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsPresenter.ItemsPanel>
                            </ItemsPresenter>
                        </Border>
                        <!--  コンテンツエリア  -->
                        <ContentPresenter
                            Name="PART_SelectedContentHost"
                            Grid.Column="1"
                            Margin="0"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  サイドバー タブ項目：デフォルト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  サイドバー タブ項目：テキスト省略（長い翻訳の安全策）  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  サイドバー タブ項目：角丸ベース（FluentTheme のボーダーインジケータを無効化）  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!--  FluentTheme の選択インジケータパイプを非表示  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!--  サイドバー タブ項目：ホバー — 薄いハイライト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Brush.SidebarHover}" />
        </Style>

        <!--  サイドバー タブ項目：選択中 — 背景ハイライト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TabControl.sidebar &gt; TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Brush.SidebarSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  ボタン：Tahoe の大きな角丸 + 十分なパディング  -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  ComboBox：Tahoe 風の角丸  -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  TextBox：Tahoe 風の角丸  -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  CheckBox：角丸を強調  -->
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  HeaderedContentControl：Tahoe 風ガラスパネル  -->
        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        Background="{DynamicResource Brush.Container}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="{TemplateBinding Header}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>

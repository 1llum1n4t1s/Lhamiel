<Application
    x:Class="Lhamiel.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Themes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Locale Resources  -->
            <ResourceInclude x:Key="en_US" Source="/Resources/Locales/en_US.axaml" />
            <ResourceInclude x:Key="ja_JP" Source="/Resources/Locales/ja_JP.axaml" />
            <ResourceInclude x:Key="zh_CN" Source="/Resources/Locales/zh_CN.axaml" />
            <ResourceInclude x:Key="zh_TW" Source="/Resources/Locales/zh_TW.axaml" />
            <ResourceInclude x:Key="de_DE" Source="/Resources/Locales/de_DE.axaml" />
            <ResourceInclude x:Key="fr_FR" Source="/Resources/Locales/fr_FR.axaml" />
            <ResourceInclude x:Key="es_ES" Source="/Resources/Locales/es_ES.axaml" />
            <ResourceInclude x:Key="it_IT" Source="/Resources/Locales/it_IT.axaml" />
            <ResourceInclude x:Key="pt_BR" Source="/Resources/Locales/pt_BR.axaml" />
            <ResourceInclude x:Key="ru_RU" Source="/Resources/Locales/ru_RU.axaml" />
            <ResourceInclude x:Key="uk_UA" Source="/Resources/Locales/uk_UA.axaml" />
            <ResourceInclude x:Key="id_ID" Source="/Resources/Locales/id_ID.axaml" />
            <ResourceInclude x:Key="fil_PH" Source="/Resources/Locales/fil_PH.axaml" />
            <ResourceInclude x:Key="ta_IN" Source="/Resources/Locales/ta_IN.axaml" />
            <ResourceInclude x:Key="ko_KR" Source="/Resources/Locales/ko_KR.axaml" />
            <ResourceInclude x:Key="la_VA" Source="/Resources/Locales/la_VA.axaml" />
            <ResourceInclude x:Key="sa_IN" Source="/Resources/Locales/sa_IN.axaml" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--  ═══════════════════════════════════════════════════════════  -->
        <!--  macOS Tahoe 風グローバルスタイル  -->
        <!--  ═══════════════════════════════════════════════════════════  -->

        <!--  全ウィンドウ共通フォント：CJK フォールバック付き  -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI, Microsoft YaHei, Malgun Gothic, Noto Sans CJK, sans-serif" />
        </Style>

        <!--  サイドバー：Tahoe 風カスタムテンプレート  -->
        <Style Selector="TabControl.sidebar">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate TargetType="TabControl">
                    <Grid ColumnDefinitions="180,*">
                        <!--  浮遊サイドバーパネル  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="6"
                            Background="{DynamicResource Brush.Container}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            BoxShadow="0 8 24 0 #18000000, 0 2 6 0 #10000000, inset 0 1 0 0 #30FFFFFF"
                            CornerRadius="14">
                            <ItemsPresenter Name="PART_ItemsPresenter">
                                <ItemsPresenter.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsPresenter.ItemsPanel>
                            </ItemsPresenter>
                        </Border>
                        <!--  コンテンツエリア  -->
                        <ContentPresenter
                            Name="PART_SelectedContentHost"
                            Grid.Column="1"
                            Margin="0"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  サイドバー タブ項目：デフォルト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  サイドバー タブ項目：テキスト省略（長い翻訳の安全策）  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  サイドバー タブ項目：角丸ベース（FluentTheme のボーダーインジケータを無効化）  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!--  FluentTheme の選択インジケータパイプを非表示  -->
        <Style Selector="TabControl.sidebar &gt; TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!--  サイドバー タブ項目：ホバー — 薄いハイライト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Brush.SidebarHover}" />
        </Style>

        <!--  サイドバー タブ項目：選択中 — 背景ハイライト  -->
        <Style Selector="TabControl.sidebar &gt; TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TabControl.sidebar &gt; TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Brush.SidebarSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  ボタン：Tahoe の大きな角丸 + 十分なパディング  -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  ComboBox：Tahoe 風の角丸  -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  TextBox：Tahoe 風の角丸  -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  CheckBox：角丸を強調  -->
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  HeaderedContentControl：Tahoe 風ガラスパネル  -->
        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        Background="{DynamicResource Brush.Container}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.FG2}"
                                Text="{TemplateBinding Header}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>

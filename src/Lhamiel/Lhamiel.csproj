<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Lhamiel.Tests.Unit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- ネイティブAOT -->
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CLIから -p:RuntimeIdentifier=win-arm64 で切り替え可能 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Lhamiel.Tests.Unit\**" />
  </ItemGroup>

  <!-- .axaml は Avalonia SDK が自動インクルードするため明示不要 -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="CRDebugger.Avalonia" Version="1.0.18" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="1llum1n4t1s.Sevenzip" Version="1.0.44" />
    <!-- 7z.dll は lib/native/{rid}/ から取得（7z.Libs NuGet は ARM64 未対応のため削除） -->
    <PackageReference Include="Velopack" Version="0.0.1369-g1d5c984" />
    <PackageReference Include="NLog" Version="6.1.1" />
  </ItemGroup>

  <!-- アイコンおよびネイティブ DLL を Publish 出力にコピー -->
  <Target Name="CopyIconsAndNativeDlls" AfterTargets="Publish">
    <Copy SourceFiles="icon\app.ico" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="icon\file.ico" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="$(OutputPath)7z.dll" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutputPath)7z.dll')" />
  </Target>

  <!-- ビルド後に7z.dllがルートにあるか確認 -->
  <Target Name="Verify7zDll" AfterTargets="Build">
    <Message Text="7z.dll is at: $(OutputPath)7z.dll" Importance="high" Condition="Exists('$(OutputPath)7z.dll')" />
    <Warning Text="7z.dll NOT FOUND at $(OutputPath)7z.dll — scripts/download-7z.ps1 を実行してください" Condition="!Exists('$(OutputPath)7z.dll')" />
  </Target>


  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\LICENSE" LogicalName="Lhamiel.LICENSE" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Lhamiel.Tests.Unit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- ネイティブAOT -->
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      IL3053 = "Assembly produced AOT analysis warnings"。Velopack 0.0.1369-g1d5c984 内部の
      Velopack.Windows.ShellLink+CShellLink (COM interop) で ILC 10.0.8 が「Invalid IL or CLR
      metadata」と判定し、Directory.Build.props の TreatWarningsAsErrors=true でビルドエラー化される。
      該当 COM ctor は本アプリのコードパスでは呼ばれないため (TrimmerRootAssembly で Velopack を
      root 化しているがランタイム到達経路は無い)、警告を抑制して publish を継続する。
      Velopack 側で AOT 対応の修正が入ったら除去する。
    -->
    <NoWarn>$(NoWarn);IL3053</NoWarn>
    <!-- CLIから -p:RuntimeIdentifier=win-arm64 で切り替え可能 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Lhamiel.Tests.Unit\**" />
  </ItemGroup>

  <!-- .axaml は Avalonia SDK が自動インクルードするため明示不要 -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <!-- CRDebugger.Avalonia はデバッグツール。リリースバイナリには同梱しないため Debug 限定参照。
         App.axaml.cs:181-183 の DebugHelper.InitializeCRDebugger は #if DEBUG ガード済みで、
         この PackageReference 自体も Configuration=Debug でのみ復元される。 -->
    <PackageReference Include="CRDebugger.Avalonia" Version="1.0.26" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="1llum1n4t1s.Sevenzip" Version="1.0.78" />
    <PackageReference Include="SuperLightLogger" Version="1.0.7" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <!-- 圧縮パスワードを DPAPI (CurrentUser) で暗号化して settings.json に保存するため。
         Windows 専用 (Lhamiel 自体 Windows 専用なので問題なし)。Native AOT 対応 (10.x)。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <!-- 7z.dll は 1llum1n4t1s.Sevenzip の runtimes/{rid}/native/ から .NET SDK が自動配置 -->
    <PackageReference Include="VelopackUpdateDialog.Avalonia" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- VelopackUpdateDialog: ViewModel / DefaultStrings / DefaultIcons などが XAML compiled binding 経由でしか参照されないため、AOT trim で削られないよう root 化する -->
    <TrimmerRootAssembly Include="VelopackUpdateDialog" />
    <TrimmerRootAssembly Include="Velopack" />
  </ItemGroup>

  <!-- アイコンを Publish 出力にコピー -->
  <Target Name="CopyIcons" AfterTargets="Publish">
    <Copy SourceFiles="icon\app.ico" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="icon\file.ico" DestinationFolder="$(PublishDir)" />
  </Target>


  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\LICENSE" LogicalName="Lhamiel.LICENSE" />
  </ItemGroup>

</Project>

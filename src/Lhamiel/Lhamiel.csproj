<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Lhamiel.Tests.Unit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- ネイティブAOT -->
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CLIから -p:RuntimeIdentifier=win-arm64 で切り替え可能 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Lhamiel.Tests.Unit\**" />
  </ItemGroup>

  <!-- .axaml は Avalonia SDK が自動インクルードするため明示不要 -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <!-- CRDebugger.Avalonia はデバッグツール。リリースバイナリには同梱しないため Debug 限定参照。
         App.axaml.cs:181-183 の DebugHelper.InitializeCRDebugger は #if DEBUG ガード済みで、
         この PackageReference 自体も Configuration=Debug でのみ復元される。 -->
    <PackageReference Include="CRDebugger.Avalonia" Version="1.0.24" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="1llum1n4t1s.Sevenzip" Version="1.0.73" />
    <PackageReference Include="SuperLightLogger" Version="1.0.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <!-- 7z.dll は 1llum1n4t1s.Sevenzip の runtimes/{rid}/native/ から .NET SDK が自動配置 -->
    <PackageReference Include="Velopack" Version="0.0.1369-g1d5c984" />
  </ItemGroup>

  <!-- アイコンを Publish 出力にコピー -->
  <Target Name="CopyIcons" AfterTargets="Publish">
    <Copy SourceFiles="icon\app.ico" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="icon\file.ico" DestinationFolder="$(PublishDir)" />
  </Target>


  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\LICENSE" LogicalName="Lhamiel.LICENSE" />
  </ItemGroup>

</Project>

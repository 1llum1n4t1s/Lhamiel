<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Asset\icon\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>1.0.5</Version>
    <FileVersion>1.0.5.0</FileVersion>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <AssemblyInformationalVersion>1.0.5</AssemblyInformationalVersion>
    <AssemblyName>Lhamiel</AssemblyName>
    <AssemblyTitle>Lhamiel</AssemblyTitle>
    <AssemblyDescription>圧縮・展開ソフトウェア</AssemblyDescription>
    <AssemblyCompany>1llum1n4t1s</AssemblyCompany>
    <AssemblyProduct>Lhamiel</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2025-2026 ゆろち</AssemblyCopyright>
    <!-- Windows固有のAPI使用を明示的に指定 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- AssemblyInfoの自動生成を無効化（手動で制御） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- パフォーマンス最適化設定 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- SourceLink を無効化してバージョンにハッシュが付かないようにする -->
    <SourceLink>false</SourceLink>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <Deterministic>false</Deterministic>
    <!-- CA1416警告を抑制 -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="Util\ArchiveCompressor.cs" />
    <Compile Include="Util\ArchiveConstants.cs" />
    <Compile Include="Util\ArchiveErrorHandler.cs" />
    <Compile Include="Util\ArchiveExtractor.cs" />
    <Compile Include="Util\ArchiveFormatDetector.cs" />
    <Compile Include="Util\ArchiveProcessor.cs" />
    <Compile Include="Util\FileAssociation.cs" />
    <Compile Include="Util\FileOverwriteDialog.cs" />
    <Compile Include="Util\FolderOpener.cs" />
    <Compile Include="Util\Logger.cs" />
    <Compile Include="Util\MessageService.cs" />
    <Compile Include="Util\PartialExtractionHandler.cs" />
    <Compile Include="Util\PathValidator.cs" />
    <Compile Include="Util\Settings.cs" />
    <Compile Include="Util\SettingsManager.cs" />
    <Compile Include="Util\ShortcutCreator.cs" />
    <Compile Include="View\ErrorRecoveryDialog.xaml.cs" />
    <Compile Include="View\MainWindow.xaml.cs" />
    <Compile Include="View\ProgressWindow.xaml.cs" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="7z.Libs" Version="25.1.0" />
    <PackageReference Include="Cube.FileSystem.SevenZip" Version="8.4.1" />
    <PackageReference Include="log4net" Version="3.0.1" />
    <PackageReference Include="Velopack" Version="0.0.1369-g1d5c984" />
  </ItemGroup>

  <!-- アイコンファイルを出力ディレクトリにコピー -->
  <Target Name="CopyIcons" AfterTargets="Publish">
    <Copy SourceFiles="Asset\icon\app.ico" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="Asset\icon\file.ico" DestinationFolder="$(PublishDir)" />
  </Target>

  <!-- 7z.dllを手動でルートに配置 -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)7z.libs\**\runtimes\win-x64\native\7z.dll">
      <Link>7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ビルド後にx64フォルダを削除し、7z.dllをルートに移動 -->
  <Target Name="Move7zDllToRoot" AfterTargets="Build">
    <Move SourceFiles="$(OutputPath)x64\7z.dll" DestinationFiles="$(OutputPath)7z.dll" Condition="Exists('$(OutputPath)x64\7z.dll')" />
    <RemoveDir Directories="$(OutputPath)x64" Condition="Exists('$(OutputPath)x64')" />
    <RemoveDir Directories="$(OutputPath)x86" Condition="Exists('$(OutputPath)x86')" />
    <RemoveDir Directories="$(OutputPath)runtimes" Condition="Exists('$(OutputPath)runtimes')" />
  </Target>


  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
